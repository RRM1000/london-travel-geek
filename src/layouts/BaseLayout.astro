---
import { activeSite } from "../sites";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "@fontsource-variable/fraunces";
import "@fontsource-variable/hanken-grotesk";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  contentType?: "website" | "article";
  socialImage?: string;
  socialImageAlt?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const {
  title = activeSite.name,
  description = activeSite.description,
  noindex = false,
  contentType = "website",
  socialImage = "/social-card.png",
  socialImageAlt = "London Travel Geek — practical London travel guides",
  publishedAt,
  updatedAt,
  breadcrumbs = [],
} = Astro.props;

const pageTitle =
  title === activeSite.name ? title : `${title} | ${activeSite.name}`;
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin);
const socialImageUrl = new URL(socialImage, siteOrigin);
const indexingEnabled = import.meta.env.PUBLIC_ALLOW_INDEXING === "true";
const googleVerification =
  import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const shouldNoindex = noindex || !indexingEnabled;
// Google reads the site name it prints above a search result off a single
// WebSite entity, on the home page, whose url is the domain root. Every
// non-article page here used to declare one - the search page, every topic
// index, every guide hub - and each claimed its own subpage as the site url.
// Dozens of competing WebSite entities is not a signal Google will act on, so
// it fell back to printing the bare domain. Only the home page declares
// WebSite now; the rest are ordinary WebPages.
const isHomepage = canonicalUrl.pathname === "/";
const schemaType =
  contentType === "article" ? "BlogPosting" : isHomepage ? "WebSite" : "WebPage";
const structuredData = {
  "@context": "https://schema.org",
  "@type": schemaType,
  name:
    schemaType === "WebSite"
      ? activeSite.name
      : schemaType === "WebPage"
        ? title
        : undefined,
  headline: contentType === "article" ? title : undefined,
  description,
  url: canonicalUrl.toString(),
  mainEntityOfPage:
    contentType === "article"
      ? {
          "@type": "WebPage",
          "@id": canonicalUrl.toString(),
        }
      : undefined,
  image: socialImageUrl.toString(),
  datePublished: publishedAt?.toISOString(),
  dateModified: (updatedAt ?? publishedAt)?.toISOString(),
  inLanguage: "en-GB",
  publisher: {
    "@type": "Organization",
    name: activeSite.name,
    url: new URL("/", siteOrigin).toString(),
    logo: {
      "@type": "ImageObject",
      url: new URL("/android-chrome-512x512.png", siteOrigin).toString(),
    },
  },
};
const breadcrumbData =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((breadcrumb, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: breadcrumb.label,
          item: new URL(breadcrumb.href ?? Astro.url.pathname, siteOrigin).toString(),
        })),
      }
    : undefined;
const jsonLd = JSON.stringify(
  breadcrumbData ? [structuredData, breadcrumbData] : structuredData,
).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en-GB" data-theme={activeSite.theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e1b2c" />
    {googleVerification && (
      <meta name="google-site-verification" content={googleVerification} />
    )}
    {shouldNoindex ? (
      <>
        <meta name="robots" content="noindex, nofollow, noarchive" />
        <meta name="googlebot" content="noindex, nofollow, noarchive" />
      </>
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={activeSite.name}
      href={new URL("/rss.xml", siteOrigin)}
    />
    {/*
      Google resizes whatever it finds down to a very small square, and its
      guidance is to offer an icon that is a multiple of 48px - we shipped
      nothing above 32, so it was working from the smallest file on the site.
      The 48 and 192 were already sitting in public/ unreferenced.
    */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link
      rel="icon"
      href="/android-chrome-192x192.png"
      type="image/png"
      sizes="192x192"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:type" content={contentType} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={activeSite.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    {publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}
    {updatedAt && (
      <meta property="article:modified_time" content={updatedAt.toISOString()} />
    )}

    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={jsonLd} is:inline></script>
    <script
      is:inline
      async
      defer
      src="https://widget.getyourguide.com/dist/pa.umd.production.min.js"
      data-gyg-partner-id="WWP7I0R"
    ></script>
    <!--
      The GetYourGuide partner widget rewrites the rel on every getyourguide.com
      link it finds, replacing "sponsored nofollow noopener" with
      "noopener noreferrer". Verified 2026-08-20: the server HTML ships the
      correct rel and the live DOM had it stripped.
      Google treats a paid link without rel="sponsored" (or nofollow) as a link
      scheme, so letting a third-party script quietly remove it is a real risk -
      and it affects the hand-placed widgets on the transport guides too, not
      just the generated links. This re-asserts it on anything we marked as an
      affiliate link, and keeps watching because the widget runs async.
    -->
    <script is:inline>
      (function () {
        var REL = "sponsored nofollow noopener";
        function enforce() {
          document.querySelectorAll("a[data-affiliate]").forEach(function (a) {
            if (a.getAttribute("rel") !== REL) a.setAttribute("rel", REL);
          });
        }
        enforce();
        document.addEventListener("DOMContentLoaded", enforce);
        window.addEventListener("load", enforce);
        new MutationObserver(enforce).observe(document.documentElement, {
          subtree: true, childList: true, attributes: true,
          attributeFilter: ["rel"],
        });
      })();
    </script>
    {import.meta.env.PROD && (
      <>
        {/*
          PROD-ONLY, PLUS A RUNTIME HOSTNAME CHECK.
          `astro dev` (localhost) used to load this unconditionally, so every
          local visit while testing counted as real traffic in GA - the
          import.meta.env.PROD gate fixed that for `astro dev`.
          It did NOT fix `npm run build` followed by serving dist/ locally
          (e.g. `python -m http.server`, used to preview a change when the
          project's one dev-server slot is held by another session): that
          output has PROD baked in regardless of where it's served from, so
          the old code still fired real hits to production GA from a
          laptop's localhost. Real incident: this happened while verifying
          the public-toilets-london map. Fixed by also checking the actual
          hostname at runtime against this build's configured site origin
          (siteOrigin, from Astro.site) - the script only ever loads when the
          page is actually being served from the real domain, independent of
          which build produced the HTML.
        */}
        <script is:inline define:vars={{ prodHostname: siteOrigin.hostname }}>
          if (location.hostname === prodHostname) {
            var gaScript = document.createElement("script");
            gaScript.async = true;
            gaScript.src = "https://www.googletagmanager.com/gtag/js?id=G-YDK7Q2D8E8";
            document.head.appendChild(gaScript);
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', 'G-YDK7Q2D8E8');
          }
        </script>
      </>
    )}
    <!--
      THE EVENTS THE ANALYTICS LOOP RUNS ON. Default GA4 reports pageviews and
      not much else; none of the decisions we actually want to make - which
      affiliate placement earns, which sections get read, what people search
      for and fail to find - can be answered from that. These five events can.
      Delegated from document, so no component emits anything itself and a new
      affiliate link or contents entry is tracked the moment it carries the
      attribute the site already uses for it.

      Sends nothing unless window.gtag exists, and the block above only
      defines it on the production hostname - so a laptop serving dist/ never
      reports (the incident the hostname check exists for). Listeners on
      localhost are inert.

      What it cannot see: clicks inside the GetYourGuide inline widgets, which
      are cross-origin iframes. Those live in GYG's partner dashboard. The
      placement comparison here is between OUR anchors - sidebar card versus
      the activity, event and hotel lists.
    -->
    <script is:inline>
      (function () {
        function track(name, params) {
          if (typeof window.gtag === "function") window.gtag("event", name, params);
        }

        // The section a link sits under: the nearest h2 above it. The injected
        // lists (things-to-do, whats-on, where-to-stay) put their id on the
        // heading, not a wrapper, so closest("section[id]") found nothing and
        // every in-body link would have reported as plain "inline". Walking
        // headings instead also means placement uses the same names as
        // toc_click and section_reached.
        function sectionOf(el) {
          var heads = document.querySelectorAll(".article__body h2[id]");
          var found = null;
          for (var i = 0; i < heads.length; i++) {
            if (heads[i].compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING) {
              found = heads[i].id;
            } else {
              break;
            }
          }
          return found;
        }

        document.addEventListener("click", function (e) {
          var t = e.target;
          var a = t && t.closest ? t.closest("a[href]") : null;
          if (!a) return;

          if (a.hasAttribute("data-affiliate")) {
            var row = a.closest("li");
            var nameEl = row && row.querySelector(".sidebar-book__name, h3, strong");
            track("affiliate_click", {
              network: a.getAttribute("data-affiliate"),
              placement: a.closest(".sidebar-book") ? "sidebar" : (sectionOf(a) || "inline"),
              venue: ((nameEl || a).textContent || "").trim().slice(0, 80),
            });
          } else if (a.hasAttribute("data-toc-link")) {
            track("toc_click", { section: a.hash.slice(1) });
          } else if (a.closest("[data-site-header]") && !a.classList.contains("skip-link")) {
            track("nav_click", {
              label: (a.textContent || "").trim().replace(/\s+/g, " ").slice(0, 60),
              href: a.getAttribute("href"),
            });
          }
        }, true);

        // How far down a guide people actually get. Observes the same targets
        // the contents list points at, so toc_click and section_reached agree
        // on what a "section" is - including the ones the layout injects.
        //
        // Deferred to DOMContentLoaded: this script sits in <head>, and on the
        // first pass it queried the contents list before the body had been
        // parsed, found nothing, and silently observed nothing. The click
        // handler above survives that because it resolves its targets lazily.
        function watchSections() {
          if (!("IntersectionObserver" in window)) return;
          var ids = [];
          document.querySelectorAll(".toc--desktop [data-toc-link]").forEach(function (l) {
            var id = l.hash.slice(1);
            if (id && ids.indexOf(id) < 0) ids.push(id);
          });
          var targets = ids.map(function (id) { return document.getElementById(id); }).filter(Boolean);
          if (targets.length) {
            var seen = {};
            var io = new IntersectionObserver(function (entries) {
              entries.forEach(function (en) {
                if (!en.isIntersecting || seen[en.target.id]) return;
                seen[en.target.id] = true;
                track("section_reached", {
                  section: en.target.id,
                  index: targets.indexOf(en.target) + 1,
                  of: targets.length,
                });
              });
            }, { rootMargin: "0px 0px -40% 0px" });
            targets.forEach(function (el) { io.observe(el); });
          }
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", watchSections);
        } else {
          watchSections();
        }
      })();
    </script>
  </head>
  <body data-site={activeSite.id}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader site={activeSite} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter site={activeSite} />
    <script>
      for (const link of document.querySelectorAll<HTMLAnchorElement>(
        'a[href^="http://"], a[href^="https://"]',
      )) {
        if (link.origin === window.location.origin) continue;

        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.classList.add("external-link");

        const existingLabel = link.getAttribute("aria-label");
        if (!existingLabel?.includes("opens in a new tab")) {
          const label = existingLabel || link.textContent?.trim() || "External link";
          link.setAttribute("aria-label", `${label} (opens in a new tab)`);
        }
      }
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.5rem;
    left: 0.5rem;
    translate: 0 -180%;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--bg);
    font-weight: 800;
  }

  .skip-link:focus {
    translate: 0;
  }

  a.external-link::after {
    content: " ↗";
    display: inline-block;
    font-size: 0.8em;
    line-height: 1;
    text-decoration: none;
  }
</style>
