---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Advert from "../components/Advert.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import TableOfContents from "../components/TableOfContents.astro";
import AreaAtAGlance from "../components/AreaAtAGlance.astro";
import AreaMap from "../components/AreaMap.astro";
import AreaActivities from "../components/AreaActivities.astro";
import AreaEvents from "../components/AreaEvents.astro";
import AreaHiddenLondon from "../components/AreaHiddenLondon.astro";
import MarathonRouteMap from "../components/MarathonRouteMap.astro";
import activityData from "../data/activities.json";
import eventData from "../data/events.json";
import hotelData from "../data/hotels.json";
import hiddenLondonData from "../data/hiddenLondon.json";
import restaurantMapData from "../data/restaurants.json";
import AreaHotels from "../components/AreaHotels.astro";
import CombineWith from "../components/CombineWith.astro";
import ArticleFaq from "../components/ArticleFaq.astro";
import { activeSite } from "../sites";
import { categoryHref, formatTag, tagHref } from "../lib/taxonomy";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface AreaMeta {
  name: string;
  zone: string;
  vibe: string;
  walkability: number;
  timeNeeded: string;
  budget: string;
  bestDay: string;
  bestFor: string[];
  nearestStations: { name: string; lines: string[] }[];
  nearby: { name: string; slug?: string; minutes: number; note: string }[];
}

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  articleId: string;
  category: string;
  tags: string[];
  publishedAt: Date;
  updatedAt?: Date;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  heroImageCredit?: string;
  heroImageSource?: string;
  heroImageLicense?: string;
  heroImageLicenseUrl?: string;
  headings?: Heading[];
  area?: AreaMeta;
  faq?: { q: string; a: string }[];
  // Area guides only - see splitAreaGuideBody. closingHtml is the "Suggested
  // route" + "Common mistakes" pair, rendered after the data-driven sections
  // instead of wherever it fell in the markdown. whereToStayHtml is the
  // area-level "stay in X neighbourhood" prose, merged into AreaHotels under
  // one heading instead of duplicating "Where to stay" / "Places to stay".
  closingHtml?: string;
  closingHeadings?: Heading[];
  whereToStayHtml?: string;
}

const {
  title,
  seoTitle,
  description,
  articleId,
  category,
  tags,
  publishedAt,
  updatedAt,
  heroImage,
  heroImageAlt = "",
  heroImageCredit,
  heroImageSource,
  heroImageLicense,
  heroImageLicenseUrl,
  headings = [],
  area,
  faq = [],
  closingHtml = "",
  closingHeadings = [],
  whereToStayHtml = "",
} = Astro.props;

const contentsHeadings = headings.filter(
  (heading) =>
    heading.depth === 2 ||
    (articleId === "london-tube-and-rail-lines-guide" && heading.depth === 3),
);

// The activities section is injected by this layout rather than written in the
// markdown, so it never appears in `headings` and would otherwise be a section
// on the page with no entry in the contents. Append it when it will render.
// The map leads, then events - the same order they render in below.
const mappable = (rows: { guide?: string; lat?: number; lng?: number }[]) =>
  rows.filter((r) => r.guide === articleId && r.lat != null && r.lng != null).length;
const mapPinCount =
  !area
    ? 0
    : mappable(restaurantMapData.restaurants) +
      mappable(activityData.activities) +
      mappable(hiddenLondonData.spots) +
      mappable(hotelData.hotels);
if (mapPinCount >= 3 && area) {
  contentsHeadings.push({
    depth: 2,
    slug: "area-map",
    text: `Map of ${area.name}`,
  });
}
const hasEvents =
  !!area && (eventData.events as { guide?: string }[]).some((e) => e.guide === articleId);
if (hasEvents && area) {
  contentsHeadings.push({
    depth: 2,
    slug: "whats-on",
    text: `What's on in ${area.name}`,
  });
}
const hasActivities =
  !!area && (activityData.activities as { guide?: string }[]).some((a) => a.guide === articleId);
if (hasActivities && area) {
  contentsHeadings.push({
    depth: 2,
    slug: "things-to-do",
    text: `Things to do in ${area.name}`,
  });
}
// This section renders on the page (AreaHiddenLondon.astro) but was never
// added to the contents list - genuinely missing before, not a reorder.
const hasHiddenLondon =
  !!area && (hiddenLondonData.spots as { guide?: string }[]).some((s) => s.guide === articleId);
if (hasHiddenLondon && area) {
  contentsHeadings.push({
    depth: 2,
    slug: "hidden-london",
    text: `Hidden ${area.name}`,
  });
}
// One heading now, not two: the area-level "Where to stay" prose merges into
// AreaHotels's property list. Gated on EITHER having content, because Peckham
// has the prose with no hotel-card data yet - the section still has to render.
const hasHotels =
  !!area && (hotelData.hotels as { guide?: string }[]).some((h) => h.guide === articleId);
const hasStaySection = hasHotels || whereToStayHtml.trim().length > 0;
if (hasStaySection && area) {
  contentsHeadings.push({
    depth: 2,
    slug: "where-to-stay",
    text: "Where to stay",
  });
}
// Suggested route + Common mistakes render last, right before the FAQ - see
// splitAreaGuideBody for why this can't just be markdown heading order.
contentsHeadings.push(...closingHeadings);
const showContents = contentsHeadings.length >= 4;
const siteArticles = (await getCollection("articles")).filter(
  (article) =>
    !article.data.draft && article.data.sites.includes(activeSite.id),
);
const publishedIds = new Set(siteArticles.map((article) => article.id));
const relatedArticles = siteArticles
  .filter((article) => article.id !== articleId)
  .map((article) => ({
    article,
    score:
      (article.data.category === category ? 4 : 0) +
      article.data.tags.filter((tag) => tags.includes(tag)).length,
  }))
  .filter(({ score }) => score > 0)
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.article.data.publishedAt.valueOf() - a.article.data.publishedAt.valueOf(),
  )
  .slice(0, 3)
  .map(({ article }) => article);
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "All guides", href: "/guides/" },
  { label: category, href: categoryHref(category) },
  { label: title },
];
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  contentType="article"
  socialImage={heroImage?.src}
  socialImageAlt={heroImageAlt || `${title} — ${activeSite.name}`}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  breadcrumbs={breadcrumbs}
>
  <article class="article">
    <!-- Full-Width Hero Banner right under the navbar -->
    <div class={`article__hero-banner ${heroImage ? "article__hero-banner--has-image" : "article__hero-banner--no-image"}`}>
      {heroImage && (
        <div class="article__hero-bg">
          <Image
            src={heroImage}
            alt={heroImageAlt}
            widths={[720, 1080, 1440, 1920]}
            sizes="100vw"
            loading="eager"
          />
          <div class="article__hero-overlay" />
        </div>
      )}
      <div class="container article__hero-content">
        <Breadcrumbs items={breadcrumbs} />
        <header class="article__header">
          <p class="eyebrow"><a href={categoryHref(category)}>{category}</a></p>
          <h1>{title}</h1>
          <p class="article__description">{description}</p>
        </header>
        {heroImage && (heroImageCredit || heroImageLicense) && (
          <div class="article__hero-credit">
            Photo:{" "}
            {heroImageSource ? (
              <a href={heroImageSource}>{heroImageCredit}</a>
            ) : (
              heroImageCredit
            )}
            {heroImageLicense && (
              <>
                {" · "}
                {heroImageLicenseUrl ? (
                  <a href={heroImageLicenseUrl}>{heroImageLicense}</a>
                ) : (
                  heroImageLicense
                )}
              </>
            )}
          </div>
        )}
      </div>
    </div>

    <!-- Container for Sub-Hero Meta (Dates & Tags) and Article Content Grid -->
    <div class="container">
      <div class="article__sub-hero">
        <div class="article__meta">
          <time datetime={publishedAt.toISOString()}>
            Published {publishedAt.toLocaleDateString("en-GB", {
              day: "numeric",
              month: "long",
              year: "numeric",
            })}
          </time>
          {updatedAt && (
            <>
              <span class="article__meta-separator" aria-hidden="true">·</span>
              <time datetime={updatedAt.toISOString()}>
                Updated {updatedAt.toLocaleDateString("en-GB", {
                  day: "numeric",
                  month: "long",
                  year: "numeric",
                })}
              </time>
            </>
          )}
        </div>
        {tags.length > 0 && (
          <ul class="article__tags" aria-label="Article tags">
            {tags.map((tag) => <li><a href={tagHref(tag)}>{formatTag(tag)}</a></li>)}
          </ul>
        )}
      </div>

      <div class="article__grid">
      <div class="article__body">
        {showContents && (
          <TableOfContents headings={contentsHeadings} variant="mobile" />
        )}
        {area && (
          <AreaAtAGlance
            zone={area.zone}
            vibe={area.vibe}
            walkability={area.walkability}
            timeNeeded={area.timeNeeded}
            budget={area.budget}
            bestDay={area.bestDay}
            bestFor={area.bestFor}
            nearestStations={area.nearestStations}
          />
        )}
        <slot />
        {articleId === "london-marathon-guide" && <MarathonRouteMap />}
        {area && <AreaMap articleId={articleId} areaName={area.name} />}
        {area && <AreaEvents articleId={articleId} areaName={area.name} />}
        {area && <AreaActivities articleId={articleId} areaName={area.name} />}
        {area && <AreaHiddenLondon articleId={articleId} areaName={area.name} />}
        {area && (
          <AreaHotels articleId={articleId} areaName={area.name} introHtml={whereToStayHtml} />
        )}
        {area && (
          <CombineWith
            areas={area.nearby}
            areaName={area.name}
            publishedIds={publishedIds}
          />
        )}
        {closingHtml && <Fragment set:html={closingHtml} />}
        <ArticleFaq items={faq} />
      </div>
      <aside class="article__sidebar">
        {showContents && (
          <TableOfContents headings={contentsHeadings} variant="desktop" />
        )}
        <section class="article__activities" aria-label="Book London activities">
          <div
            data-gyg-href="https://widget.getyourguide.com/default/city.frame"
            data-gyg-location-id="57"
            data-gyg-locale-code="en-US"
            data-gyg-widget="city"
            data-gyg-partner-id="WWP7I0R"
          ></div>
        </section>
        <Advert format="rectangle" />
      </aside>
    </div>
    </div>
    <RelatedGuides articles={relatedArticles} />
  </article>

  <script>
    import { restaurantMaps } from "../data/restaurantMaps";

    const videoButtons = document.querySelectorAll<HTMLButtonElement>(
      "[data-youtube-video]",
    );

    for (const button of videoButtons) {
      button.addEventListener(
        "click",
        () => {
          const videoId = button.dataset.youtubeVideo;
          const title = button.dataset.youtubeTitle ?? "YouTube video";

          if (!videoId) return;

          const iframe = document.createElement("iframe");
          iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
          iframe.title = title;
          iframe.allow =
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          iframe.referrerPolicy = "strict-origin-when-cross-origin";
          iframe.allowFullscreen = true;

          button.replaceWith(iframe);
        },
        { once: true },
      );
    }

    type Leaflet = {
      map: (element: HTMLElement, options?: Record<string, unknown>) => any;
      tileLayer: (url: string, options?: Record<string, unknown>) => any;
      divIcon: (options: Record<string, unknown>) => any;
      marker: (position: [number, number], options?: Record<string, unknown>) => any;
      latLngBounds: (positions: [number, number][]) => any;
    };

    const leafletWindow = window as Window & { L?: Leaflet };
    let leafletPromise: Promise<Leaflet> | undefined;

    const loadLeaflet = () => {
      if (leafletWindow.L) return Promise.resolve(leafletWindow.L);
      if (leafletPromise) return leafletPromise;

      leafletPromise = new Promise<Leaflet>((resolve, reject) => {
        if (!document.querySelector('link[data-leaflet-styles]')) {
          const stylesheet = document.createElement("link");
          stylesheet.rel = "stylesheet";
          stylesheet.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
          stylesheet.dataset.leafletStyles = "";
          document.head.append(stylesheet);
        }

        const existingScript = document.querySelector<HTMLScriptElement>(
          "script[data-leaflet-script]",
        );

        const finish = () => {
          if (leafletWindow.L) resolve(leafletWindow.L);
          else reject(new Error("Leaflet did not load."));
        };

        if (existingScript) {
          existingScript.addEventListener("load", finish, { once: true });
          existingScript.addEventListener("error", reject, { once: true });
          return;
        }

        const script = document.createElement("script");
        script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
        script.dataset.leafletScript = "";
        script.addEventListener("load", finish, { once: true });
        script.addEventListener("error", reject, { once: true });
        document.head.append(script);
      });

      return leafletPromise;
    };

    const createPopup = (
      marker: (typeof restaurantMaps)[string][number],
    ) => {
      const content = document.createElement("div");
      content.className = "restaurant-map-popup";

      const name = document.createElement("strong");
      name.textContent = marker.name;
      content.append(name);

      const details = document.createElement("span");
      details.textContent = [
        marker.area,
        marker.price,
        marker.station ? `near ${marker.station}` : undefined,
      ]
        .filter(Boolean)
        .join(" · ");
      content.append(details);

      const links = document.createElement("span");

      if (marker.articleAnchor) {
        const articleLink = document.createElement("a");
        articleLink.href = marker.articleAnchor;
        articleLink.textContent = "Read recommendation";
        links.append(articleLink);
      }

      if (marker.videoUrl) {
        const videoLink = document.createElement("a");
        videoLink.href = marker.videoUrl;
        videoLink.textContent = "Watch this visit";
        links.append(videoLink);
      }

      const mapLink = document.createElement("a");
      mapLink.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
        `${marker.name}, ${marker.area}, London`,
      )}`;
      mapLink.target = "_blank";
      mapLink.rel = "noopener noreferrer";
      mapLink.textContent = "Open in Google Maps";
      links.append(mapLink);
      content.append(links);

      return content;
    };

    const initialiseRestaurantMap = async (element: HTMLElement) => {
      if (element.dataset.mapReady === "true") return;

      const markers = restaurantMaps[element.dataset.restaurantMap ?? ""];
      if (!markers?.length) return;

      element.dataset.mapReady = "true";

      try {
        const L = await loadLeaflet();
        element.replaceChildren();

        const map = L.map(element, { scrollWheelZoom: false });
        L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 19,
          attribution:
            '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        }).addTo(map);

        const positions: [number, number][] = [];

        for (const markerData of markers) {
          const position: [number, number] = [
            markerData.latitude,
            markerData.longitude,
          ];
          positions.push(position);

          const icon = L.divIcon({
            className: "restaurant-map-marker-wrap",
            html: `<span class="restaurant-map-marker restaurant-map-marker--${markerData.type}" aria-hidden="true"></span>`,
            iconSize: [26, 34],
            iconAnchor: [13, 34],
            popupAnchor: [0, -30],
          });

          L.marker(position, {
            icon,
            title: markerData.name,
            alt: markerData.name,
          })
            .addTo(map)
            .bindPopup(createPopup(markerData));
        }

        map.fitBounds(L.latLngBounds(positions), {
          padding: [28, 28],
          maxZoom: 13,
        });

        const shell = element.closest<HTMLDetailsElement>("details");
        shell?.addEventListener("toggle", () => {
          if (shell.open) window.setTimeout(() => map.invalidateSize(), 0);
        });
      } catch {
        element.innerHTML =
          '<p>The map could not load. You can still use the restaurant areas and nearest-station details in the guide below.</p>';
        delete element.dataset.mapReady;
      }
    };

    for (const element of document.querySelectorAll<HTMLElement>(
      "[data-restaurant-map]",
    )) {
      const shell = element.closest<HTMLDetailsElement>("details");
      if (shell?.open) {
        void initialiseRestaurantMap(element);
      } else {
        shell?.addEventListener(
          "toggle",
          () => {
            if (shell.open) void initialiseRestaurantMap(element);
          },
          { once: true },
        );
      }
    }
  </script>
</BaseLayout>

<style>
  .article {
    padding-bottom: var(--space-7);
  }

  /* Full-width Hero Banner right under navbar */
  .article__hero-banner {
    position: relative;
    width: 100%;
    margin-bottom: var(--space-5);
  }

  .article__hero-banner--no-image {
    padding-top: var(--space-4);
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  .article__hero-banner--has-image {
    position: relative;
    width: 100%;
    background-color: var(--ink);
    color: #ffffff;
  }

  .article__hero-banner--has-image .article__hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .article__hero-banner--has-image .article__hero-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .article__hero-banner--has-image .article__hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgb(14 27 44 / 0.55) 0%,
      rgb(14 27 44 / 0.7) 55%,
      rgb(14 27 44 / 0.94) 100%
    );
  }

  .article__hero-banner .article__hero-content {
    position: relative;
    z-index: 3;
    padding-block: clamp(3.5rem, 8vw, 6rem) 3rem;
  }

  @media (max-width: 48rem) {
    .article__hero-banner .article__hero-content {
      padding-block: 2rem 1.75rem;
    }
  }

  .article__header {
    display: grid;
    max-width: 58rem;
    gap: 0.85rem;
  }

  .article__hero-banner--has-image :global(.breadcrumbs) {
    color: rgba(255, 255, 255, 0.85);
  }

  .article__hero-banner--has-image :global(.breadcrumbs li:not(:last-child)::after) {
    color: rgba(255, 255, 255, 0.4);
  }

  .article__header .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .article__header .eyebrow a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .article__hero-banner--has-image .eyebrow {
    color: var(--highlight);
  }

  .article__header h1 {
    font-size: clamp(2.4rem, 6.5vw, 4.8rem);
    line-height: 1.1;
  }

  .article__hero-banner--has-image h1 {
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  .article__description {
    max-width: var(--reading-width);
    color: var(--muted);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .article__hero-banner--has-image .article__description {
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  .article__hero-credit {
    margin-top: 1.75rem;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.74rem;
  }

  .article__hero-credit a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: underline;
  }

  .article__hero-credit a:hover {
    color: #ffffff;
  }

  /* Sub-Hero Section (Dates & Tags Underneath Hero) */
  .article__sub-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: var(--space-5);
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .article__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 750;
  }

  .article__meta-separator {
    color: var(--accent);
    font-weight: 800;
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .article__tags li {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 750;
    transition: all 0.15s ease;
  }

  .article__tags a {
    color: inherit;
    text-decoration: none;
  }

  .article__tags a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .article__grid {
    display: grid;
    grid-template-columns: minmax(0, var(--reading-width)) minmax(14rem, 20rem);
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }

  .article__body {
    min-width: 0;
    font-size: 1.08rem;
  }

  .article__body :global(h2) {
    margin: 3.25rem 0 1rem;
    font-size: clamp(1.8rem, 4vw, 2.65rem);
    scroll-margin-top: 2rem;
  }

  .article__body :global(h3) {
    margin: 2rem 0 0.7rem;
    font-size: clamp(1.25rem, 3vw, 1.6rem);
  }

  .article__body :global(p) {
    margin-block: 1rem;
  }

  .article__body :global(a) {
    color: var(--accent);
    font-weight: 700;
  }

  .article__body :global(ul),
  .article__body :global(ol) {
    display: grid;
    gap: 0.65rem;
    margin: 1.25rem 0;
    padding-left: 1.35rem;
  }

  .article__body :global(ul) {
    list-style: disc;
  }

  .article__body :global(ol) {
    list-style: decimal;
  }

  .article__body :global(li)::marker {
    color: var(--accent);
    font-weight: 800;
  }

  .article__body :global(blockquote) {
    margin: 1.75rem 0;
    padding: 1.25rem 1.4rem;
    border-left: 0.3rem solid var(--accent);
    background: var(--surface-strong);
    font-family: var(--display);
    font-size: 1.2rem;
    line-height: 1.45;
  }

  .article__body :global(blockquote p) {
    margin: 0;
  }

  .article__body :global(img) {
    width: 100%;
    height: auto;
    margin-top: 1.75rem;
    border-radius: var(--card-radius);
  }

  .article__body :global(hr) {
    margin-block: 3rem;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .article__body :global(strong) {
    color: var(--ink);
  }

  .article__body :global(table) {
    display: table;
    width: 100%;
    table-layout: fixed;
    margin-block: 1.5rem 2rem;
    overflow: visible;
    border: 1px solid var(--line);
