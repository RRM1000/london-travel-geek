    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--card-radius);
    background: var(--surface);
  }

  .article__activities :global(iframe) {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 0;
  }

  @media (max-width: 52rem) {
    .article__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .article__sidebar {
      display: block;
      position: static;
    }

    .article__sidebar > :global(.advert) {
      margin-top: var(--space-5);
    }

    .article__activities {
      margin-top: var(--space-5);
    }

    .article__body :global(.network-map object) {
      min-height: 32rem;
    }

    .article__body :global(.restaurant-map-shell summary) {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.2rem;
    }

    .article__body :global(.restaurant-map) {
      min-height: 25rem;
    }
  }
</style>

<script>
  document.querySelectorAll('.article__body .line-guide').forEach((guide) => {
    const label = Array.from(guide.querySelectorAll('dt')).find(
      (term) => term.textContent?.trim() === 'Visitor likelihood',
    );
    const attractions = Array.from(guide.querySelectorAll('h4')).find(
      (heading) => heading.textContent?.trim() === 'Attractions and areas',
    );
    const item = label?.closest('div');

    if (!label || !attractions || !item) return;

    label.textContent = 'Likelihood of using';
    item.classList.add('line-guide__likelihood');
    const attractionsTable = attractions.nextElementSibling;
    if (attractionsTable?.tagName === 'TABLE') {
      attractionsTable.after(item);
    }
  });

  const addRatingIcons = (element: Element | null | undefined, type: 'crowding' | 'comfort') => {
    if (!element) return;

    const value = element.textContent?.trim() ?? '';
    const ratings: Array<{ score: number; label: string }> = value
      .split(';')
      .flatMap((part: string) => {
        const match = part.trim().match(/^([1-5])\/5\s*(.*)$/);
        return match ? [{ score: Number(match[1]), label: match[2].trim() }] : [];
      });
    if (!ratings.length) return;

    const label = type === 'crowding' ? 'crowding' : 'comfort';
    const groups = ratings.map(({ score, label: ratingLabel }) => {
      const displayLabel = ratings.length > 1 ? ratingLabel : '';
      const icons = Array.from({ length: 5 }, (_, index) =>
        `<span aria-hidden="true" class="rating-icon${index >= score ? ' rating-icon--empty' : ''}">&#9733;</span>`,
      ).join('');
      const context = displayLabel ? ` ${displayLabel}` : '';
      return `<span class="rating-group"><span class="rating-icons rating-icons--${type}" aria-label="${score} out of 5 for ${label}${context}">${icons}</span>${displayLabel ? `<span class="rating-group__label">${displayLabel}</span>` : ''}</span>`;
    }).join('');

    element.innerHTML = `<span class="rating-groups">${groups}</span>`;
  };

  document.querySelectorAll('.article__body .line-guide').forEach((guide) => {
    const crowding = Array.from(guide.querySelectorAll('dt')).find(
      (term) => term.textContent?.trim() === 'Typical crowding',
    );
    const comfort = Array.from(guide.querySelectorAll('dt')).find(
      (term) => term.textContent?.trim() === 'Comfort',
    );

    if (crowding) addRatingIcons(crowding.nextElementSibling, 'crowding');
    if (comfort) addRatingIcons(comfort.nextElementSibling, 'comfort');
  });

  document.querySelectorAll('.article__body td[data-label="Typical crowding"]').forEach((cell) => addRatingIcons(cell, 'crowding'));
  document.querySelectorAll('.article__body td[data-label="Comfort"]').forEach((cell) => addRatingIcons(cell, 'comfort'));

  const overgroundTable = Array.from(document.querySelectorAll('.article__body table')).find(
    (table) => table.querySelector('th')?.textContent?.trim() === 'Overground line',
  );
  if (overgroundTable) {
    overgroundTable.classList.add('overground-comparison');
    overgroundTable.querySelectorAll('tbody tr').forEach((row) => {
      const cells = row.querySelectorAll('td');
      addRatingIcons(cells[3], 'crowding');
      addRatingIcons(cells[4], 'comfort');
    });
  }

  document.querySelectorAll('.article__body .line-guide').forEach((guide) => {
    const details = Array.from(guide.children).filter((child) => child.tagName !== 'DL');
    details.reverse().forEach((detail) => guide.after(detail));
  });

  document.querySelectorAll<HTMLElement>('.article__body dt, .article__body th, .article__body td').forEach((element) => {
    if (element.textContent?.trim() === 'Air-conditioning') element.textContent = 'A/C';
    if (element.dataset.label === 'Air-conditioning') element.dataset.label = 'A/C';
  });
</script>
