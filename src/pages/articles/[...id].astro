---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { activeSite } from "../../sites";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  return articles
    .filter((entry) => !entry.data.draft && entry.data.sites.includes(activeSite.id))
    .map((entry) => ({
      params: { id: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  category={entry.data.category}
  tags={entry.data.tags}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  heroImage={entry.data.heroImage}
  heroImageAlt={entry.data.heroImageAlt}
  heroImageCredit={entry.data.heroImageCredit}
  heroImageSource={entry.data.heroImageSource}
  heroImageLicense={entry.data.heroImageLicense}
  heroImageLicenseUrl={entry.data.heroImageLicenseUrl}
  headings={headings}
>
  <Content />
</ArticleLayout>
