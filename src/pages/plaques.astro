---
// Every commemorative plaque in London on one searchable map.
//
// DATA: Open Plaques (openplaques.org), whose About page declares the data
// public domain. Fetched into public/plaques.json by scripts/fetch-plaques.mjs
// and served as a static asset - the page fetches it client-side because
// ~3,500 inscriptions inlined into the HTML would triple the page weight.
//
// The map is Leaflet plus markercluster, loaded from unpkg on first paint the
// same way ArticleLayout's restaurant maps load Leaflet - one loader, cached
// by the browser. Clustering is not optional at this scale: 3,500 individual
// DOM markers locks up a phone.
//
// London build only - the toolkit site has no reason to carry this.
import fs from "node:fs";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import featured from "../data/plaques-featured.json";

// Count and freshness for the header come from the same file the client
// fetches, read at build time.
let count = 0;
let fetched = "";
try {
  const data = JSON.parse(fs.readFileSync("public/plaques.json", "utf8"));
  count = data.count ?? 0;
  fetched = data.fetched ?? "";
} catch {
  /* page still builds; the client shows its own error state */
}

// The IDs already written up in the blue plaques article get a gold ring on
// the map and a line in their popup. Hand-checked, not fuzzy-matched - see
// the note in plaques-featured.json for why that matters.
const featuredIds = featured.plaques.map((p) => p.id);

// What each colour actually means - checked against this dataset's own
// `organisations` field, not a general "blue plaques" explainer, since real
// schemes vary a lot by borough. Only colours with one clear dominant issuer
// get a specific line; the rest are covered by the closing note below.
const COLOUR_LEGEND = [
  { colour: "blue", hex: "#2b6cb0", label: "Blue",
    note: "The official scheme — mostly English Heritage's London-wide plaques, plus some from the City of London Corporation." },
  { colour: "green", hex: "#2f855a", label: "Green",
    note: "Mostly the City of Westminster's own scheme, plus several boroughs running their own." },
  { colour: "brown", hex: "#8b5e34", label: "Brown",
    note: "Mostly the London Borough of Hackney's own scheme." },
  { colour: "film cell", hex: "#33363b", label: "Film cell",
    note: "British Film Institute plaques for people in film — shaped like a strip of celluloid, whatever the actual colour." },
  { colour: "maroon", hex: "#7b241c", label: "Maroon",
    note: "Mostly the London Borough of Lewisham's own scheme." },
  { colour: "marble", hex: "#c7c2b8", label: "Marble",
    note: "Mostly the Police Memorial Trust, commemorating police officers." },
  { colour: "red and black", hex: "#c53030", label: "Red & black",
    note: "Mostly the Institution of Mechanical Engineers' own scheme." },
  { colour: "pink", hex: "#d391b0", label: "Pink",
    note: "Highgate Heritage's own scheme." },
];

const title = "London Plaques Map";
const description = `Every commemorative plaque in London on one searchable map — ${count.toLocaleString("en-GB")} of them, from official blue plaques to borough, Nubian Jak and rainbow schemes.`;

// Same pattern as guides/index.astro and topics/[category].astro - drives
// both the visible trail and BaseLayout's BreadcrumbList JSON-LD.
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Things to Do", href: "/topics/things-to-do/" },
  { label: "Plaques map" },
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <main class="plaques-page">
    <header class="plaques-header">
      <Breadcrumbs items={breadcrumbs} />
      <p class="eyebrow">Things to do · Free</p>
      <h1>The London Plaques Map</h1>
      <p class="stand">
        Those blue, green, brown and black roundels fixed to buildings across the
        city mark where someone notable lived, worked or made history — this map
        has all {count.toLocaleString("en-GB")} of them. Search a name, filter by
        colour or subject, or switch to the list to browse.
        Reading first? Start with <a href="/articles/london-blue-plaques/">the ones worth walking to</a>.
      </p>
    </header>

    <script type="application/json" id="featured-ids" set:html={JSON.stringify(featuredIds)} />
    <div class="plaques-controls" role="search">
      <div class="plaques-typeahead">
        <input
          id="plaque-search"
          type="search"
          placeholder="Search names, inscriptions, organisations — try Hendrix, nurse, or Nubian Jak"
          aria-label="Search plaques"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="plaque-suggest"
          aria-autocomplete="list"
        />
        <ul id="plaque-suggest" class="plaques-suggest" role="listbox" hidden></ul>
      </div>
      <div class="plaques-filters" id="category-filters" aria-label="Filter by subject"></div>
      <div class="plaques-filters" id="colour-filters" aria-label="Filter by plaque colour"></div>

      <details class="plaques-legend">
        <summary>What do the plaque colours mean?</summary>
        <dl>
          {COLOUR_LEGEND.map((c) => (
            <div class="legend-row">
              <dt><span class="legend-dot" style={`background:${c.hex}`}></span>{c.label}</dt>
              <dd>{c.note}</dd>
            </div>
          ))}
        </dl>
        <p class="legend-more">
          Black, bronze, stone, white, grey, brass, slate, red, multicoloured
          and the rest are mostly individual boroughs, heritage societies and
          specialist trusts (the Transport Trust, Firemen Remembered, and
          others) — no single scheme, but a real one behind each. Filter by
          colour above to see who's behind any of them, or read the full guide to
          <a href="/articles/london-plaques-guide/">how London's plaques work</a>.
        </p>
      </details>

      <div class="plaques-viewrow">
        <p class="plaques-count" id="plaque-count" aria-live="polite"></p>
        <button type="button" id="area-chip" class="area-chip" hidden aria-label="Clear area filter">
          📍 <span id="area-chip-name"></span> <span aria-hidden="true">✕</span>
        </button>
        <div class="plaques-viewtoggle" role="group" aria-label="Map or list view">
          <button type="button" id="view-map-btn" aria-pressed="true">Map</button>
          <button type="button" id="view-list-btn" aria-pressed="false">List</button>
        </div>
      </div>
    </div>

    <div id="plaques-map" class="plaques-map">
      <noscript><p>The map needs JavaScript. The plaque data itself is
        <a href="/plaques.json">available as JSON</a>, public domain.</p></noscript>
    </div>

    <div id="plaques-list" class="plaques-list" hidden>
      <div class="plaques-list-head">
        <label>
          Sort
          <select id="list-sort">
            <option value="name">Name, A–Z</option>
            <option value="area">Area, A–Z</option>
            <option value="erected">Newest first</option>
          </select>
        </label>
      </div>
      <ul id="plaque-list-items" class="plaques-list-items"></ul>
      <button type="button" id="list-load-more" class="plaques-list-more" hidden>Show 300 more</button>
    </div>

    <ul id="plaque-results" class="plaques-results" aria-label="Matching plaques"></ul>

    <footer class="plaques-footer">
      <p>
        Data: Open Plaques (public domain){fetched && fetched !== "stub" ? `, fetched ${fetched}` : ""}.
        Map © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a> contributors.
      </p>
      <p>
        More like this: <a href="/articles/london-blue-plaques/">Blue Plaques guide</a> ·
        <a href="/articles/london-plaques-guide/">How the plaques work</a> ·
        <a href="/articles/london-street-art/">Street art</a> ·
        <a href="/articles/hidden-london-secret-places/">Hidden London</a> ·
        <a href="/free/">Free things to do</a>
      </p>
    </footer>
  </main>
</BaseLayout>

<style>
  .plaques-page {
    max-width: var(--page-width, 76rem);
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  .plaques-header { max-width: 46rem; margin-bottom: 1.25rem; }
  .eyebrow {
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent, #d6392f); margin: 0 0 0.4rem;
  }
  .plaques-header h1 {
    font-family: var(--display, Georgia, serif);
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    line-height: 1.08; margin: 0 0 0.6rem;
  }
  .stand { color: var(--ink-soft, #22344a); margin: 0; }

  .plaques-controls { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 0.9rem; }
  #plaque-search {
    width: 100%; max-width: 34rem;
    padding: 0.65rem 0.9rem;
    font: inherit;
    border: 1px solid var(--line-strong, #cbc2b2);
    border-radius: 0.6rem;
    background: var(--surface, #fff);
    color: var(--ink, #0e1b2c);
  }
  #plaque-search:focus-visible { outline: 2px solid var(--accent, #d6392f); outline-offset: 1px; }

  .plaques-filters { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  /* :global() throughout this block - the chips themselves are built with
     document.createElement in the client script, not written in this
     template, so Astro's compile-time scoping attribute never reaches them. */
  :global(.plaques-filters button) {
    font: inherit; font-size: 0.82rem;
    padding: 0.28rem 0.7rem 0.28rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong, #cbc2b2);
    background: var(--surface, #fff);
    color: var(--ink, #0e1b2c);
    cursor: pointer;
    display: inline-flex; align-items: center; gap: 0.4rem;
  }
  :global(.plaques-filters button .dot) {
    width: 0.7rem; height: 0.7rem; border-radius: 50%;
    border: 1px solid rgb(0 0 0 / 0.25);
    display: inline-block;
  }
  /* A light tint of the accent, not a solid fill - a solid dark/red chip
     read as harsh once several were active at once. */
  :global(.plaques-filters button[aria-pressed="true"]) {
    background: rgb(214 57 47 / 0.12); color: var(--accent, #d6392f);
    border-color: var(--accent, #d6392f); font-weight: 600;
  }
  :global(.plaques-filters button.is-star) {
    border-color: var(--highlight, #f2a93b); color: var(--amber-ink, #8a5a0d);
    font-weight: 600;
  }
  :global(.plaques-filters button.is-star[aria-pressed="true"]) {
    background: var(--highlight, #f2a93b); color: #402c04; border-color: var(--highlight, #f2a93b);
  }
  .plaques-typeahead { position: relative; max-width: 34rem; }
  .plaques-suggest {
    /* Leaflet's own panes and controls run z-index 400-1000, so anything
       meant to sit above the map needs to clear that whole range, not just
       beat an arbitrary round number. */
    position: absolute; z-index: 1001; left: 0; right: 0; top: calc(100% + 0.25rem);
    margin: 0; padding: 0.25rem; list-style: none;
    background: var(--surface, #fff);
    border: 1px solid var(--line-strong, #cbc2b2);
    border-radius: 0.6rem;
    box-shadow: 0 12px 32px rgb(14 27 44 / 0.16);
    max-height: 19rem; overflow-y: auto;
  }
  /* :global() - every <li>/<button> here is built by updateSuggest() in the
     client script, not written in this template, same scoping gap as above. */
  :global(.plaques-suggest li) { margin: 0; }
  :global(.plaques-suggest button) {
    display: flex; gap: 0.5rem; align-items: baseline;
    width: 100%; text-align: left; font: inherit; font-size: 0.88rem;
    padding: 0.42rem 0.55rem; border: 0; border-radius: 0.4rem;
    background: none; color: var(--ink, #0e1b2c); cursor: pointer;
  }
  :global(.plaques-suggest button:hover),
  :global(.plaques-suggest li[aria-selected="true"] button) {
    background: var(--surface-strong, #f0ebe2);
  }
  :global(.plaques-suggest .s-dot) {
    flex: none; width: 0.6rem; height: 0.6rem; border-radius: 50%;
    border: 1px solid rgb(0 0 0 / 0.25); margin-top: 0.28rem;
  }
  :global(.plaques-suggest .s-main) { flex: 1; min-width: 0; }
  :global(.plaques-suggest .s-name) { display: block; font-weight: 600; }
  :global(.plaques-suggest .s-where) {
    display: block; color: var(--muted, #5a6a7d); font-size: 0.78rem;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  :global(.plaques-suggest mark) { background: #ffe9a8; color: inherit; border-radius: 0.15rem; }
  :global(.plaques-suggest .s-more) {
    padding: 0.35rem 0.55rem; font-size: 0.78rem; color: var(--muted, #5a6a7d);
  }

  .plaques-legend {
    border: 1px solid var(--line, #e2dbcf);
    border-radius: 0.6rem;
    background: var(--surface, #fff);
    padding: 0.15rem 0.8rem;
  }
  .plaques-legend summary {
    padding: 0.55rem 0; font-size: 0.85rem; font-weight: 600; cursor: pointer;
    list-style: none;
  }
  .plaques-legend summary::-webkit-details-marker { display: none; }
  .plaques-legend summary::before { content: "▸ "; color: var(--muted, #5a6a7d); }
  .plaques-legend[open] summary::before { content: "▾ "; }
  .plaques-legend dl {
    margin: 0 0 0.7rem;
    display: grid; gap: 0.5rem 1.2rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }
  .legend-row dt {
    display: flex; align-items: center; gap: 0.45rem;
    font-weight: 600; font-size: 0.85rem; margin: 0;
  }
  .legend-row dd {
    margin: 0.15rem 0 0; font-size: 0.82rem; color: var(--muted, #5a6a7d);
  }
  .legend-dot {
    width: 0.75rem; height: 0.75rem; border-radius: 50%; flex: none;
    border: 1px solid rgb(0 0 0 / 0.25);
  }
  .legend-more {
    margin: 0 0 0.7rem; font-size: 0.82rem; color: var(--muted, #5a6a7d);
    border-top: 1px solid var(--line, #e2dbcf); padding-top: 0.6rem;
  }

  .plaques-viewrow {
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.75rem; flex-wrap: wrap;
  }
  .plaques-count { font-size: 0.88rem; color: var(--muted, #5a6a7d); margin: 0; }

  .area-chip {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font: inherit; font-size: 0.82rem; font-weight: 600;
    padding: 0.25rem 0.65rem; border-radius: 999px;
    border: 1px solid var(--accent, #d6392f);
    background: rgb(214 57 47 / 0.12); color: var(--accent, #d6392f);
    cursor: pointer;
  }

  .plaques-viewtoggle {
    display: inline-flex; border: 1px solid var(--line-strong, #cbc2b2);
    border-radius: 999px; padding: 0.15rem; gap: 0.15rem;
  }
  .plaques-viewtoggle button {
    font: inherit; font-size: 0.82rem; font-weight: 600;
    padding: 0.28rem 0.85rem; border: 0; border-radius: 999px;
    background: none; color: var(--muted, #5a6a7d); cursor: pointer;
  }
  .plaques-viewtoggle button[aria-pressed="true"] {
    background: rgb(214 57 47 / 0.12); color: var(--accent, #d6392f);
  }

  .plaques-map {
    height: min(72vh, 40rem);
    border-radius: 0.9rem;
    border: 1px solid var(--line, #e2dbcf);
    overflow: hidden;
    background: var(--surface-strong, #f0ebe2);
    /* Leaflet's own panes/controls run z-index up to 700-1000. Without this,
       that competes directly against the site's sticky header (z-index: 90)
       in the SAME stacking context and wins, so the map visibly renders on
       top of the header once it's scrolled up over the map. isolation walls
       off everything inside the map so its internal z-index chaos can never
       be compared against anything outside this box. */
    isolation: isolate;
  }

  .plaques-list {
    border: 1px solid var(--line, #e2dbcf);
    border-radius: 0.9rem;
    background: var(--surface, #fff);
    padding: 0.6rem 0.9rem 0.9rem;
  }
  .plaques-list-head {
    display: flex; justify-content: flex-end;
    padding: 0.4rem 0.1rem 0.6rem;
    border-bottom: 1px solid var(--line, #e2dbcf);
    font-size: 0.85rem; color: var(--muted, #5a6a7d);
  }
  .plaques-list-head select {
    font: inherit; margin-left: 0.4rem;
    border: 1px solid var(--line-strong, #cbc2b2); border-radius: 0.4rem;
    background: var(--surface, #fff); color: var(--ink, #0e1b2c);
    padding: 0.15rem 0.4rem;
  }
  .plaques-list-items { list-style: none; margin: 0; padding: 0; }
  /* :global() - rows are built by renderListRow() in the client script. */
  :global(.plaques-list-items li) {
    border-bottom: 1px solid var(--line, #e2dbcf);
  }
  :global(.plaques-list-items li:last-child) { border-bottom: 0; }
  :global(.plaques-list-items button) {
    display: flex; gap: 0.65rem; align-items: baseline; width: 100%;
    font: inherit; text-align: left; padding: 0.55rem 0.3rem;
    border: 0; background: none; color: var(--ink, #0e1b2c); cursor: pointer;
  }
  :global(.plaques-list-items button:hover) { background: var(--surface-strong, #f0ebe2); }
  :global(.plaques-list-items .l-dot) {
    flex: none; width: 0.7rem; height: 0.7rem; border-radius: 50%;
    margin-top: 0.3rem; border: 1px solid rgb(0 0 0 / 0.25);
  }
  :global(.plaques-list-items .l-star) {
    flex: none; color: var(--highlight, #f2a93b); font-weight: 700;
  }
  :global(.plaques-list-items .l-main) { flex: 1; min-width: 0; }
  :global(.plaques-list-items .l-name) { display: block; font-weight: 600; }
  :global(.plaques-list-items .l-where) {
    display: block; color: var(--muted, #5a6a7d); font-size: 0.82rem;
  }
  .plaques-list-more {
    display: block; width: 100%; margin-top: 0.7rem;
    font: inherit; font-weight: 600; padding: 0.6rem;
    border: 1px dashed var(--line-strong, #cbc2b2); border-radius: 0.6rem;
    background: var(--surface-strong, #f0ebe2); color: var(--ink, #0e1b2c);
    cursor: pointer;
  }

  .plaques-results {
    list-style: none; padding: 0;
    margin: 0.9rem 0 0;
    display: grid; gap: 0.4rem;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }
  /* :global() - rows are built by render() in the client script. */
  :global(.plaques-results li) { margin: 0; }
  :global(.plaques-results button) {
    font: inherit; font-size: 0.85rem; text-align: left; width: 100%;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--line, #e2dbcf);
    border-radius: 0.6rem;
    background: var(--surface, #fff);
    color: var(--ink, #0e1b2c);
    cursor: pointer;
  }
  :global(.plaques-results button:hover) { border-color: var(--accent, #d6392f); }
  :global(.plaques-results .where) { display: block; color: var(--muted, #5a6a7d); font-size: 0.78rem; }

  .plaques-footer { margin-top: 1.5rem; font-size: 0.85rem; color: var(--muted, #5a6a7d); }
  .plaques-footer p { margin: 0.3rem 0; }

  /* Leaflet chrome, restyled to the site's own tokens. :global() because
     Leaflet builds these nodes at runtime, outside Astro's scoping. */
  :global(.plaques-map .leaflet-popup-content-wrapper) {
    border-radius: 0.7rem;
    box-shadow: 0 2px 6px rgb(14 27 44 / 0.12), 0 12px 32px rgb(14 27 44 / 0.18);
  }
  :global(.plaque-pop) { font-family: inherit; max-width: 17rem; padding: 0.15rem 0.1rem; }
  :global(.plaque-pop strong) { font-size: 0.98rem; line-height: 1.3; }
  :global(.plaque-pop-dot) {
    display: inline-block; width: 0.65rem; height: 0.65rem;
    border-radius: 50%; margin-right: 0.4rem;
    border: 1px solid rgb(0 0 0 / 0.25); vertical-align: baseline;
  }
  :global(.plaque-pop-insc) {
    margin: 0.45em 0; font-style: italic;
    color: var(--ink-soft, #22344a); line-height: 1.45;
  }
  :global(.plaque-pop-addr) { margin: 0.2em 0; font-size: 0.86em; }
  :global(.plaque-pop-meta) { margin: 0.2em 0 0.5em; color: var(--muted, #5a6a7d); font-size: 0.82em; }
  :global(.plaque-pop-featured) {
    margin: 0.4em 0 0; padding-top: 0.4em;
    border-top: 1px dashed var(--line, #e2dbcf);
    color: var(--amber-ink, #8a5a0d); font-weight: 600; font-size: 0.85em;
  }
  :global(.plaque-pop-featured a) { color: inherit; text-decoration: underline; }
  :global(.plaque-pop a) { color: var(--secondary, #1d4e89); font-weight: 600; font-size: 0.88em; }

  /* Clusters: the plugin's default green-yellow traffic lights fight every
     palette, but a solid dark disc (ink black, then accent red) read as
     harsh at this density - dozens of them covering the whole map. A pale
     warm amber with dark text carries the same "here's a count" job without
     the wall-of-dark-dots effect. */
  :global(.plaques-map .marker-cluster),
  :global(.plaques-map .marker-cluster div) {
    background: rgb(242 169 59 / 0.92);
    color: var(--ink, #0e1b2c);
  }
  :global(.plaques-map .marker-cluster) {
    border: 3px solid rgb(255 255 255 / 0.9);
    box-shadow: 0 1px 4px rgb(14 27 44 / 0.22);
  }
  :global(.plaques-map .marker-cluster div) {
    font: 600 0.78rem/1 var(--body, system-ui, sans-serif);
    display: flex; align-items: center; justify-content: center;
  }
</style>

<script>
  // Everything below runs client-side. Data arrives by fetch, the map lazily.
  const COLOUR_HEX: Record<string, string> = {
    blue: "#2b6cb0", green: "#2f855a", brown: "#8b5e34", black: "#2d3242",
    grey: "#718096", gray: "#718096", red: "#c53030", white: "#e2e8f0",
    bronze: "#b0793a", gold: "#b7791f",
    rainbow: "#d53f8c", terracotta: "#c05621", unknown: "#4a5568",
    maroon: "#7b241c", pink: "#d391b0", brass: "#a68a3c", stone: "#9c9284",
    slate: "#51606b", "brushed metal": "#9aa5ad", "film cell": "#33363b",
    marble: "#c7c2b8", yellow: "#c9a227", claret: "#6e1423",
    purple: "#6b46c1", orange: "#dd6b20", clear: "#cbd5e0", wood: "#7c5a3a",
  };
  // A couple of colours are genuinely two-tone or many-tone - a single hex
  // can't represent them honestly, so these get a small gradient instead.
  const COLOUR_GRADIENT: Record<string, string> = {
    "red and black": "conic-gradient(#c53030 0deg 180deg, #2d3242 180deg 360deg)",
    multicoloured: "conic-gradient(#d6392f, #f2a93b, #2f855a, #2b6cb0, #6b46c1, #d6392f)",
    "green and red": "conic-gradient(#2f855a 0deg 180deg, #c53030 180deg 360deg)",
    "belgian blue stone": "#51606b",
  };
  const colourHex = (c: string) => COLOUR_GRADIENT[c] || COLOUR_HEX[c] || COLOUR_HEX.unknown;

  type Plaque = {
    id: number; title: string; inscription: string;
    lat: number; lng: number; colour: string;
    org: string; erected: string; address: string; subject: string;
    category: string;
  };

  // Reader-facing labels for the buckets scripts/fetch-plaques.mjs sorts
  // lead_subject_roles into. Order here is the order the chips render in.
  const CATEGORY_LABELS: Record<string, string> = {
    music: "Music",
    "film-tv-theatre": "Film, TV & theatre",
    literature: "Literature",
    "art-design": "Art & design",
    "science-medicine": "Science & medicine",
    "politics-military": "Politics & military",
    sport: "Sport",
    royalty: "Royalty",
    other: "Other / unclassified",
  };

  const mapEl = document.getElementById("plaques-map")!;
  const searchEl = document.getElementById("plaque-search") as HTMLInputElement;
  const suggestEl = document.getElementById("plaque-suggest")!;
  const filtersEl = document.getElementById("colour-filters")!;
  const categoryFiltersEl = document.getElementById("category-filters")!;
  const countEl = document.getElementById("plaque-count")!;
  const resultsEl = document.getElementById("plaque-results")!;
  const listContainerEl = document.getElementById("plaques-list")!;
  const listItemsEl = document.getElementById("plaque-list-items")!;
  const listSortEl = document.getElementById("list-sort") as HTMLSelectElement;
  const listMoreBtn = document.getElementById("list-load-more") as HTMLButtonElement;
  const viewMapBtn = document.getElementById("view-map-btn")!;
  const viewListBtn = document.getElementById("view-list-btn")!;
  const areaChipEl = document.getElementById("area-chip")!;
  const areaChipNameEl = document.getElementById("area-chip-name")!;

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[m]!);

  // ------------------------------------------------------------ leaflet load
  // Same one-loader pattern as the article maps: reuse window.L if another
  // component got there first, otherwise inject once.
  function loadCss(href: string, marker: string) {
    if (document.querySelector(`link[${marker}]`)) return;
    const l = document.createElement("link");
    l.rel = "stylesheet"; l.href = href; l.setAttribute(marker, "");
    document.head.appendChild(l);
  }
  function loadScript(src: string): Promise<void> {
    return new Promise((res, rej) => {
      const s = document.createElement("script");
      s.src = src; s.onload = () => res(); s.onerror = rej;
      document.head.appendChild(s);
    });
  }
  async function loadLeaflet(): Promise<any> {
    const w = window as any;
    loadCss("https://unpkg.com/leaflet@1.9.4/dist/leaflet.css", "data-leaflet-styles");
    loadCss("https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css", "data-mc-styles");
    loadCss("https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css", "data-mcd-styles");
    // CDN plugin loads can race, so each step verifies its symbol actually
    // arrived and retries once with a cache-buster before giving up.
    const ensure = async (src: string, ok: () => boolean) => {
      for (let attempt = 0; attempt < 2 && !ok(); attempt++) {
        await loadScript(attempt ? `${src}?retry=1` : src).catch(() => {});
        for (let i = 0; i < 20 && !ok(); i++) await new Promise((r) => setTimeout(r, 50));
      }
      if (!ok()) throw new Error(`failed to load ${src}`);
    };
    await ensure("https://unpkg.com/leaflet@1.9.4/dist/leaflet.js", () => !!w.L);
    await ensure("https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js",
                 () => !!(w.L && w.L.markerClusterGroup));
    return w.L;
  }

  // ------------------------------------------------------------------- state
  let plaques: Plaque[] = [];
  let activeColours = new Set<string>();   // empty = all
  let activeCategories = new Set<string>(); // empty = all
  let showFeaturedOnly = false;
  let query = "";
  let map: any, cluster: any, L: any;
  const markerById = new Map<number, any>();
  let viewMode: "map" | "list" = "map";
  let listSort = "name";
  let listVisible: Plaque[] = [];
  let listShown = 0;
  const LIST_PAGE = 300;

  // ---------------------------------------------------------------- areas
  // Lets an area guide link straight to "just this neighbourhood" via
  // ?area=slug. The dataset only records borough-level location text, not
  // neighbourhood polygons, so this is a best-effort centre + radius per
  // area guide, not a surveyed boundary - good enough for "roughly here".
  const AREA_BOUNDS: Record<string, { name: string; lat: number; lng: number; km: number }> = {
    battersea: { name: "Battersea", lat: 51.4720, lng: -0.1649, km: 1.3 },
    bermondsey: { name: "Bermondsey", lat: 51.4979, lng: -0.0827, km: 1.1 },
    bloomsbury: { name: "Bloomsbury", lat: 51.5220, lng: -0.1257, km: 0.9 },
    camden: { name: "Camden", lat: 51.5390, lng: -0.1426, km: 1.1 },
    "canary-wharf": { name: "Canary Wharf", lat: 51.5054, lng: -0.0235, km: 1.2 },
    chelsea: { name: "Chelsea", lat: 51.4875, lng: -0.1687, km: 1.1 },
    "city-of-london": { name: "the City of London", lat: 51.5155, lng: -0.0922, km: 1.2 },
    "covent-garden": { name: "Covent Garden", lat: 51.5117, lng: -0.1240, km: 0.7 },
    fitzrovia: { name: "Fitzrovia", lat: 51.5185, lng: -0.1395, km: 0.7 },
    greenwich: { name: "Greenwich", lat: 51.4826, lng: -0.0077, km: 1.3 },
    hackney: { name: "Hackney", lat: 51.5450, lng: -0.0553, km: 1.3 },
    hampstead: { name: "Hampstead", lat: 51.5560, lng: -0.1780, km: 1.2 },
    islington: { name: "Islington", lat: 51.5416, lng: -0.1022, km: 1.1 },
    kensington: { name: "Kensington", lat: 51.5010, lng: -0.1935, km: 1.1 },
    "kings-cross": { name: "King's Cross", lat: 51.5308, lng: -0.1238, km: 0.9 },
    marylebone: { name: "Marylebone", lat: 51.5183, lng: -0.1500, km: 0.9 },
    mayfair: { name: "Mayfair", lat: 51.5100, lng: -0.1490, km: 0.8 },
    "notting-hill": { name: "Notting Hill", lat: 51.5150, lng: -0.1964, km: 1.0 },
    paddington: { name: "Paddington", lat: 51.5154, lng: -0.1755, km: 0.9 },
    peckham: { name: "Peckham", lat: 51.4730, lng: -0.0693, km: 1.2 },
    richmond: { name: "Richmond", lat: 51.4613, lng: -0.3037, km: 1.4 },
    shoreditch: { name: "Shoreditch", lat: 51.5259, lng: -0.0784, km: 1.0 },
    soho: { name: "Soho", lat: 51.5136, lng: -0.1355, km: 0.7 },
    "south-bank": { name: "the South Bank", lat: 51.5062, lng: -0.1104, km: 1.0 },
    "south-kensington": { name: "South Kensington", lat: 51.4941, lng: -0.1738, km: 0.9 },
    stratford: { name: "Stratford", lat: 51.5416, lng: -0.0042, km: 1.3 },
    wapping: { name: "Wapping", lat: 51.5044, lng: -0.0552, km: 1.0 },
    westminster: { name: "Westminster", lat: 51.4995, lng: -0.1357, km: 1.1 },
  };
  let activeArea: string | null = null;

  function kmBetween(lat1: number, lng1: number, lat2: number, lng2: number): number {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLng = (lng2 - lng1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) ** 2 +
      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLng / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }
  function inArea(p: Plaque, area: { lat: number; lng: number; km: number }): boolean {
    return kmBetween(p.lat, p.lng, area.lat, area.lng) <= area.km;
  }

  // IDs already written up in the blue plaques article, inlined at build
  // time by Astro - see plaques-featured.json for how these were checked.
  const featuredIds: Set<number> = new Set(
    JSON.parse(document.getElementById("featured-ids")!.textContent || "[]"),
  );

  function matches(p: Plaque): boolean {
    if (showFeaturedOnly && !featuredIds.has(p.id)) return false;
    if (activeColours.size && !activeColours.has(p.colour || "unknown")) return false;
    if (activeCategories.size && !activeCategories.has(p.category || "other")) return false;
    if (activeArea && AREA_BOUNDS[activeArea] && !inArea(p, AREA_BOUNDS[activeArea])) return false;
    if (!query) return true;
    const hay = `${p.title} ${p.inscription} ${p.org} ${p.subject} ${p.address}`.toLowerCase();
    return query.split(/\s+/).every((t) => hay.includes(t));
  }

  function popupHtml(p: Plaque): string {
    const bits = [
      p.erected && `Erected ${esc(p.erected)}`,
      p.colour && esc(p.colour[0].toUpperCase() + p.colour.slice(1)),
      p.org && esc(p.org),
    ].filter(Boolean).join(" · ");
    const featured = featuredIds.has(p.id)
      ? `<p class="plaque-pop-featured">★ In our <a href="/articles/london-blue-plaques/">Blue Plaques guide</a></p>`
      : "";
    return `
      <div class="plaque-pop">
        <span class="plaque-pop-dot" style="background:${colourHex(p.colour || "unknown")}"></span>
        <strong>${esc(p.title)}</strong>
        <p class="plaque-pop-insc">&ldquo;${esc(p.inscription)}&rdquo;</p>
        ${p.address ? `<p class="plaque-pop-addr">${esc(p.address)}</p>` : ""}
        ${bits ? `<p class="plaque-pop-meta">${bits}</p>` : ""}
        ${featured}
      </div>`;
  }

  function render() {
    const visible = plaques.filter(matches);
    cluster.clearLayers();
    markerById.clear();
    const markers = visible.map((p) => {
      const star = featuredIds.has(p.id);
      // Featured plaques get a bigger, gold-ringed marker drawn ON TOP of
      // the palette, so they read as "special" at any zoom without needing
      // a whole second icon system.
      const m = L.circleMarker([p.lat, p.lng], star
        ? { radius: 9, weight: 3, color: "#f2a93b", fillColor: colourHex(p.colour || "unknown"), fillOpacity: 1 }
        : { radius: 7, weight: 1.5, color: "#fff", fillColor: colourHex(p.colour || "unknown"), fillOpacity: 0.92 },
      ).bindPopup(popupHtml(p));
      if (star) m.bringToFront();
      markerById.set(p.id, m);
      return m;
    });
    cluster.addLayers(markers);

    const area = activeArea ? AREA_BOUNDS[activeArea] : null;
    if (area) {
      const areaTotal = plaques.filter((p) => inArea(p, area)).length;
      countEl.textContent =
        visible.length === areaTotal
          ? `${visible.length.toLocaleString("en-GB")} plaques in ${area.name}`
          : `${visible.length.toLocaleString("en-GB")} of ${areaTotal.toLocaleString("en-GB")} plaques in ${area.name} match`;
    } else {
      countEl.textContent =
        visible.length === plaques.length
          ? `${plaques.length.toLocaleString("en-GB")} plaques`
          : `${visible.length.toLocaleString("en-GB")} of ${plaques.length.toLocaleString("en-GB")} plaques match`;
    }

    // True whenever any filter narrows the set - search, colour, category,
    // area or the featured-only star. Any one of them should zoom to fit.
    const filtered = !!(query || activeColours.size || activeCategories.size || showFeaturedOnly || activeArea);

    // Zoom the map to the matching pins whenever a filter is active, so a
    // search or category pick visibly answers "where are they" without any
    // panning. Skips the unfiltered state - resetting to the full-London view
    // on every cleared search would be more jarring than helpful.
    if (filtered && visible.length) {
      const bounds = L.latLngBounds(visible.map((p) => [p.lat, p.lng]));
      map.fitBounds(bounds, { padding: [40, 40], maxZoom: 16 });
    }

    // Result list only while actively filtering; capped so the DOM stays light.
    resultsEl.innerHTML = "";
    if (filtered && visible.length && visible.length <= 60) {
      for (const p of visible.slice(0, 60)) {
        const li = document.createElement("li");
        const b = document.createElement("button");
        b.innerHTML = `${esc(p.title)}<span class="where">${esc(p.address || p.org || "")}</span>`;
        b.addEventListener("click", () => { setView("map"); focusPlaque(p.id); });
        li.appendChild(b);
        resultsEl.appendChild(li);
      }
    }
  }

  function focusPlaque(id: number) {
    const p = plaques.find((x) => x.id === id);
    const m = markerById.get(id);
    if (!p || !m) return;
    map.setView([p.lat, p.lng], 17);
    // markercluster needs a beat to unspiderfy before the popup can open
    setTimeout(() => { cluster.zoomToShowLayer(m, () => m.openPopup()); }, 100);
    history.replaceState(null, "", `#plaque-${id}`);
  }

  function buildColourFilters() {
    // The starred toggle leads the row - it is the one filter that answers
    // "what has this website already written about", which is a different
    // question from "what colour is it" and deserves top billing.
    if (featuredIds.size) {
      const star = document.createElement("button");
      star.className = "is-star";
      star.setAttribute("aria-pressed", "false");
      star.innerHTML = `★ On this site (${featuredIds.size})`;
      star.addEventListener("click", () => {
        showFeaturedOnly = !showFeaturedOnly;
        star.setAttribute("aria-pressed", String(showFeaturedOnly));
        refresh();
      });
      filtersEl.appendChild(star);
    }

    const counts = new Map<string, number>();
    for (const p of plaques) {
      const c = p.colour || "unknown";
      counts.set(c, (counts.get(c) ?? 0) + 1);
    }
    const ordered = [...counts.entries()].sort((a, b) => b[1] - a[1]);
    for (const [colour, n] of ordered) {
      if (n < 3) continue; // singleton colours are noise as filters
      const b = document.createElement("button");
      b.setAttribute("aria-pressed", "false");
      b.innerHTML = `<span class="dot" style="background:${colourHex(colour)}"></span>${esc(colour)} (${n.toLocaleString("en-GB")})`;
      b.addEventListener("click", () => {
        const on = activeColours.has(colour);
        if (on) activeColours.delete(colour);
        else activeColours.add(colour);
        b.setAttribute("aria-pressed", String(!on));
        refresh();
      });
      filtersEl.appendChild(b);
    }
  }

  function buildCategoryFilters() {
    const counts = new Map<string, number>();
    for (const p of plaques) counts.set(p.category || "other", (counts.get(p.category || "other") ?? 0) + 1);
    // Fixed order (CATEGORY_LABELS' own order), not sorted by count - a
    // stable chip row is easier to scan than one that reshuffles per dataset.
    for (const key of Object.keys(CATEGORY_LABELS)) {
      const n = counts.get(key) ?? 0;
      if (!n) continue;
      const b = document.createElement("button");
      b.setAttribute("aria-pressed", "false");
      b.textContent = `${CATEGORY_LABELS[key]} (${n.toLocaleString("en-GB")})`;
      b.addEventListener("click", () => {
        const on = activeCategories.has(key);
        if (on) activeCategories.delete(key);
        else activeCategories.add(key);
        b.setAttribute("aria-pressed", String(!on));
        refresh();
      });
      categoryFiltersEl.appendChild(b);
    }
  }

  // --------------------------------------------------------------- list view
  // A full, sortable, paginated browse list - distinct from the ≤60-item
  // grid above, which is only meant as a map companion for narrow searches.
  function sortForList(list: Plaque[]): Plaque[] {
    const arr = list.slice();
    if (listSort === "area") arr.sort((a, b) => (a.address || "").localeCompare(b.address || ""));
    else if (listSort === "erected") {
      arr.sort((a, b) => (parseInt(b.erected) || 0) - (parseInt(a.erected) || 0));
    } else {
      arr.sort((a, b) => a.title.localeCompare(b.title));
    }
    return arr;
  }

  function renderListRow(p: Plaque) {
    const li = document.createElement("li");
    const b = document.createElement("button");
    b.type = "button";
    const star = featuredIds.has(p.id) ? `<span class="l-star">★</span>` : "";
    const where = p.address || p.org || "";
    b.innerHTML = `
      <span class="l-dot" style="background:${colourHex(p.colour || "unknown")}"></span>
      <span class="l-main">
        <span class="l-name">${star}${esc(p.title)}</span>
        ${where ? `<span class="l-where">${esc(where)}</span>` : ""}
      </span>`;
    b.addEventListener("click", () => { setView("map"); focusPlaque(p.id); });
    li.appendChild(b);
    listItemsEl.appendChild(li);
  }

  function renderListMore() {
    const next = listVisible.slice(listShown, listShown + LIST_PAGE);
    next.forEach(renderListRow);
    listShown += next.length;
    listMoreBtn.hidden = listShown >= listVisible.length;
  }

  function renderListReset() {
    listVisible = sortForList(plaques.filter(matches));
    listShown = 0;
    listItemsEl.innerHTML = "";
    renderListMore();
  }

  function setView(mode: "map" | "list") {
    viewMode = mode;
    const toMap = mode === "map";
    mapEl.hidden = !toMap;
    listContainerEl.hidden = toMap;
    viewMapBtn.setAttribute("aria-pressed", String(toMap));
    viewListBtn.setAttribute("aria-pressed", String(!toMap));
    if (!toMap) renderListReset();
    // Leaflet sizes itself from the DOM while visible; a map hidden via
    // display:none reports a 0x0 box, so returning to it needs a nudge.
    else if (map) setTimeout(() => map.invalidateSize(), 0);
  }

  viewMapBtn.addEventListener("click", () => setView("map"));
  viewListBtn.addEventListener("click", () => setView("list"));
  listSortEl.addEventListener("change", () => {
    listSort = listSortEl.value;
    renderListReset();
  });
  listMoreBtn.addEventListener("click", renderListMore);

  areaChipEl.addEventListener("click", () => {
    activeArea = null;
    areaChipEl.hidden = true;
    const url = new URL(location.href);
    url.searchParams.delete("area");
    history.replaceState(null, "", url);
    refresh();
  });

  // Every filter/search change updates whichever view is on screen.
  function refresh() {
    render();
    if (viewMode === "list") renderListReset();
  }

  // ------------------------------------------------------------- typeahead
  // A dropdown of specific plaques as you type, ranked so a name match beats
  // an inscription-only match, capped so it never grows past the fold.
  const MAX_SUGGEST = 8;
  let suggestItems: Plaque[] = [];
  let activeIndex = -1;

  function rank(p: Plaque, q: string): number {
    const title = p.title.toLowerCase(), subject = (p.subject || "").toLowerCase();
    if (title.startsWith(q) || subject.startsWith(q)) return 0;
    if (title.includes(q) || subject.includes(q)) return 1;
    if ((p.org || "").toLowerCase().includes(q)) return 2;
    return 3; // inscription or address only
  }

  function highlight(text: string, q: string): string {
    if (!q) return esc(text);
    const i = text.toLowerCase().indexOf(q);
    if (i === -1) return esc(text);
    return esc(text.slice(0, i)) + "<mark>" + esc(text.slice(i, i + q.length)) + "</mark>" + esc(text.slice(i + q.length));
  }

  function closeSuggest() {
    suggestEl.hidden = true;
    suggestEl.innerHTML = "";
    searchEl.setAttribute("aria-expanded", "false");
    searchEl.removeAttribute("aria-activedescendant");
    activeIndex = -1;
    suggestItems = [];
  }

  function paintActive() {
    [...suggestEl.querySelectorAll("li")].forEach((li, i) => {
      const on = i === activeIndex;
      li.setAttribute("aria-selected", String(on));
      if (on) searchEl.setAttribute("aria-activedescendant", li.id);
    });
    (suggestEl.children[activeIndex] as HTMLElement | undefined)?.scrollIntoView({ block: "nearest" });
  }

  function selectSuggestion(p: Plaque) {
    searchEl.value = p.title;
    query = p.title.toLowerCase();
    const url = new URL(location.href);
    url.searchParams.set("q", p.title);
    history.replaceState(null, "", url);
    closeSuggest();
    setView("map");
    render();
    focusPlaque(p.id);
  }

  function updateSuggest(raw: string) {
    const q = raw.trim().toLowerCase();
    if (!q) { closeSuggest(); return; }

    suggestItems = plaques
      .map((p) => ({ p, r: rank(p, q) }))
      .filter(({ r, p }) => r < 3 || `${p.title} ${p.inscription} ${p.subject} ${p.address}`.toLowerCase().includes(q))
      .sort((a, b) => a.r - b.r)
      .slice(0, MAX_SUGGEST)
      .map(({ p }) => p);

    if (!suggestItems.length) { closeSuggest(); return; }

    suggestEl.innerHTML = suggestItems
      .map((p, i) => {
        const where = p.address || p.org || "";
        return `
          <li id="plaque-opt-${p.id}" role="option">
            <button type="button" data-idx="${i}">
              <span class="s-dot" style="background:${colourHex(p.colour || "unknown")}"></span>
              <span class="s-main">
                <span class="s-name">${highlight(p.title, q)}</span>
                ${where ? `<span class="s-where">${esc(where)}</span>` : ""}
              </span>
            </button>
          </li>`;
      })
      .join("");
    suggestEl.hidden = false;
    searchEl.setAttribute("aria-expanded", "true");
    activeIndex = -1;

    suggestEl.querySelectorAll("button").forEach((b, i) =>
      b.addEventListener("click", () => selectSuggestion(suggestItems[i])));
  }

  searchEl.addEventListener("keydown", (e) => {
    if (suggestEl.hidden) return;
    if (e.key === "ArrowDown") {
      e.preventDefault();
      activeIndex = Math.min(activeIndex + 1, suggestItems.length - 1);
      paintActive();
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      activeIndex = Math.max(activeIndex - 1, -1);
      paintActive();
    } else if (e.key === "Enter" && activeIndex >= 0) {
      e.preventDefault();
      selectSuggestion(suggestItems[activeIndex]);
    } else if (e.key === "Escape") {
      closeSuggest();
    }
  });

  document.addEventListener("click", (e) => {
    if (!(e.target as Node) || !searchEl.parentElement?.contains(e.target as Node)) closeSuggest();
  });

  let debounce: ReturnType<typeof setTimeout>;
  searchEl.addEventListener("input", () => {
    clearTimeout(debounce);
    const raw = searchEl.value;
    debounce = setTimeout(() => {
      updateSuggest(raw);
      query = raw.trim().toLowerCase();
      const url = new URL(location.href);
      if (query) url.searchParams.set("q", raw.trim());
      else url.searchParams.delete("q");
      history.replaceState(null, "", url);
      refresh();
    }, 120);
  });

  // -------------------------------------------------------------------- boot
  (async () => {
    countEl.textContent = "Loading the map…";
    try {
      const [data, LL] = await Promise.all([
        fetch("/plaques.json").then((r) => r.json()),
        loadLeaflet(),
      ]);
      L = LL;
      plaques = data.plaques;

      map = L.map(mapEl, { scrollWheelZoom: true }).setView([51.5072, -0.1276], 12);
      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);
      cluster = L.markerClusterGroup({
        chunkedLoading: true,
        maxClusterRadius: 46,
        spiderfyOnMaxZoom: true,
        disableClusteringAtZoom: 17,
      });
      map.addLayer(cluster);

      buildColourFilters();
      buildCategoryFilters();

      // Deep links: ?q= pre-fills search, #plaque-N opens one plaque, ?area=
      // scopes to one area guide's neighbourhood (see AREA_BOUNDS above).
      const qs = new URL(location.href).searchParams.get("q");
      if (qs) { searchEl.value = qs; query = qs.toLowerCase(); }
      const areaParam = new URL(location.href).searchParams.get("area");
      if (areaParam && AREA_BOUNDS[areaParam]) {
        activeArea = areaParam;
        areaChipNameEl.textContent = AREA_BOUNDS[areaParam].name;
        areaChipEl.hidden = false;
      }
      render();
      const m = location.hash.match(/^#plaque-(\d+)$/);
      if (m) focusPlaque(Number(m[1]));
    } catch (e) {
      countEl.textContent = "The map could not load. The data is at /plaques.json.";
      console.error(e);
    }
  })();
</script>
