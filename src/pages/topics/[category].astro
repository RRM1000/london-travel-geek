---
import { getCollection } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { activeSite } from "../../sites";
import { categoryToSlug } from "../../lib/taxonomy";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const categories = Array.from(new Set(articles.filter((article) => !article.data.draft && article.data.sites.includes(activeSite.id)).map((article) => article.data.category)));
  return categories.map((category) => ({ params: { category: categoryToSlug(category) }, props: { category } }));
}

const { category } = Astro.props;
const articles = (await getCollection("articles"))
  .filter((article) => !article.data.draft && article.data.sites.includes(activeSite.id) && article.data.category === category)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const breadcrumbs = [{ label: "Home", href: "/" }, { label: "All guides", href: "/guides/" }, { label: category }];
---

<BaseLayout title={`${category} guides`} description={`Browse London Travel Geek’s ${category.toLowerCase()} guides.`} breadcrumbs={breadcrumbs}>
  <section class="topic container">
    <Breadcrumbs items={breadcrumbs} />
    <SectionHeading eyebrow="Guide topic" title={category} description={`Practical ${category.toLowerCase()} guides for planning a smoother London visit.`} />
    <p class="topic__count">{articles.length} {articles.length === 1 ? "guide" : "guides"} in this topic</p>
    <div class="grid grid--3">
      {articles.map((article) => (
        <ArticleCard label={article.data.category} title={article.data.title} description={article.data.description} href={`/articles/${article.id}/`} image={article.data.heroImage} imageAlt={article.data.heroImageAlt} tags={article.data.tags} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .topic { padding-block: var(--space-7); }
  .topic__count { margin: 0 0 var(--space-5); color: var(--muted); font-size: 0.9rem; font-weight: 750; }
</style>
