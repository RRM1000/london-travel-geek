---
// Live tube and rail status, and the closures planned for this weekend and
// next - Rob, 3 November 2026.
//
// Everything live is fetched in the reader's browser from TfL's open API (see
// src/lib/tfl-status.ts): the site is built once a day and a status baked in
// at build would be wrong within the hour. The static text is what stays true.
// LineStatus.astro, on transport guides, links here.
import ArticleLayout from "../layouts/ArticleLayout.astro";
import heroImage from "../assets/articles/london-underground/great-portland-street-platform.jpg";

const headings = [
  { depth: 2, slug: "right-now", text: "Right now" },
  { depth: 2, slug: "this-weekend", text: "This weekend" },
  { depth: 2, slug: "next-weekend", text: "Next weekend" },
  { depth: 2, slug: "reading-the-status", text: "Reading the status" },
  { depth: 2, slug: "planning-around-it", text: "Planning around a closure" },
];
---

<ArticleLayout
  title="London Tube Status: Live Lines and Weekend Closures"
  seoTitle="London Tube Status Today and Weekend Closures"
  description="Live status for every Tube line, the Elizabeth line, DLR, Overground and trams, plus the closures TfL has planned for this weekend and next."
  articleId="tube-status"
  category="Getting around London"
  tags={["transport", "tube", "getting around"]}
  publishedAt={new Date("2026-11-03")}
  heroImage={heroImage}
  heroImageAlt="A sub-surface line train waiting at the curved, brick-arched platform at Great Portland Street station"
  headings={headings}
>
  <div class="ts">
    <p>
      Live status for every Tube line, the Elizabeth line, the DLR, the six Overground lines and
      trams, straight from TfL, with the engineering work planned for the next two weekends below it.
      Weekend closures are announced weeks ahead, so check them while you plan.
    </p>

    <h2 id="right-now">Right now</h2>
    <div class="ts__panel ts__panel--now" data-live>
      <p class="ts__wait">Checking TfL…</p>
    </div>

    <h2 id="this-weekend">This weekend</h2>
    <p class="ts__dates" data-dates="0"></p>
    <div class="ts__panel" data-weekend="0">
      <p class="ts__wait">Checking TfL…</p>
    </div>

    <h2 id="next-weekend">Next weekend</h2>
    <p class="ts__dates" data-dates="1"></p>
    <div class="ts__panel" data-weekend="1">
      <p class="ts__wait">Checking TfL…</p>
    </div>

    <noscript>
      <p>This page needs JavaScript to load the status. <a href="https://tfl.gov.uk/tube-dlr-overground/status/">TfL's own status page</a> has the same information.</p>
    </noscript>

    <p class="ts__credit">Powered by TfL Open Data.</p>

    <h2 id="reading-the-status">Reading the status</h2>
    <ul>
      <li><strong>Part closure</strong> means no trains on one stretch of the line; the rest runs. TfL's note names the stretch and any replacement bus.</li>
      <li><strong>Planned closure</strong> is engineering work booked in advance; TfL's note gives the days and the stretch.</li>
      <li><strong>Severe or minor delays</strong> mean trains are running but late or less often. The note says why.</li>
      <li><strong>Reduced service</strong> means fewer trains than the timetable.</li>
      <li>The Waterloo &amp; City line runs Monday to Friday only, so it is not listed as closed at weekends here.</li>
    </ul>

    <h2 id="planning-around-it">Planning around a closure</h2>
    <p>
      <a href="https://tfl.gov.uk/plan-a-journey/">TfL's Journey Planner</a> routes around closures for the date and
      time you enter. Our <a href="/articles/getting-around-london-transport-guide/">guide to getting around London</a>
      covers the buses, river boats and trains that take over when a line is down, and
      <a href="/articles/how-to-use-the-london-underground/">how to use the Underground</a> covers the network itself.
      For what a journey costs, see <a href="/articles/london-public-transport-costs-and-fares/">London transport fares</a>.
      Flying in? Check the line your airport depends on: <a href="/articles/heathrow-airport-to-london/">Heathrow</a>,
      <a href="/articles/gatwick-airport-to-london/">Gatwick</a>, <a href="/articles/stansted-airport-to-london/">Stansted</a>,
      <a href="/articles/luton-airport-to-london/">Luton</a> or <a href="/articles/london-city-airport-to-london/">London City</a>.
    </p>
  </div>
</ArticleLayout>

<script>
  import { liveStatus, plannedStatus, ranked, disrupted, level, worst, weekends, shortDate, clock, COLOUR, type LineState } from "../lib/tfl-status";

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  // TfL starts most notes with the line's name in capitals ("CENTRAL LINE:",
  // "LONDON TRAMS:"), which the row already shows.
  const tidy = (reason: string, name: string) => {
    const m = reason.match(/^([^:.]{3,30}):\s+/);
    const first = name.toLowerCase().split(" ")[0];
    return m && (m[1] === m[1].toUpperCase() || m[1].toLowerCase().includes(first)) ? reason.slice(m[0].length) : reason;
  };

  function row(l: LineState, open: boolean) {
    const bad = l.severity !== 10;
    const head =
      `<span class="ts__bar" style="background:${COLOUR[l.id] ?? "var(--line-strong)"}"></span>` +
      `<span class="ts__name">${esc(l.name)}</span>` +
      `<span class="ts__pill" data-tone="${bad ? level(l.severity) : "green"}">${esc(bad ? l.label.charAt(0) + l.label.slice(1).toLowerCase() : "Good service")}</span>`;
    if (!bad || !l.reasons.length) return `<li class="ts__row"><div class="ts__head">${head}</div></li>`;
    const notes = l.reasons.map((r) => `<p class="ts__reason">${esc(tidy(r, l.name))}</p>`).join("");
    return `<li class="ts__row ts__row--bad"><details${open ? " open" : ""}><summary class="ts__head">${head}<span class="ts__chev" aria-hidden="true"></span></summary><div class="ts__notes">${notes}</div></details></li>`;
  }

  const summary = (tone: string, text: string, sub = "") =>
    `<div class="ts__summary" data-tone="${tone}"><span class="ts__dot" data-tone="${tone}"></span><div><strong>${text}</strong>${sub ? `<span>${sub}</span>` : ""}</div></div>`;

  function renderNow(panel: Element, lines: LineState[]) {
    const bad = disrupted(lines);
    const top = !bad.length
      ? summary("green", "Good service on every line", `Checked at ${clock()}`)
      : summary(level(worst(bad)), `${bad.length} ${bad.length === 1 ? "line" : "lines"} disrupted, ${lines.length - bad.length} running normally`, `Checked at ${clock()} · tap a line for TfL's note`);
    panel.innerHTML = top + `<ul class="ts__board">${ranked(lines).map((l) => row(l, false)).join("")}</ul>`;
  }

  function renderWeekend(panel: Element, lines: LineState[]) {
    const bad = disrupted(lines);
    panel.innerHTML = !bad.length
      ? summary("green", "No closures planned on any line")
      : summary(level(worst(bad)), `${bad.length} ${bad.length === 1 ? "line" : "lines"} affected`, "Every other line runs as normal") +
        `<ul class="ts__board">${bad.map((l) => row(l, true)).join("")}</ul>`;
  }

  const fail = (panel: Element | null) => {
    if (panel) panel.innerHTML = `<p class="ts__wait">See <a href="https://tfl.gov.uk/tube-dlr-overground/status/">TfL's status page</a> for the latest.</p>`;
  };

  const ends = weekends();
  ends.forEach((w, i) => {
    const el = document.querySelector(`[data-dates="${i}"]`);
    if (el) el.textContent = `${shortDate(w.from)} to ${shortDate(w.to)}`;
  });

  const nowPanel = document.querySelector("[data-live]")!;
  liveStatus()
    .then((lines) => {
      renderNow(nowPanel, lines);
      const ids = lines.map((l) => l.id);
      ends.forEach((w, i) => {
        const panel = document.querySelector(`[data-weekend="${i}"]`)!;
        plannedStatus(ids, w.from, w.to)
          .then((planned) => renderWeekend(panel, planned))
          .catch(() => fail(panel));
      });
    })
    .catch(() => {
      for (const sel of ["[data-live]", '[data-weekend="0"]', '[data-weekend="1"]']) fail(document.querySelector(sel));
    });

  // A page left open refreshes "Right now" every two minutes while it is in
  // view. Lines a reader has opened stay open.
  setInterval(() => {
    if (document.hidden) return;
    const open = new Set([...nowPanel.querySelectorAll("details[open] .ts__name")].map((n) => n.textContent));
    liveStatus()
      .then((lines) => {
        renderNow(nowPanel, lines);
        for (const d of nowPanel.querySelectorAll("details")) if (open.has(d.querySelector(".ts__name")?.textContent ?? "")) d.open = true;
      })
      .catch(() => {});
  }, 120_000);
</script>

<style>
  .ts__panel {
    min-height: 3rem;
  }

  .ts__panel--now {
    min-height: 20rem;
  }

  .ts__dates {
    margin-top: -0.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .ts :global(.ts__summary) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--card-radius);
    background: #e7f4ec;
    color: #174d2c;
  }

  .ts :global(.ts__summary[data-tone="amber"]) { background: #fcf0d9; color: #6b4300; }
  .ts :global(.ts__summary[data-tone="red"]) { background: #fbe5e5; color: #7d1a1a; }

  .ts :global(.ts__summary strong) {
    display: block;
    font-size: 1.05rem;
  }

  .ts :global(.ts__summary span:not(.ts__dot)) {
    display: block;
    font-size: 0.85rem;
    opacity: 0.85;
  }

  .ts :global(.ts__board) {
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--card-radius);
    background: var(--surface);
    list-style: none;
  }

  .ts :global(.ts__row) {
    margin: 0;
    padding: 0;
  }

  .ts :global(.ts__row + .ts__row) {
    border-top: 1px solid var(--line);
  }

  .ts :global(.ts__head) {
    display: grid;
    grid-template-columns: 0.45rem minmax(0, 1fr) auto 1rem;
    align-items: center;
    gap: 0.85rem;
    min-height: 2.9rem;
    padding-right: 0.9rem;
    list-style: none;
  }

  .ts :global(summary.ts__head) {
    cursor: pointer;
  }

  .ts :global(summary.ts__head::-webkit-details-marker) {
    display: none;
  }

  .ts :global(.ts__bar) {
    align-self: stretch;
  }

  .ts :global(.ts__name) {
    font-variation-settings: "wght" 700;
  }

  .ts :global(.ts__pill) {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: #e7f4ec;
    color: #1d6a3b;
    font-size: 0.8rem;
    font-variation-settings: "wght" 700;
    white-space: nowrap;
  }

  .ts :global(.ts__pill[data-tone="amber"]) { background: #fcf0d9; color: #7a4d00; }
  .ts :global(.ts__pill[data-tone="red"]) { background: #fbe5e5; color: #9b1c1c; }

  .ts :global(.ts__chev) {
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg) translateY(-25%);
    transition: transform var(--transition);
  }

  .ts :global(details[open] .ts__chev) {
    transform: rotate(225deg) translateY(-25%);
  }

  .ts :global(.ts__notes) {
    padding: 0 1rem 0.9rem 1.3rem;
  }

  .ts :global(.ts__reason) {
    margin: 0 0 0.5rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .ts :global(.ts__reason:last-child) {
    margin-bottom: 0;
  }

  .ts :global(.ts__dot) {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #1f8a4c;
  }

  .ts :global(.ts__dot[data-tone="amber"]) { background: #d98a00; }
  .ts :global(.ts__dot[data-tone="red"]) { background: #c62828; }

  .ts :global(.ts__wait) {
    color: var(--muted);
  }

  .ts__credit {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  @media (max-width: 30rem) {
    .ts :global(.ts__head) {
      gap: 0.6rem;
    }

    .ts :global(.ts__pill) {
      font-size: 0.74rem;
    }
  }
</style>
