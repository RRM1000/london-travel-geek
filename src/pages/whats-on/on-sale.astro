---
// Tickets that are not on sale yet, grouped by the day they go on sale.
//
// Built from the same listings as /whats-on/ and rebuilt with every daily
// refresh, so the dates roll forward on their own. A show is here only while
// none of its dates are on sale yet (see notYetOnSale in
// scripts/listings/export-site.mjs): a box office releasing a single held-back
// performance on the day is not a show "going on sale".
//
// ARTICLE LAYOUT, like /whats-on/ and /stay/, for the hero and the sidebar.
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import heroImage from "../../assets/articles/london-theatre-guide/tkts-booth-leicester-square.jpg";
import listingsJson from "../../data/listings.json";
import { itemHtml, firstRunDayOf, type Listings, type Row } from "../../lib/whats-on";
import "../../styles/whats-on.css";

const listings = listingsJson as unknown as Listings;
const buildDay = listings.generated;
const updated = new Date(`${buildDay}T12:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric", month: "long", year: "numeric", timeZone: "Europe/London",
});

// One row per show per release day: a run of forty nights going on sale
// together is one line here, with its first date, not forty.
const byShow = new Map<string, { r: Row; runs: number }>();
const shows: { r: Row; runs: number }[] = [];
for (const r of [...listings.rows].sort((a, b) => a[7].localeCompare(b[7]) || a[0].localeCompare(b[0]))) {
  if (!r[7] || r[7] < buildDay) continue; // today included: tickets released this morning are still news
  const key = `${r[7]}|${r[4]}|${r[2].toLowerCase()}`;
  const seen = byShow.get(key);
  if (seen) { seen.runs++; continue; }
  const entry = { r, runs: 1 };
  byShow.set(key, entry);
  shows.push(entry);
}

const ctx = { data: listings, today: buildDay, firstRunDay: firstRunDayOf(listings) };
const groups = new Map<string, typeof shows>();
for (const s of shows) {
  if (!groups.has(s.r[7])) groups.set(s.r[7], []);
  groups.get(s.r[7])!.push(s);
}

const dayParts = (iso: string) => {
  const d = new Date(`${iso}T12:00:00Z`);
  return {
    dow: d.toLocaleDateString("en-GB", { weekday: "long", timeZone: "UTC" }),
    date: d.toLocaleDateString("en-GB", { day: "numeric", month: "long", timeZone: "UTC" }),
  };
};

const html = [...groups].map(([day, list]) => {
  const { dow, date } = dayParts(day);
  return `<h3 class="wo__day" id="on-${day}"><span class="wo__dow">On sale ${dow}</span><span class="wo__date">${date} · ${list.length} ${list.length === 1 ? "show" : "shows"}</span></h3><ul class="wo__list">` +
    list.map(({ r, runs }) => {
      const row = itemHtml(r, { ...ctx, showDate: true, day: r[0] });
      // The badge would only repeat the heading.
      const clean = row.replace(/<span class="wo__badge wo__badge--soon">[^<]*<\/span>/, "");
      return runs > 1
        ? clean.replace('<div class="wo__meta">', `<div class="wo__meta"><span class="wo__badge wo__badge--dates">${runs} dates</span>`)
        : clean;
    }).join("") + "</ul>";
}).join("");

const headings = [
  { depth: 2, slug: "going-on-sale", text: "Going on sale" },
  { depth: 2, slug: "presales", text: "Presales, and what they are" },
];
---

<ArticleLayout
  title="Tickets Going On Sale in London"
  seoTitle="London Tickets Going On Sale This Week"
  description="Gigs, comedy, theatre and sport in London whose tickets aren't on sale yet, grouped by the day they're released, with presale dates where there are any."
  articleId="whats-on-on-sale"
  category="Things to do"
  tags={["what's on", "tickets", "on sale", "presales", "gigs", "theatre"]}
  publishedAt={new Date("2026-09-22")}
  updatedAt={new Date(`${buildDay}T12:00:00Z`)}
  heroImage={heroImage}
  heroImageAlt="The official London theatre ticket booth in Leicester Square, a clock tower on its roof and a lit canopy, with people queuing at the window"
  headings={headings}
>
  <div class="wo">
    <p class="wo-intro">
      Shows whose tickets aren't on sale yet, grouped by the day they're released. Each one shows its
      first performance; where there is a presale, its date is under the show.
      <em class="wo-intro__fresh">Updated {updated}. Everything already on sale is on the <a href="/whats-on/">What's On page</a>.</em>
    </p>

    <h2 id="going-on-sale">Going on sale</h2>
    {shows.length
      ? <div class="wo__results" set:html={html} />
      : <p class="wo__status">Nothing is waiting to go on sale in the listings right now. Everything we list is on the <a href="/whats-on/">What's On page</a>.</p>}

    <h2 id="presales">Presales, and what they are</h2>
    <p>
      A presale is a window before the general sale when tickets go to a smaller group: a venue's
      members, the artist's mailing list, or customers of a partner such as O2. The names under a show
      are the ones Ticketmaster lists for it, and the booking page says who each one is open to.
    </p>
  </div>
</ArticleLayout>

<script>
  // The page is rebuilt each morning, but a reader can open it later. Label
  // today's group as today, and hide any release day already past.
  import { londonDay } from "../../lib/whats-on";
  const today = londonDay(new Date());
  for (const h of document.querySelectorAll<HTMLElement>("h3.wo__day[id^='on-']")) {
    const day = h.id.slice(3);
    const list = h.nextElementSibling as HTMLElement | null;
    if (day < today) {
      h.hidden = true;
      if (list) list.hidden = true;
    } else if (day === today) {
      const dow = h.querySelector(".wo__dow");
      const date = h.querySelector(".wo__date");
      if (dow && date) {
        const weekday = new Date(`${day}T12:00:00Z`).toLocaleDateString("en-GB", { weekday: "long", timeZone: "UTC" });
        dow.textContent = "On sale today";
        date.textContent = `${weekday} ${date.textContent}`;
      }
    }
  }
</script>
