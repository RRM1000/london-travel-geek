---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import londonHero from "../assets/landing/westminster-golden-hour.jpg";
import oysterHero from "../assets/articles/oyster-card/oyster-visitor-card.jpg";
import areasHero from "../assets/articles/best-areas-to-visit-london/best-areas-to-visit-london.jpg";
import airportHero from "../assets/articles/heathrow-airport/heathrow-terminal-5.jpg";
import itineraryHero from "../assets/articles/three-days-in-london-itinerary/three-days-in-london-itinerary.jpg";
import eatHero from "../assets/articles/eat-in-london-guide/eat-in-london-guide.jpg";
import tubeHero from "../assets/articles/london-underground/piccadilly-circus-underground.jpg";
import simHero from "../assets/articles/travel-sim-esim-guide/travel-sim-esim-guide.jpg";
import plaquesHero from "../assets/articles/london-plaques-guide/london-plaques-guide.jpg";
import ArticleCard from "../components/ArticleCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import HomeWhatsOn from "../components/HomeWhatsOn.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { activeSite } from "../sites";
import { categoryHref } from "../lib/taxonomy";

const articles = (await getCollection("articles"))
  .filter((entry) => !entry.data.draft && entry.data.sites.includes(activeSite.id))
  // Same-day batches are normal here, and Array.sort is stable - so equal dates
  // used to fall back to getCollection's alphabetical-by-filename order, which
  // silently decided which guide got cut by the slice below. Break ties on
  // updatedAt, then title, so the order is deliberate rather than incidental.
  .sort(
    (a, b) =>
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() ||
      (b.data.updatedAt ?? b.data.publishedAt).valueOf() -
        (a.data.updatedAt ?? a.data.publishedAt).valueOf() ||
      a.data.title.localeCompare(b.data.title),
  );

const hasArticles = articles.length > 0;
const categoryGroups = Array.from(
  articles.reduce((groups, article) => {
    const category = article.data.category;
    const current = groups.get(category) ?? [];
    current.push(article);
    groups.set(category, current);
    return groups;
  }, new Map<string, typeof articles>()),
)
  .map(([label, entries]) => ({
    label,
    count: entries.length,
    latest: entries[0],
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

// The front page used to be one long chronological list, which meant what a
// visitor saw depended on publishing order rather than on what the site is
// actually good at. These rows are CURATED, not newest-first: picking by date
// put the same three guides in both "Things to do" and "Latest" on the same
// day, because the three newest guides all happened to be that category.
const FEATURED: Record<string, string[]> = {
  "Food and drink": [
    "best-street-food-london",
    "best-pizza-london",
    "best-indian-restaurants-london",
  ],
  "Things to do": [
    "immersive-experiences-london",
    "halloween-london",
    "best-canal-walks-london",
  ],
  "London areas": [
    "camden-area-guide",
    "south-bank-area-guide",
    "notting-hill-area-guide",
  ],
  // Added because the where-to-stay guides had no route onto this page at all.
  // Their only chance of appearing was the three-item Latest strip below, and
  // every one of them had been pushed out of it by newer guides within two
  // days of publishing. They moved to their own "Stay" category on 19
  // September 2026, when the nav item was pointed at the section page.
  "Stay": [
    "pod-hotels-london",
    "aparthotels-london",
    "day-rooms-london",
  ],
};

const featuredCategories = Object.entries(FEATURED)
  .map(([label, slugs]) => {
    const inCategory = articles.filter((a) => a.data.category === label);
    // Keep the hand-picked order. A slug that no longer exists is skipped
    // rather than rendering a hole, and the row backfills from the newest in
    // that category so it is never short.
    const picked = slugs
      .map((slug) => inCategory.find((a) => a.id === slug))
      .filter((a): a is (typeof inCategory)[number] => Boolean(a));
    const backfill = inCategory.filter((a) => !picked.includes(a));
    return {
      label,
      count: inCategory.length,
      items: [...picked, ...backfill].slice(0, 3),
    };
  })
  .filter((c) => c.items.length > 0);

// Anything already shown in a row above must not reappear down here.
const featuredIds = new Set(
  featuredCategories.flatMap((c) => c.items.map((a) => a.id)),
);
const latestArticles = articles.filter((a) => !featuredIds.has(a.id));
const heroTitle =
  activeSite.id === "london"
    ? "A Geek's Guide to London."
    : "Clear answers for smoother journeys.";

const topicTiles = [
  { label: "Eat & Drink", href: "/topics/food-and-drink/", image: eatHero },
  { label: "Areas", href: "/topics/london-areas/", image: areasHero },
  { label: "Itineraries", href: "/topics/london-itineraries/", image: itineraryHero },
  { label: "Blue plaques map", href: "/plaques/", image: plaquesHero },
  { label: "Transport", href: "/topics/getting-around-london/", image: tubeHero },
  { label: "SIM & eSIM", href: "/topics/travel-sim-cards/", image: simHero },
];

// The hero cross-fades through a few guides, each with its own photo, line and
// button, so the front page shows what the site covers rather than one view of
// Westminster. The first slide is the site itself and keeps the h1; the others
// are hand-written here, because article titles are too long for a hero. Keep
// the lines free of prices and dates: nobody re-checks a hero.
// Images, alt text and credits come from each guide's own frontmatter.
const HERO_GUIDES = [
  {
    slug: "best-views-london",
    title: "The best views in London.",
    text: "A free City viewpoint higher than The Shard's paid gallery, and a keyhole in Richmond Park aimed at St Paul's ten miles away.",
    cta: "Find the views",
  },
  {
    slug: "notting-hill-colourful-houses",
    title: "Notting Hill's colourful houses.",
    text: "A walking route through the Notting Hill streets that actually have the colour, and where the cherry blossom is in spring.",
    cta: "Walk the colourful streets",
  },
  {
    slug: "best-street-food-london",
    title: "Street food markets in London.",
    text: "Every street food market and food hall in London compared, with the days each one actually trades.",
    cta: "Compare the markets",
  },
  {
    slug: "unusual-restaurants-london",
    title: "Unusual restaurants in London.",
    text: "A Mongolian yurt, a Victorian lavatory and a former school bike shed: London restaurants where the room is the story.",
    cta: "See the strange rooms",
  },
  {
    slug: "london-walks-along-the-thames",
    title: "Walks along the Thames.",
    text: "The South Bank past Tate Modern, Wapping's riverside pubs and the quiet Rotherhithe stretch into Greenwich.",
    cta: "Pick a river walk",
  },
  {
    slug: "theme-parks-near-london",
    title: "Theme parks near London.",
    text: "The train from London, the cheapest ticket and who each park suits, for every theme park within a day trip.",
    cta: "Compare the parks",
  },
  {
    slug: "windsor-day-trip",
    title: "A day trip to Windsor.",
    text: "The trains from Paddington and Waterloo, the castle, and the days it is closed.",
    cta: "Plan the day trip",
  },
];

const allGuides = { href: "/guides/", label: "All guides" };
const heroSlides = [
  {
    label: "London",
    image: londonHero,
    alt: "The Houses of Parliament, Elizabeth Tower and Westminster Bridge lit by low golden sunlight from across the Thames",
    // Measured against the source frame: Elizabeth Tower's spire tip is at 7.8%
    // of the height, and the tower 82-92% across, so it survives a phone crop.
    position: "88% 8%",
    eyebrow: activeSite.accentLabel,
    title: heroTitle,
    text: "We do the research so you can focus on having fun.",
    primary: { href: "/guides/", label: "Explore all guides" },
    secondary: { href: "/articles/london-itineraries-by-days-and-interests/", label: "Plan your trip" },
    caption: "The Houses of Parliament and Westminster Bridge from the Thames",
  },
  ...HERO_GUIDES.flatMap((g) => {
    const a = articles.find((x) => x.id === g.slug);
    if (!a?.data.heroImage) return [];
    const credit = a.data.heroImageCredit
      ? `Photo: ${a.data.heroImageCredit}${a.data.heroImageLicense ? ` (${a.data.heroImageLicense})` : ""}`
      : "";
    return [{
      label: g.title,
      image: a.data.heroImage,
      alt: a.data.heroImageAlt ?? "",
      position: undefined as string | undefined,
      eyebrow: a.data.category,
      title: g.title,
      text: g.text,
      primary: { href: `/articles/${a.id}/`, label: g.cta },
      secondary: allGuides,
      caption: credit,
    }];
  }),
];
---

<BaseLayout>
  <!-- ============================================================ hero -->
  <section class="hero" data-hero>
    <div class="hero__bg">
      {heroSlides.map((slide, i) => (
        <div class:list={["hero__slide", { "is-active": i === 0 }]}>
          <Image
            src={slide.image}
            alt={i === 0 ? slide.alt : ""}
            widths={[800, 1200, 1600, 2000, 2560]}
            sizes="(max-width: 40rem) 800px, (max-width: 64rem) 1200px, 100vw"
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : undefined}
            style={slide.position ? `object-position: ${slide.position}` : undefined}
          />
        </div>
      ))}
      <div class="hero__overlay" />
    </div>
    <div class="container hero__content">
      <div class="hero__stack">
        {heroSlides.map((slide, i) => (
          <div class:list={["hero__copy", { "is-active": i === 0 }]} data-hero-copy>
            <p class="eyebrow eyebrow--on-dark">{slide.eyebrow}</p>
            {i === 0 ? <h1>{slide.title}</h1> : <p class="hero__title">{slide.title}</p>}
            <p class="hero__subtitle">{slide.text}</p>
            <div class="hero__actions">
              <a class="button" href={slide.primary.href}>{slide.primary.label}</a>
              <a class="button button--ghost-dark" href={slide.secondary.href}>{slide.secondary.label}</a>
            </div>
          </div>
        ))}
      </div>
      <div class="hero__bar">
        {heroSlides.length > 1 && (
          <ol class="hero__steps" style={`--steps: ${heroSlides.length}`}>
            {heroSlides.map((slide, i) => (
              <li>
                <button
                  type="button"
                  class:list={["hero__step", { "is-active": i === 0 }]}
                  data-step={i}
                  aria-label={`Show ${slide.label}`}
                >
                  <span class="hero__fill"></span>
                </button>
              </li>
            ))}
          </ol>
        )}
        <p class="hero__caption" data-hero-caption>{heroSlides[0].caption}</p>
        <template data-hero-captions>
          {heroSlides.map((slide) => <span>{slide.caption}</span>)}
        </template>
      </div>
    </div>
  </section>

  <!-- ================================================== topic tiles -->
  <section class="topics" aria-label="Browse by topic">
    <div class="container">
      <ul class="topics__rail">
        {topicTiles.map((tile) => (
          <li>
            <a class="topic-tile" href={tile.href}>
              <Image
                src={tile.image}
                alt=""
                widths={[360, 540]}
                sizes="(max-width: 48rem) 70vw, 15rem"
                loading="lazy"
              />
              <span class="topic-tile__label">{tile.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ==================================================== start here -->
  <section class="section start-here">
    <div class="container">
      <SectionHeading
        eyebrow="Start here"
        title="Essential London travel guides"
        description="First time in London? Start with our most popular guides for transport, neighbourhoods, and itineraries."
      />
      <div class="start-grid">
        <a href="/articles/oyster-card-guide-london/" class="start-card start-card--feature">
          <div class="start-card__image">
            <Image
              src={oysterHero}
              alt="Yellow Oyster visitor card reader"
              widths={[720, 1080]}
              sizes="(max-width: 54rem) 100vw, 50vw"
              loading="lazy"
            />
          </div>
          <div class="start-card__body">
            <p class="eyebrow">Fares &amp; tickets</p>
            <h3>Which Transport Ticket Do I Need?</h3>
            <p>Oyster cards vs contactless payment &amp; daily capping explained.</p>
            <span class="start-card__link">Read guide &rarr;</span>
          </div>
        </a>
        <a href="/articles/best-areas-to-visit-london/" class="start-card">
          <div class="start-card__image">
            <Image
              src={areasHero}
              alt="London skyline and Tower Bridge"
              widths={[480, 720]}
              sizes="(max-width: 54rem) 100vw, 25vw"
              loading="lazy"
            />
          </div>
          <div class="start-card__body">
            <p class="eyebrow">Neighbourhoods</p>
            <h3>Best Areas to Visit in London</h3>
            <p>The top neighbourhoods compared for first-time visitors.</p>
            <span class="start-card__link">Read guide &rarr;</span>
          </div>
        </a>
        <a href="/tags/airport-transfers/" class="start-card">
          <div class="start-card__image">
            <Image
              src={airportHero}
              alt="Heathrow Airport terminal"
              widths={[480, 720]}
              sizes="(max-width: 54rem) 100vw, 25vw"
              loading="lazy"
            />
          </div>
          <div class="start-card__body">
            <p class="eyebrow">Airports</p>
            <h3>Airport Transfer Cheat Sheets</h3>
            <p>The fastest and cheapest routes from Heathrow, Gatwick &amp; Stansted.</p>
            <span class="start-card__link">Read guide &rarr;</span>
          </div>
        </a>
        <a href="/articles/london-itineraries-by-days-and-interests/" class="start-card">
          <div class="start-card__image">
            <Image
              src={itineraryHero}
              alt="London sights and skyline"
              widths={[480, 720]}
              sizes="(max-width: 54rem) 100vw, 25vw"
              loading="lazy"
            />
          </div>
          <div class="start-card__body">
            <p class="eyebrow">Itineraries</p>
            <h3>How Many Days Do You Need in London?</h3>
            <p>How long the city really takes, which plan to follow, and what to book before you fly.</p>
            <span class="start-card__link">Read guide &rarr;</span>
          </div>
        </a>
        <a href="/articles/travel-sim-esim-guide/" class="start-card">
          <div class="start-card__image">
            <Image
              src={simHero}
              alt="SIM cards in three sizes"
              widths={[480, 720]}
              sizes="(max-width: 54rem) 100vw, 25vw"
              loading="lazy"
            />
          </div>
          <div class="start-card__body">
            <p class="eyebrow">Staying connected</p>
            <h3>Travel SIM &amp; eSIM Guide</h3>
            <p>Which data plan to buy before you fly, and what to avoid at the airport.</p>
            <span class="start-card__link">Read guide &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ================================================== what's on -->
  <HomeWhatsOn />

  <!-- ================================================ category rows -->
  {featuredCategories.map((category) => (
    <section class="section category-row" aria-label={category.label}>
      <div class="container">
        <SectionHeading
          eyebrow="Browse by topic"
          title={category.label}
          description={`${category.count} guides, kept current and honest about the caveats.`}
        />
        <div class="grid grid--3">
          {category.items.map((article) => (
            <ArticleCard
              label={article.data.category}
              title={article.data.title}
              description={article.data.description}
              href={`/articles/${article.id}/`}
              image={article.data.heroImage}
              imageAlt={article.data.heroImageAlt}
              tags={article.data.tags}
            />
          ))}
        </div>
        <p class="section__more">
          <a href={categoryHref(category.label)}>
            All {category.count} {category.label.toLowerCase()} guides<span aria-hidden="true"> →</span>
          </a>
        </p>
      </div>
    </section>
  ))}

  <!-- ======================================================== latest -->
  <section id="articles" class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Plan with confidence"
        title="Latest London guides"
        description="The three most recent guides. Everything else is browsable by topic above."
      />
      <div class="grid grid--3">
        {hasArticles ? (
          latestArticles.slice(0, 3).map((article) => (
            <ArticleCard
              label={article.data.category}
              title={article.data.title}
              description={article.data.description}
              href={`/articles/${article.id}/`}
              image={article.data.heroImage}
              imageAlt={article.data.heroImageAlt}
              tags={article.data.tags}
            />
          ))
        ) : (
          Array.from({ length: 3 }).map(() => <ArticleCard empty />)
        )}
      </div>
      <p class="section__more">
        <a href="/guides/">Browse all guides<span aria-hidden="true"> →</span></a>
      </p>
    </div>
  </section>

  <!-- =========================================================== GYG -->
  <section class="gyg-home section" aria-label="London activities">
    <div class="container">
      <SectionHeading
        eyebrow="Curated experiences"
        title="Top London Tours & Sights"
        description="Book skip-the-line tickets and top-rated tours directly through our trusted travel partners."
      />
      <div
        data-gyg-widget="auto"
        data-gyg-partner-id="WWP7I0R"
      ></div>
    </div>
  </section>

  <!-- ========================================================= about -->
  <section id="about" class="section about">
    <div class="container about__inner">
      <div class="about__header">
        <p class="eyebrow eyebrow--on-dark">About London Travel Geek</p>
        <h2>Independent London guides, checked against the source.</h2>
      </div>
      <div class="about__content">
        <p>
          Fares, opening hours, prices and booking rules come from the operators' own pages, and every guide shows when it was last updated. Ranked guides count how many independent sources name a place rather than giving our opinion: <a href="/how-we-rank/">how we rank</a>.
        </p>
        <p>
          <a href="/whats-on/">What's On</a> lists gigs, comedy, theatre and exhibitions, refreshed every morning from venues' box offices, Ticketmaster and DICE.
        </p>
        <p>
          Links marked "ad" earn us a commission when you book; rankings are never paid for. Questions and corrections: <a href="mailto:robert@promptlybuilt.co.uk">robert@promptlybuilt.co.uk</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ==================================================== categories -->
</BaseLayout>

<script>
  // The home hero: one guide at a time, photo and text together, with a bar of
  // one segment per slide. The active segment fills while its slide shows;
  // clicking a segment jumps to it. Readers who ask for less motion get the
  // first slide, still, and can step through with the bar.
  const SHOW_MS = 7000;
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const slides = hero ? [...hero.querySelectorAll<HTMLElement>(".hero__slide")] : [];
  const copies = hero ? [...hero.querySelectorAll<HTMLElement>("[data-hero-copy]")] : [];
  const steps = hero ? [...hero.querySelectorAll<HTMLButtonElement>(".hero__step")] : [];
  const caption = hero?.querySelector<HTMLElement>("[data-hero-caption]");
  const captions = [...(hero?.querySelector<HTMLTemplateElement>("[data-hero-captions]")?.content.children ?? [])].map(
    (el) => el.textContent ?? "",
  );
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let current = 0;
  let timer: number | undefined;

  function show(n: number) {
    const prev = slides[current];
    current = (n + slides.length) % slides.length;
    const next = slides[current];
    if (prev !== next) {
      // The outgoing photo keeps zooming while it fades, then lets go.
      prev.classList.remove("is-active");
      prev.classList.add("was-active");
      setTimeout(() => prev.classList.remove("was-active"), 1500);
      next.classList.add("is-active");
    }
    copies.forEach((copy, i) => copy.classList.toggle("is-active", i === current));
    steps.forEach((step, i) => {
      step.classList.toggle("is-done", i < current);
      step.classList.remove("is-active");
      step.setAttribute("aria-current", String(i === current));
    });
    void steps[current]?.offsetWidth; // restart the fill animation
    steps[current]?.classList.add("is-active");
    if (caption) caption.textContent = captions[current] ?? "";
    schedule();
  }

  function schedule() {
    clearTimeout(timer);
    if (still || slides.length < 2) return;
    timer = window.setTimeout(() => (document.hidden ? schedule() : show(current + 1)), SHOW_MS);
  }

  if (slides.length > 1) {
    document.documentElement.style.setProperty("--hero-show", `${SHOW_MS}ms`);
    steps.forEach((step) => step.addEventListener("click", () => show(Number(step.dataset.step))));
    schedule();
  }
</script>

<style>
  .section__more {
    margin-block-start: var(--space-4);
  }

  .section__more a {
    font-weight: 650;
    text-decoration: none;
    color: var(--accent);
  }

  .section__more a:hover,
  .section__more a:focus-visible {
    text-decoration: underline;
  }

  /* -------------------------------------------------------------- hero --- */
  /* A few guides in turn: each photo fades in and slowly zooms, its line and
     button change with it, and a bar of one segment per slide runs along the
     bottom. The script below the markup moves .is-active along. */
  .hero {
    position: relative;
    width: 100%;
    background: var(--chrome);
    color: #ffffff;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.4s ease;
  }

  .hero__slide.is-active {
    opacity: 1;
  }

  .hero__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__slide.is-active :global(img),
  .hero__slide.was-active :global(img) {
    animation: hero-zoom calc(var(--hero-show, 7000ms) + 1500ms) linear forwards;
  }

  @keyframes hero-zoom {
    from { transform: scale(1); }
    to { transform: scale(1.08); }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(
        180deg,
        rgb(14 27 44 / 0.55) 0%,
        rgb(14 27 44 / 0.35) 40%,
        rgb(14 27 44 / 0.92) 100%
      );
  }

  .hero__content {
    position: relative;
    z-index: 3;
    padding-block: clamp(4.5rem, 11vw, 9rem) var(--space-4);
  }

  /* Every slide's text sits in the same grid cell, so the hero is as tall as
     the longest one and nothing jumps when the text changes. */
  .hero__stack {
    display: grid;
  }

  .hero__copy {
    grid-area: 1 / 1;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    max-width: 46rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease, visibility 0s linear 0.6s;
  }

  .hero__copy.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.8s ease 0.4s, visibility 0s;
  }

  .hero__copy h1,
  .hero__title {
    margin: 0;
    color: #ffffff;
    font-family: var(--display);
    font-variation-settings: "opsz" 72, "wght" 560;
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    letter-spacing: -0.025em;
    line-height: 1.02;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }

  .hero__subtitle {
    max-width: 38rem;
    color: rgb(255 255 255 / 0.92);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.9rem;
