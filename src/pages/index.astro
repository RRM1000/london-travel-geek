---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import londonHero from "../assets/landing/westminster-golden-hour.jpg";
import oysterHero from "../assets/articles/oyster-card/oyster-visitor-card.jpg";
import areasHero from "../assets/articles/best-areas-to-visit-london/best-areas-to-visit-london.jpg";
import airportHero from "../assets/articles/heathrow-airport/heathrow-terminal-5.jpg";
import itineraryHero from "../assets/articles/three-days-in-london-itinerary/three-days-in-london-itinerary.jpg";
import eatHero from "../assets/articles/eat-in-london-guide/eat-in-london-guide.jpg";
import tubeHero from "../assets/articles/london-underground/piccadilly-circus-underground.jpg";
import simHero from "../assets/articles/travel-sim-esim-guide/travel-sim-esim-guide.jpg";
import plaquesHero from "../assets/articles/london-plaques-guide/london-plaques-guide.jpg";
import ArticleCard from "../components/ArticleCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { activeSite } from "../sites";
import { categoryHref } from "../lib/taxonomy";

const articles = (await getCollection("articles"))
  .filter((entry) => !entry.data.draft && entry.data.sites.includes(activeSite.id))
  // Same-day batches are normal here, and Array.sort is stable - so equal dates
  // used to fall back to getCollection's alphabetical-by-filename order, which
  // silently decided which guide got cut by the slice below. Break ties on
  // updatedAt, then title, so the order is deliberate rather than incidental.
  .sort(
    (a, b) =>
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() ||
      (b.data.updatedAt ?? b.data.publishedAt).valueOf() -
        (a.data.updatedAt ?? a.data.publishedAt).valueOf() ||
      a.data.title.localeCompare(b.data.title),
  );

const hasArticles = articles.length > 0;
const categoryGroups = Array.from(
  articles.reduce((groups, article) => {
    const category = article.data.category;
    const current = groups.get(category) ?? [];
    current.push(article);
    groups.set(category, current);
    return groups;
  }, new Map<string, typeof articles>()),
)
  .map(([label, entries]) => ({
    label,
    count: entries.length,
    latest: entries[0],
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

// The front page used to be one long chronological list, which meant what a
// visitor saw depended on publishing order rather than on what the site is
// actually good at. These rows are CURATED, not newest-first: picking by date
// put the same three guides in both "Things to do" and "Latest" on the same
// day, because the three newest guides all happened to be that category.
const FEATURED: Record<string, string[]> = {
  "Food and drink": [
    "best-street-food-london",
    "best-pizza-london",
    "best-indian-restaurants-london",
  ],
  "Things to do": [
    "immersive-experiences-london",
    "halloween-london",
    "best-canal-walks-london",
  ],
  "London areas": [
    "camden-area-guide",
    "south-bank-area-guide",
    "peckham-area-guide",
  ],
};

const featuredCategories = Object.entries(FEATURED)
  .map(([label, slugs]) => {
    const inCategory = articles.filter((a) => a.data.category === label);
    // Keep the hand-picked order. A slug that no longer exists is skipped
    // rather than rendering a hole, and the row backfills from the newest in
    // that category so it is never short.
    const picked = slugs
      .map((slug) => inCategory.find((a) => a.id === slug))
      .filter((a): a is (typeof inCategory)[number] => Boolean(a));
    const backfill = inCategory.filter((a) => !picked.includes(a));
    return {
      label,
      count: inCategory.length,
      items: [...picked, ...backfill].slice(0, 3),
    };
  })
  .filter((c) => c.items.length > 0);

// Anything already shown in a row above must not reappear down here.
const featuredIds = new Set(
  featuredCategories.flatMap((c) => c.items.map((a) => a.id)),
);
const latestArticles = articles.filter((a) => !featuredIds.has(a.id));
const heroTitle =
  activeSite.id === "london"
    ? "A Geek's Guide to London."
    : "Clear answers for smoother journeys.";

const topicTiles = [
  { label: "Eat & Drink", href: "/topics/food-and-drink/", image: eatHero },
  { label: "Areas", href: "/topics/london-areas/", image: areasHero },
  { label: "Itineraries", href: "/topics/london-itineraries/", image: itineraryHero },
  { label: "Blue plaques map", href: "/plaques/", image: plaquesHero },
  { label: "Transport", href: "/topics/getting-around-london/", image: tubeHero },
  { label: "SIM & eSIM", href: "/topics/travel-sim-cards/", image: simHero },
];
---

<BaseLayout>
  <!-- ============================================================ hero -->
  <section class="hero">
    <div class="hero__bg">
      <Image
        src={londonHero}
        alt="The Houses of Parliament, Elizabeth Tower and Westminster Bridge lit by low golden sunlight from across the Thames"
        widths={[720, 1080, 1440, 1920, 2560]}
        sizes="100vw"
        loading="eager"
      />
      <div class="hero__overlay" />
    </div>
    <div class="container hero__content">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--on-dark">{activeSite.accentLabel}</p>
        <h1>{heroTitle}</h1>
        <p class="hero__subtitle">
          We do the research so you can focus on having fun.
        </p>
        <div class="hero__actions">
          <a class="button" href="/guides/">Explore all guides</a>
          <a class="button button--ghost-dark" href="/articles/london-itineraries-by-days-and-interests/">Plan your trip</a>
        </div>
      </div>
      <div class="hero__caption">
        The Houses of Parliament and Westminster Bridge from the Thames
      </div>
    </div>
  </section>

  <!-- ================================================== topic tiles -->
  <section class="topics" aria-label="Browse by topic">
    <div class="container">
      <ul class="topics__rail">
        {topicTiles.map((tile) => (
          <li>
            <a class="topic-tile" href={tile.href}>
              <Image
                src={tile.image}
                alt=""
                widths={[360, 540]}
                sizes="(max-width: 48rem) 70vw, 15rem"
                loading="lazy"
              />
              <span class="topic-tile__label">{tile.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ==================================================== start here -->
  <section class="section start-here">
    <div class="container">
      <SectionHeading
        eyebrow="Start here"
        title="Essential London travel guides"
        description="First time in London? Start with our most popular guides for transport, neighbourhoods, and itineraries."
      />
      <div class="start-grid">
        <a href="/articles/oyster-card-guide-london/" class="start-card start-card--feature">
          <div class="start-card__image">
            <Image
              src={oysterHero}
              alt="Yellow Oyster visitor card reader"
              widths={[720, 1080]}
              sizes="(max-width: 54rem) 100vw, 50vw"
              loading="lazy"
            />
          </div>
          <div class="start-card__body">
            <p class="eyebrow">Fares &amp; tickets</p>
            <h3>Which Transport Ticket Do I Need?</h3>
            <p>Oyster cards vs contactless payment &amp; daily capping explained.</p>
            <span class="start-card__link">Read guide &rarr;</span>
          </div>
        </a>
        <a href="/articles/best-areas-to-visit-london/" class="start-card">
          <div class="start-card__image">
            <Image
              src={areasHero}
              alt="London skyline and Tower Bridge"
              widths={[480, 720]}
              sizes="(max-width: 54rem) 100vw, 25vw"
              loading="lazy"
            />
          </div>
          <div class="start-card__body">
            <p class="eyebrow">Neighbourhoods</p>
            <h3>Best Areas to Visit in London</h3>
            <p>The top neighbourhoods compared for first-time visitors.</p>
            <span class="start-card__link">Read guide &rarr;</span>
          </div>
        </a>
        <a href="/tags/airport-transfers/" class="start-card">
          <div class="start-card__image">
            <Image
              src={airportHero}
              alt="Heathrow Airport terminal"
              widths={[480, 720]}
              sizes="(max-width: 54rem) 100vw, 25vw"
              loading="lazy"
            />
          </div>
          <div class="start-card__body">
            <p class="eyebrow">Airports</p>
            <h3>Airport Transfer Cheat Sheets</h3>
            <p>The fastest and cheapest routes from Heathrow, Gatwick &amp; Stansted.</p>
            <span class="start-card__link">Read guide &rarr;</span>
          </div>
        </a>
        <a href="/articles/london-itineraries-by-days-and-interests/" class="start-card">
          <div class="start-card__image">
            <Image
              src={itineraryHero}
              alt="London sights and skyline"
              widths={[480, 720]}
              sizes="(max-width: 54rem) 100vw, 25vw"
              loading="lazy"
            />
          </div>
          <div class="start-card__body">
            <p class="eyebrow">Itineraries</p>
            <h3>3-Day &amp; 5-Day London Itineraries</h3>
            <p>Optimised route plans to see the best sights without rushing.</p>
            <span class="start-card__link">Read guide &rarr;</span>
          </div>
        </a>
        <a href="/articles/travel-sim-esim-guide/" class="start-card">
          <div class="start-card__image">
            <Image
              src={simHero}
              alt="SIM cards in three sizes"
              widths={[480, 720]}
              sizes="(max-width: 54rem) 100vw, 25vw"
              loading="lazy"
            />
          </div>
          <div class="start-card__body">
            <p class="eyebrow">Staying connected</p>
            <h3>Travel SIM &amp; eSIM Guide</h3>
            <p>Which data plan to buy before you fly, and what to avoid at the airport.</p>
            <span class="start-card__link">Read guide &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ================================================ category rows -->
  {featuredCategories.map((category) => (
    <section class="section category-row" aria-label={category.label}>
      <div class="container">
        <SectionHeading
          eyebrow="Browse by topic"
          title={category.label}
          description={`${category.count} guides, kept current and honest about the caveats.`}
        />
        <div class="grid grid--3">
          {category.items.map((article) => (
            <ArticleCard
              label={article.data.category}
              title={article.data.title}
              description={article.data.description}
              href={`/articles/${article.id}/`}
              image={article.data.heroImage}
              imageAlt={article.data.heroImageAlt}
              tags={article.data.tags}
            />
          ))}
        </div>
        <p class="section__more">
          <a href={categoryHref(category.label)}>
            All {category.count} {category.label.toLowerCase()} guides<span aria-hidden="true"> →</span>
          </a>
        </p>
      </div>
    </section>
  ))}

  <!-- ======================================================== latest -->
  <section id="articles" class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Plan with confidence"
        title="Latest London guides"
        description="The three most recent guides. Everything else is browsable by topic above."
      />
      <div class="grid grid--3">
        {hasArticles ? (
          latestArticles.slice(0, 3).map((article) => (
            <ArticleCard
              label={article.data.category}
              title={article.data.title}
              description={article.data.description}
              href={`/articles/${article.id}/`}
              image={article.data.heroImage}
              imageAlt={article.data.heroImageAlt}
              tags={article.data.tags}
            />
          ))
        ) : (
          Array.from({ length: 3 }).map(() => <ArticleCard empty />)
        )}
      </div>
      <p class="section__more">
        <a href="/guides/">Browse all guides<span aria-hidden="true"> →</span></a>
      </p>
    </div>
  </section>

  <!-- =========================================================== GYG -->
  <section class="gyg-home section" aria-label="London activities">
    <div class="container">
      <SectionHeading
        eyebrow="Curated experiences"
        title="Top London Tours & Sights"
        description="Book skip-the-line tickets and top-rated tours directly through our trusted travel partners."
      />
      <div
        data-gyg-widget="auto"
        data-gyg-partner-id="WWP7I0R"
      ></div>
    </div>
  </section>

  <!-- ========================================================= about -->
  <section id="about" class="section about">
    <div class="container about__inner">
      <div class="about__header">
        <p class="eyebrow eyebrow--on-dark">About London Travel Geek</p>
        <h2>Independent, no-nonsense London advice.</h2>
      </div>
      <div class="about__content">
        <p>
          Navigating London shouldn't feel like a maths problem. We dig past the marketing fluff, test every route, and break down complex TfL fares, airport links, and neighbourhood choices into clear, practical advice.
        </p>
        <p>
          No sponsored rankings, no confusing jargon &mdash; just honest guidance to save you time and money.
        </p>
      </div>
    </div>
  </section>

  <!-- ==================================================== categories -->
</BaseLayout>

<style>
  .section__more {
    margin-block-start: var(--space-4);
  }

  .section__more a {
    font-weight: 650;
    text-decoration: none;
    color: var(--accent);
  }

  .section__more a:hover,
  .section__more a:focus-visible {
    text-decoration: underline;
  }

  /* -------------------------------------------------------------- hero --- */
  .hero {
    position: relative;
    width: 100%;
    background: var(--chrome);
    color: #ffffff;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Both values are measured against the source frame, not guessed.
       Vertical: Elizabeth Tower's spire tip sits at 7.8% of image height.
       A wide desktop hero is shallow, so it crops hard vertically - at 45%
       the crop began around 18% and beheaded the tower. 8% keeps the tip
       (plus a little sky) in shot across the whole desktop range. The lost
       foreground water is no loss: the bottom sits under the dark gradient.
       Horizontal: only bites on narrow screens, where the crop is severe -
       88% pulls it right so the tower (~82-92% across) survives on a phone.
       Portrait viewports have no vertical crop at all, so the 8% is
       desktop-only in effect. */
    object-position: 88% 8%;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(
        180deg,
        rgb(14 27 44 / 0.55) 0%,
        rgb(14 27 44 / 0.35) 40%,
        rgb(14 27 44 / 0.92) 100%
      );
  }

  .hero__content {
    position: relative;
    z-index: 3;
    padding-block: clamp(4.5rem, 11vw, 9rem) clamp(3rem, 6vw, 4.5rem);
  }

  .hero__copy {
    display: grid;
    gap: var(--space-3);
    max-width: 46rem;
  }

  .hero__copy h1 {
    color: #ffffff;
    font-size: clamp(2.9rem, 8vw, 6rem);
    line-height: 1.02;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }

  .hero__subtitle {
    max-width: 38rem;
    color: rgb(255 255 255 / 0.92);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.9rem;
  }

  .hero__caption {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    color: rgb(255 255 255 / 0.55);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  /* ------------------------------------------------------- topic tiles --- */
  .topics {
    background: var(--chrome);
    padding-block: 0 var(--space-6);
  }

  .topics__rail {
    display: grid;
    /* Was a hardcoded repeat(5). Adding a sixth tile stranded one on its own
       row - auto-fit keeps the rail to a single line and adapts if the tile
       count changes again. */
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: var(--space-3);
  }

  .topic-tile {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
    aspect-ratio: 4 / 5;
    text-decoration: none;
    box-shadow: 0 10px 30px rgb(5 12 22 / 0.35);
    transition: translate var(--transition), box-shadow var(--transition);
  }

  .topic-tile:hover {
    translate: 0 -4px;
    box-shadow: 0 18px 44px rgb(5 12 22 / 0.5);
  }

  .topic-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--transition-slow);
  }

  .topic-tile:hover :global(img) {
    scale: 1.06;
  }

  .topic-tile__label {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.4rem 0.95rem 0.85rem;
    background: linear-gradient(to top, rgb(5 12 22 / 0.9), transparent);
    color: #ffffff;
    font-size: 1.02rem;
    font-variation-settings: "wght" 700;
    letter-spacing: 0.02em;
  }

  /* -------------------------------------------------------- start here --- */
  .start-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto auto;
    gap: var(--space-4);
  }

  .start-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--card-radius);
    background: var(--surface);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: translate var(--transition), box-shadow var(--transition), border-color var(--transition);
  }

  .start-card--feature {
    grid-row: span 2;
    grid-column: 1;
  }

  .start-card:not(.start-card--feature) {
    flex-direction: column;
    grid-column: span 1;
  }

  .start-card:hover {
    translate: 0 -4px;
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    box-shadow: var(--shadow-md);
  }

  .start-card__image {
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--chrome);
  }

  .start-card--feature .start-card__image {
    aspect-ratio: 16 / 10;
    /* The feature spans both rows, so it is taller than its own content. That
       slack used to open as dead white space between the description and the
       link. Let the photograph take it instead. */
    flex: 1 1 auto;
    min-height: 0;
  }

  .start-card--feature .start-card__image :global(img) {
    height: 100%;
    object-fit: cover;
  }

  .start-card:not(.start-card--feature) .start-card__image {
    width: 100%;
    aspect-ratio: 16 / 10;
  }

  .start-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--transition-slow);
  }

  .start-card:hover .start-card__image :global(img) {
    scale: 1.05;
  }

  .start-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.35rem;
  }

  .start-card--feature .start-card__body {
    padding: 1.5rem 1.6rem;
  }

  .start-card__body h3 {
    color: var(--ink);
    line-height: 1.22;
  }

  .start-card--feature h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
  }

  .start-card__body p:not(.eyebrow) {
    flex: 1;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .start-card__link {
    margin-top: 0.7rem;
    color: var(--accent);
    font-size: 0.9rem;
    font-variation-settings: "wght" 700;
  }

  .start-card:hover .start-card__link {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* --------------------------------------------------------------- GYG --- */
  .gyg-home {
    padding-bottom: var(--space-5);
  }

  .gyg-home :global(iframe) {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 0;
  }

  /* ------------------------------------------------------------- about --- */
  .about {
    background: var(--chrome);
    color: var(--chrome-text);
  }

  .about__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }

  .about__header {
    display: grid;
    gap: 0.6rem;
  }

  .about__header h2 {
    color: #ffffff;
  }

  .about__content {
    display: grid;
    gap: 1rem;
    padding-top: 0.4rem;
  }

  .about__content p {
    color: color-mix(in srgb, var(--chrome-text) 88%, transparent);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  /* -------------------------------------------------------- categories --- */










  /* ------------------------------------------------------- breakpoints --- */
  @media (max-width: 64rem) {
    .topics__rail {
      display: flex;
      margin-inline: calc(-1 * (100vw - min(100vw - 2.5rem, var(--page-width))) / 2);
      padding-inline: calc((100vw - min(100vw - 2.5rem, var(--page-width))) / 2);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .topics__rail::-webkit-scrollbar {
      display: none;
    }

    .topics__rail li {
      flex: 0 0 clamp(11rem, 40vw, 14rem);
      scroll-snap-align: start;
    }

    .about__inner {
      grid-template-columns: 1fr;
    }

  }

  @media (max-width: 54rem) {
    .start-grid {
      grid-template-columns: 1fr;
    }

    .start-card--feature {
      grid-row: auto;
      grid-column: auto;
    }

    .start-card:not(.start-card--feature) {
      grid-column: auto;
    }
  }

  @media (max-width: 36rem) {
    .start-card:not(.start-card--feature) {
      flex-direction: column;
    }

    .start-card:not(.start-card--feature) .start-card__image {
      width: 100%;
      aspect-ratio: 16 / 9;
    }

  }
</style>
