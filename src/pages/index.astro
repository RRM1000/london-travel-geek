---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import londonHero from "../assets/landing/london-westminster-hero.png";
import oysterHero from "../assets/articles/oyster-card/oyster-visitor-card.jpg";
import areasHero from "../assets/articles/best-areas-to-stay-and-visit-london/best-areas-to-stay-and-visit-london.jpg";
import airportHero from "../assets/articles/heathrow-airport/heathrow-terminal-5.jpg";
import itineraryHero from "../assets/articles/three-days-in-london-itinerary/three-days-in-london-itinerary.jpg";
import ArticleCard from "../components/ArticleCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { activeSite } from "../sites";
import { categoryHref } from "../lib/taxonomy";

const articles = (await getCollection("articles"))
  .filter((entry) => !entry.data.draft && entry.data.sites.includes(activeSite.id))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const hasArticles = articles.length > 0;
const categoryGroups = Array.from(
  articles.reduce((groups, article) => {
    const category = article.data.category;
    const current = groups.get(category) ?? [];
    current.push(article);
    groups.set(category, current);
    return groups;
  }, new Map<string, typeof articles>()),
)
  .map(([label, entries]) => ({
    label,
    count: entries.length,
    latest: entries[0],
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
const heroTitle =
  activeSite.id === "london"
    ? "A Geek's Guide to London."
    : "Clear answers for smoother journeys.";
---

<BaseLayout>
  <section class="hero hero--has-bg">
    <div class="hero__bg">
      <Image
        src={londonHero}
        alt="Elizabeth Tower and Westminster Bridge illuminated beside the Thames at blue hour"
        widths={[720, 1080, 1440, 1920]}
        sizes="100vw"
        loading="eager"
      />
      <div class="hero__overlay" />
    </div>
    <div class="container hero__content">
      <div class="hero__copy">
        <p class="eyebrow">{activeSite.accentLabel}</p>
        <h1>{heroTitle}</h1>
        <p class="hero__subtitle">
          We do the research so you can focus on having fun.
        </p>
        <div class="hero__actions">
          <a class="button button--primary" href="/guides/">Explore all guides</a>
          <a class="button button--hero-secondary" href="/articles/london-itineraries-by-days-and-interests/">Plan your trip</a>
        </div>
      </div>
      <div class="hero__caption">
        Elizabeth Tower and Westminster Bridge at blue hour
      </div>
    </div>
  </section>

  <!-- Start Here: 4 Essential Guides -->
  <section class="section start-here">
    <div class="container">
      <SectionHeading
        eyebrow="START HERE"
        title="Essential London Travel Guides"
        description="First time in London? Start with our most popular guides for transport, neighbourhoods, and itineraries."
      />
      <div class="grid grid--4">
        <a href="/articles/oyster-card-guide-london/" class="start-card">
          <div class="start-card__image">
            <Image
              src={oysterHero}
              alt="Yellow Oyster visitor card reader"
              widths={[480, 720]}
              sizes="(max-width: 54rem) 100vw, 25vw"
              loading="lazy"
            />
          </div>
          <div class="start-card__body">
            <p class="eyebrow">FARES & TICKETS</p>
            <h3>Which Transport Ticket Do I Need?</h3>
            <p>Oyster cards vs Contactless payment & daily capping explained.</p>
            <span class="start-card__link">Read guide &rarr;</span>
          </div>
        </a>
        <a href="/articles/best-areas-to-stay-and-visit-london/" class="start-card">
          <div class="start-card__image">
            <Image
              src={areasHero}
              alt="London skyline and Tower Bridge"
              widths={[480, 720]}
              sizes="(max-width: 54rem) 100vw, 25vw"
              loading="lazy"
            />
          </div>
          <div class="start-card__body">
            <p class="eyebrow">NEIGHBOURHOODS</p>
            <h3>Where to Stay in London</h3>
            <p>The top 7 neighbourhoods compared for first-time visitors.</p>
            <span class="start-card__link">Read guide &rarr;</span>
          </div>
        </a>
        <a href="/topics/getting-around-london/" class="start-card">
          <div class="start-card__image">
            <Image
              src={airportHero}
              alt="Heathrow Airport terminal"
              widths={[480, 720]}
              sizes="(max-width: 54rem) 100vw, 25vw"
              loading="lazy"
            />
          </div>
          <div class="start-card__body">
            <p class="eyebrow">AIRPORTS</p>
            <h3>Airport Transfer Cheat Sheets</h3>
            <p>The fastest and cheapest routes from Heathrow, Gatwick & Stansted.</p>
            <span class="start-card__link">Read guide &rarr;</span>
          </div>
        </a>
        <a href="/articles/london-itineraries-by-days-and-interests/" class="start-card">
          <div class="start-card__image">
            <Image
              src={itineraryHero}
              alt="London sights and skyline"
              widths={[480, 720]}
              sizes="(max-width: 54rem) 100vw, 25vw"
              loading="lazy"
            />
          </div>
          <div class="start-card__body">
            <p class="eyebrow">ITINERARIES</p>
            <h3>3-Day & 5-Day London Itineraries</h3>
            <p>Optimised route plans to see the best sights without rushing.</p>
            <span class="start-card__link">Read guide &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- GetYourGuide Section -->
  <section class="gyg-home section" aria-label="London activities">
    <div class="container">
      <SectionHeading
        eyebrow="CURATED EXPERIENCES"
        title="Top London Tours & Sights"
        description="Book skip-the-line tickets and top-rated tours directly through our trusted travel partners."
      />
      <div
        data-gyg-widget="auto"
        data-gyg-partner-id="WWP7I0R"
      ></div>
    </div>
  </section>

  <section id="articles" class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Plan with confidence"
        title="Latest London guides"
        description="Practical answers, useful comparisons and honest caveats for planning a smoother visit."
      />
      <div class="grid grid--3">
        {hasArticles ? (
          articles.slice(0, 6).map((article) => (
            <ArticleCard
              label={article.data.category}
              title={article.data.title}
              description={article.data.description}
              href={`/articles/${article.id}/`}
              image={article.data.heroImage}
              imageAlt={article.data.heroImageAlt}
              tags={article.data.tags}
            />
          ))
        ) : (
          Array.from({ length: 3 }).map(() => <ArticleCard empty />)
        )}
      </div>
    </div>
  </section>

  <section id="about" class="section about">
    <div class="container">
      <div class="about__header">
        <p class="eyebrow">ABOUT LONDON TRAVEL GEEK</p>
        <h2>Independent, No-Nonsense London Advice</h2>
      </div>
      <div class="about__content">
        <p>
          Navigating London shouldn't feel like a maths problem. We dig past the marketing fluff, test every route, and break down complex TfL fares, airport links, and neighbourhood choices into clear, practical advice.
        </p>
        <p>
          No sponsored rankings, no confusing jargon—just honest guidance to save you time and money.
        </p>
      </div>
    </div>
  </section>

  <section id="categories" class="section categories">
    <div class="container">
      <SectionHeading
        eyebrow="EXPLORE BY TOPIC"
        title="Find Exactly What You Need"
        description="From Oyster card hacks and airport transfers to neighbourhood breakdowns and daily itineraries—browse our guides by category."
      />
      <div class="category-grid">
        {categoryGroups.map((category, index) => (
          <article class="category-card slot">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <p class="category-card__count">{category.count} {category.count === 1 ? "guide" : "guides"}</p>
            <h3>{category.label}</h3>
            <a href={categoryHref(category.label)}>View all {category.count} guides &rarr;</a>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero {
    position: relative;
    width: 100%;
    background: var(--ink, #132a38);
    color: #ffffff;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(15, 23, 32, 0.60) 0%,
      rgba(15, 23, 32, 0.85) 65%,
      rgba(15, 23, 32, 0.96) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 3;
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .hero__copy {
    display: grid;
    gap: var(--space-3);
    max-width: 44rem;
  }

  .hero__copy .eyebrow {
    color: #f59e0b;
  }

  .hero__copy h1 {
    color: #ffffff;
    font-size: clamp(2.6rem, 7vw, 5.2rem);
    line-height: 1.08;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
  }

  .hero__subtitle {
    max-width: 39rem;
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.55;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.75rem;
  }

  .button--primary {
    background: #e63946;
    color: #ffffff;
    border-color: #e63946;
    font-weight: 800;
    box-shadow: 0 4px 14px rgba(230, 57, 70, 0.35);
  }

  .button--primary:hover {
    background: #b52d36;
    border-color: #b52d36;
    color: #ffffff;
  }

  .button--hero-secondary {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(6px);
    font-weight: 800;
  }

  .button--hero-secondary:hover {
    background: rgba(255, 255, 255, 0.28);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.5);
  }

  .hero__caption {
    margin-top: 2.25rem;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.75rem;
  }

  /* Start Here Image Cards Grid */
  .grid--4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .start-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .start-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 10px 28px rgba(19, 42, 56, 0.12);
  }

  .start-card__image {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--ink);
  }

  .start-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .start-card:hover .start-card__image :global(img) {
    transform: scale(1.06);
  }

  .start-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.15rem;
    gap: 0.35rem;
  }

  .start-card__body .eyebrow {
    color: var(--accent);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    font-weight: 800;
  }

  .start-card__body h3 {
    margin: 0;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .start-card__body p:not(.eyebrow) {
    margin: 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.45;
    flex: 1;
  }

  .start-card__link {
    margin-top: 0.6rem;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .start-card:hover .start-card__link {
    text-decoration: underline;
  }

  .gyg-home {
    padding-bottom: var(--space-5);
  }

  .gyg-home :global(iframe) {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 0;
  }

  .advert-wrap {
    padding-block: var(--space-3);
  }

  .categories {
    background: color-mix(in srgb, var(--surface-strong) 58%, transparent);
  }

  /* About Section & Badges */
  .about {
    background: var(--ink);
    color: var(--surface);
    padding-block: var(--space-7);
  }

  .about .eyebrow {
    color: #f59e0b;
  }

  .about__header h2 {
    color: #ffffff;
    font-size: clamp(2rem, 4vw, 3rem);
    margin-top: 0.4rem;
  }

  .about__content {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
    margin-top: 1.25rem;
  }

  .about__content p {
    color: color-mix(in srgb, var(--surface) 82%, transparent);
    font-size: 1.1rem;
    line-height: 1.65;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .category-card {
    display: grid;
    min-height: 15rem;
    align-content: end;
    gap: 0.4rem;
    padding: var(--space-4);
  }

  .category-card > span {
    position: absolute;
    top: 1rem;
    left: 1rem;
    color: var(--accent);
    font-family: var(--display);
    font-size: 1.5rem;
  }

  .category-card p,
  .category-card a {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .category-card__count {
    color: var(--accent) !important;
    font-weight: 800;
  }

  .category-card a {
    color: var(--ink);
    font-weight: 700;
    line-height: 1.35;
    text-decoration-color: color-mix(in srgb, var(--accent) 62%, transparent);
    text-underline-offset: 0.18em;
  }

  @media (max-width: 64rem) {
    .grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 54rem) {
    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .grid--4 {
      grid-template-columns: 1fr;
    }

    .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
