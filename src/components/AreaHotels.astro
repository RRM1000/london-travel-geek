---
// Places to stay in an area, injected into every area guide automatically.
//
// Titled "Where to stay", not "Places to stay": this used to be a second,
// separate heading below the guide's own prose "## Where to stay" section
// (area-level advice - "stay in Bermondsey, it is twenty minutes and better
// connected"). Two headings back to back said the same thing twice. That
// prose is now extracted at build time (see splitAreaGuideBody /
// src/pages/articles/[...id].astro) and passed in as introHtml, rendered
// under this ONE heading, above the property list.
//
// Peckham has the prose with no hotel-card data yet, so the section has to
// render on introHtml alone - it cannot be gated on `list.length > 0` only.
//
// Affiliate disclosure renders ONLY when a row on this page actually carries an
// affiliate link. No programmes are enabled yet, so today it renders nothing -
// a disclosure for links that do not exist would be noise, and worse, would
// train readers to ignore the one that appears when links do.
import data from "../data/hotels.json";

interface Props {
  articleId: string;
  // Accepted for a consistent call signature with the other Area* components
  // (AreaEvents, AreaActivities, AreaHiddenLondon all take it) - unused here
  // since the heading is now the fixed "Where to stay" rather than
  // "Places to stay in {areaName}".
  areaName: string;
  introHtml?: string;
}
const { articleId, introHtml = "" } = Astro.props as Props;

type Hotel = {
  slug: string; name: string; propertyType?: string; style?: string;
  brand?: string; starRating?: string; rooms?: string;
  area?: string; station?: string; walkMin?: number;
  priceBand?: string; typicalFrom?: string; breakfast?: string;
  roomTypes?: string; familyPolicy?: string; accessibility?: string;
  hasLift?: string; airCon?: string; luggageStorage?: string;
  whyGo?: string; opNote?: string; goodFor?: string[];
  website?: string; bookingUrl?: string;
  affiliateUrl?: string; affiliateNetwork?: string;
};

const list = (data.hotels as Hotel[]).filter((h: any) => h.guide === articleId);

const TYPE_LABEL: Record<string, string> = {
  hotel: "Hotel",
  hostel: "Hostel",
  aparthotel: "Aparthotel",
  townhouse: "Townhouse",
  "pub-rooms": "Rooms above a pub",
  bnb: "B&B",
  boutique: "Boutique",
  "serviced-apartment": "Serviced apartment",
};

// Only the facts worth a badge. "Breakfast extra" is the norm and says nothing;
// "breakfast included" changes the real price, so only that one shows.
const cards = list.map((h) => {
  const badges: string[] = [];
  if (h.propertyType && TYPE_LABEL[h.propertyType]) badges.push(TYPE_LABEL[h.propertyType]);
  if (h.breakfast === "included") badges.push("Breakfast included");
  if (h.accessibility === "accessible-rooms" || h.accessibility === "step-free")
    badges.push("Accessible rooms");
  return { h, badges };
});

const hasAffiliate = list.some((h) => h.affiliateUrl);

// Hotels.com's own neighbourhood landing page for an area, wrapped in the CJ
// redirect at render time. TRIAL: Covent Garden only, to see how it sits on a
// page that already carries a GetYourGuide widget before it goes on 26 guides.
//
// These urls are COPIED FROM HOTELS.COM, not built from the area name - the nh
// id is theirs and unguessable, and a wrong one is a 404 behind an ad label. An
// area with no entry renders nothing, which is the same rule the hotel rows
// themselves follow.
//
// Chosen over Expedia Group's widget builder deliberately: that is a
// third-party script that sets its own cookies and carries Expedia's tracking
// rather than CJ's, and whether CJ attribution survives it is exactly the kind
// of thing that silently earns nothing. This is a link. The redirect is the one
// tested end to end - it lands on the page with cjaff tracking applied.
const HOTELS_COM_AREA: Record<string, { url: string; label: string }> = {
  "covent-garden-area-guide": {
    url: "https://uk.hotels.com/nh10760693/hotels-in-covent-garden-london-united-kingdom/",
    label: "Covent Garden",
  },
};
const areaSearch = HOTELS_COM_AREA[articleId];
const CJ_PID = "101875905";
const areaSearchUrl = areaSearch
  ? `https://www.anrdoezrs.net/links/${CJ_PID}/type/dlg/${areaSearch.url}`
  : undefined;
---

{(introHtml || list.length > 0) && (
  <section class="area-hotels">
    <h2 id="where-to-stay">Where to stay</h2>
    {introHtml && <div class="ah-area-intro" set:html={introHtml} />}

    {list.length > 0 && (
    <p class="ah-intro">
      Cheapest first. Prices are a typical starting rate per night, not a quote.
      {hasAffiliate && (
        <span class="ah-disclosure">
          Links marked <span class="ah-ad">ad</span> are affiliate links. If you
          book through one we may earn a commission, at no extra cost to you. It
          never affects what goes on this list.
        </span>
      )}
    </p>
    )}

    {areaSearchUrl && (
      <p class="ah-search">
        <a href={areaSearchUrl} rel="sponsored nofollow noopener" target="_blank" data-affiliate="cj">
          Compare every {areaSearch!.label} hotel on Hotels.com<span class="ah-ad">ad</span>
        </a>
        <span>Dates, prices and availability across the whole area — useful when nothing on this list fits.</span>
      </p>
    )}

    {list.length > 0 && (
    <ul class="ah-list">
      {cards.map(({ h, badges }) => (
        <li class="ah-item">
          <div class="ah-head">
            <h3>{h.name}</h3>
            {h.priceBand && <span class="ah-price">{h.priceBand}</span>}
            {badges.map((b) => <span class="ah-tag">{b}</span>)}
          </div>

          <p class="ah-meta">
            {h.typicalFrom && <span>From {h.typicalFrom}</span>}
            {h.style && <span>{h.style}</span>}
            {h.roomTypes && <span>{h.roomTypes}</span>}
            {h.station && h.walkMin && <span>{h.walkMin} min from {h.station}</span>}
          </p>

          {h.whyGo && <p class="ah-why">{h.whyGo}</p>}
          {h.opNote && <p class="ah-note">{h.opNote}</p>}

          {(h.bookingUrl || h.affiliateUrl || h.website) && (
            <p class="ah-links">
              {h.bookingUrl && (
                <a href={h.bookingUrl} rel="nofollow noopener" target="_blank">Book direct</a>
              )}
              {!h.bookingUrl && h.affiliateUrl && (
                <a href={h.affiliateUrl} rel="sponsored nofollow noopener" target="_blank" data-affiliate={h.affiliateNetwork}>
                  Check prices<span class="ah-ad">ad</span>
                </a>
              )}
              {h.website && !h.bookingUrl && (
                <a href={h.website} rel="nofollow noopener" target="_blank">Website</a>
              )}
            </p>
          )}
        </li>
      ))}
    </ul>
    )}
  </section>
)}

<style>
  .area-hotels { margin-block: 3rem 2rem; }
  /* The extracted markdown prose - same rhythm as the rest of the article
     body, but scoped here since it arrives as a raw HTML fragment rather
     than through .article__body's own :global() rules. */
  .area-hotels .ah-area-intro :global(p) { margin: 0 0 1rem; }
  .area-hotels .ah-area-intro :global(ul) {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding-left: 1.35rem;
    list-style: disc;
  }
  .area-hotels .ah-area-intro :global(li::marker) { color: var(--accent); font-weight: 800; }
  .ah-intro { margin: 0 0 1.5rem; opacity: 0.8; }
  .ah-disclosure { display: block; margin-block-start: 0.5rem; font-size: 0.85rem; }

  /* Sits between the list intro and the hotels, and is deliberately quieter than
     a card: it is the fallback for when none of the named hotels suit, not a
     rival to them. A boxed, coloured call-to-action here would outrank the
     editorial list on its own page, which is the wrong way round. */
  .ah-search {
    margin: 0 0 1.5rem;
    padding-block-start: 0.9rem;
    border-block-start: 1px solid var(--color-border, #e2e2e2);
  }
  .ah-search a { font-weight: 650; }
  .ah-search > span {
    display: block;
    margin-block-start: 0.25rem;
    font-size: 0.85rem;
    opacity: 0.75;
  }
  /* Section class AND element, for the same reason as the other two sections:
     ArticleLayout's `.article__body :global(ul) { list-style: disc }` ties on
     specificity and wins on source order. These are cards, not bullets. */
  .area-hotels ul.ah-list {
    list-style: none;
    margin: 0;
    padding-left: 0;
    display: grid;
    gap: 1.5rem;
  }
  .ah-item { border-block-end: 1px solid var(--line, #e2e2e2); padding-block-end: 1.5rem; }
  .ah-list > .ah-item:last-child { border-block-end: 0; padding-block-end: 0; }
  .ah-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
  .ah-head h3 { margin: 0; font-size: 1.1rem; }
  .ah-price { font-weight: 800; color: var(--accent); }
  .ah-tag {
    font-size: 0.7rem; letter-spacing: 0.04em; text-transform: uppercase;
    padding: 0.1rem 0.45rem; border-radius: 3px; border: 1px solid currentColor;
    opacity: 0.8;
  }
  .ah-meta { display: flex; flex-wrap: wrap; gap: 0.35rem 0.9rem; margin: 0.35rem 0 0; font-size: 0.85rem; opacity: 0.75; }
  .ah-why { margin: 0.5rem 0 0; }
  .ah-note { margin: 0.4rem 0 0; font-size: 0.9rem; opacity: 0.85; }
  .ah-links { display: flex; flex-wrap: wrap; gap: 0.9rem; margin: 0.5rem 0 0; font-size: 0.9rem; }
  .ah-ad {
    margin-inline-start: 0.35rem;
    padding: 0.05rem 0.3rem;
    border: 1px solid currentColor;
    border-radius: 3px;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: 0.1em;
    opacity: 0.7;
  }
</style>
