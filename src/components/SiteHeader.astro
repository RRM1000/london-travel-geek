---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { SiteConfig } from "../sites";
import SiteLogo from "./SiteLogo.astro";

import eatImage from "../assets/articles/eat-in-london-guide/eat-in-london-guide.jpg";
import areasImage from "../assets/articles/best-areas-to-visit-london/best-areas-to-visit-london.jpg";
import planImage from "../assets/articles/three-days-in-london-itinerary/three-days-in-london-itinerary.jpg";
import transportImage from "../assets/articles/london-underground/piccadilly-circus-underground.jpg";
import simImage from "../assets/articles/travel-sim-esim-guide/travel-sim-esim-guide.jpg";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;

// The nav config carries plain string keys; the header owns the assets.
const imageMap: Record<string, ImageMetadata> = {
  eat: eatImage,
  areas: areasImage,
  plan: planImage,
  transport: transportImage,
  sim: simImage,
};

const panelItems = site.navigation.filter((item) => item.children?.length);
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <SiteLogo site={site} variant="dark" />

    <nav class="main-nav" aria-label="Primary navigation">
      <ul class="main-nav__list">
        {site.navigation.map((item) => {
          const hasPanel = !!item.children?.length;
          const image = item.imageKey ? imageMap[item.imageKey] : undefined;
          return (
            <li class:list={["main-nav__item", { "has-panel": hasPanel }]}>
              <a
                class="main-nav__link"
                href={item.href}
                aria-haspopup={hasPanel ? "true" : undefined}
                aria-expanded={hasPanel ? "false" : undefined}
              >
                {item.label}
                {hasPanel && (
                  <svg class="main-nav__caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                    <path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
              </a>
              {hasPanel && (
                <div class="mega-panel">
                  <div class="container mega-panel__inner">
                    {image && (
                      <a class="mega-panel__feature" href={item.href} tabindex="-1">
                        <Image
                          src={image}
                          alt=""
                          widths={[420, 640]}
                          sizes="26rem"
                          loading="lazy"
                        />
                        <span class="mega-panel__feature-label">
                          <span class="eyebrow eyebrow--on-dark">{item.label}</span>
                          {item.description && <span class="mega-panel__blurb">{item.description}</span>}
                        </span>
                      </a>
                    )}
                    <ul class="mega-panel__links">
                      {item.children!.map((child) => (
                        <li>
                          <a href={child.href}>
                            <span>{child.label}</span>
                            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                              <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="site-header__actions">
      <form class="header-search" action="/search" method="get" role="search">
        <input
          type="search"
          name="q"
          placeholder="Search guides"
          aria-label="Search guides"
        />
        <button type="submit" aria-label="Search">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>
      </form>

      <button
        class="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="menu-toggle__bar"></span>
        <span class="menu-toggle__bar"></span>
        <span class="menu-toggle__bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile full-screen menu -->
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <div class="mobile-menu__scroll">
      <form class="mobile-menu__search" action="/search" method="get" role="search">
        <input
          type="search"
          name="q"
          placeholder="Search guides, food and things to do"
          aria-label="Search guides"
        />
        <button type="submit" aria-label="Search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>
      </form>

      {panelItems.length > 0 && (
        <div class="mobile-menu__tiles">
          {panelItems.map((item) => {
            const image = item.imageKey ? imageMap[item.imageKey] : undefined;
            return (
              <a class="mobile-tile" href={item.href}>
                {image && (
                  <Image src={image} alt="" widths={[360, 540]} sizes="50vw" loading="lazy" />
                )}
                <span class="mobile-tile__label">{item.label}</span>
              </a>
            );
          })}
        </div>
      )}

      <nav aria-label="Mobile navigation">
        <ul class="mobile-menu__links">
          {site.navigation
            .filter((item) => !item.children?.length)
            .map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          <li><a class="button mobile-menu__cta" href="/topics/london-itineraries/">Plan your trip &rarr;</a></li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    background: var(--chrome);
    color: var(--chrome-text);
    transition: box-shadow var(--transition);
  }

  .site-header.is-scrolled {
    box-shadow: 0 6px 24px rgb(5 12 22 / 0.35);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 4.4rem;
    transition: min-height var(--transition);
  }

  .site-header.is-scrolled .site-header__inner {
    min-height: 3.7rem;
  }

  /* The logo must never be squeezed into the nav - shrink everything else
     first, and hand over to the burger menu before it gets tight. */
  .site-header__inner > :global(.logo) {
    flex: 0 0 auto;
  }

  /* ------------------------------------------------------ primary nav --- */
  .main-nav {
    display: flex;
    flex: 1 1 auto;
    align-self: stretch;
    justify-content: center;
    min-width: 0;
  }

  .main-nav__list {
    display: flex;
    height: 100%;
    flex-wrap: nowrap;
    align-items: stretch;
  }

  .main-nav__item {
    display: flex;
    align-items: stretch;
  }

  .main-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0 1.05rem;
    color: var(--chrome-text);
    font-size: 0.9rem;
    font-variation-settings: "wght" 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition);
  }

  /* Underline grows from centre - the affordance every link shares. */
  .main-nav__link::after {
    position: absolute;
    right: 1.05rem;
    bottom: 0.9rem;
    left: 1.05rem;
    height: 2px;
    border-radius: 2px;
    background: var(--highlight);
    content: "";
    scale: 0 1;
    transition: scale var(--transition);
  }

  .main-nav__item:hover .main-nav__link,
  .main-nav__item:focus-within .main-nav__link {
    color: #ffffff;
  }

  .main-nav__item:hover .main-nav__link::after,
  .main-nav__item:focus-within .main-nav__link::after {
    scale: 1 1;
  }

  .main-nav__caret {
    translate: 0 1px;
    opacity: 0.55;
    transition: rotate var(--transition), opacity var(--transition);
  }

  .main-nav__item:hover .main-nav__caret,
  .main-nav__item:focus-within .main-nav__caret {
    rotate: 180deg;
    opacity: 1;
  }

  /* ------------------------------------------------------- mega panel --- */
  .mega-panel {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    visibility: hidden;
    overflow: hidden;
    background: var(--chrome-soft);
    box-shadow: 0 30px 60px rgb(5 12 22 / 0.45);
    opacity: 0;
    translate: 0 -8px;
    transition:
      opacity var(--transition),
      translate var(--transition),
      visibility 0s linear 220ms;
    pointer-events: none;
  }

  /* Hover intent: the panel waits ~90ms before opening, so skating the
     cursor across the bar does not strobe every panel on the way past. */
  .has-panel:hover .mega-panel,
  .has-panel:focus-within .mega-panel {
    visibility: visible;
    opacity: 1;
    translate: 0 0;
    transition:
      opacity var(--transition) 90ms,
      translate var(--transition) 90ms,
      visibility 0s linear 90ms;
    pointer-events: auto;
  }

  .mega-panel__inner {
    display: grid;
    grid-template-columns: 24rem 1fr;
    gap: var(--space-5);
    padding-block: var(--space-5);
  }

  .mega-panel__feature {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .mega-panel__feature :global(img) {
    width: 100%;
    height: auto; /* beat the width/height attrs so aspect-ratio can apply */
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: scale var(--transition-slow);
  }

  .mega-panel__feature:hover :global(img) {
    scale: 1.05;
  }

  .mega-panel__feature-label {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 2.2rem 1.1rem 1rem;
    background: linear-gradient(to top, rgb(5 12 22 / 0.85), transparent);
  }

  .mega-panel__blurb {
    color: #ffffff;
    font-size: 0.95rem;
    font-variation-settings: "wght" 550;
    line-height: 1.35;
  }

  .mega-panel__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem var(--space-4);
    align-content: start;
  }

  .mega-panel__links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--chrome-text);
    font-size: 1rem;
    font-variation-settings: "wght" 550;
    text-decoration: none;
    transition: background var(--transition), color var(--transition);
  }

  .mega-panel__links svg {
    flex-shrink: 0;
    opacity: 0;
    translate: -4px 0;
    transition: opacity var(--transition), translate var(--transition);
  }

  .mega-panel__links a:hover,
  .mega-panel__links a:focus-visible {
    background: color-mix(in srgb, var(--chrome-text) 9%, transparent);
    color: #ffffff;
  }

  .mega-panel__links a:hover svg,
  .mega-panel__links a:focus-visible svg {
    opacity: 1;
    translate: 0 0;
  }

  /* ---------------------------------------------------------- actions --- */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-search {
    display: flex;
    align-items: center;
    padding: 0.2rem 0.2rem 0.2rem 0.85rem;
    border: 1.5px solid color-mix(in srgb, var(--chrome-text) 22%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--chrome-text) 7%, transparent);
    transition: border-color var(--transition), background var(--transition);
  }

  .header-search:focus-within {
    border-color: var(--highlight);
    background: color-mix(in srgb, var(--chrome-text) 12%, transparent);
  }

  .header-search input {
    width: clamp(7rem, 11vw, 10rem);
    padding: 0.25rem 0.35rem;
    border: 0;
    background: transparent;
    color: var(--chrome-text);
    font-size: 0.88rem;
    outline: none;
  }

  .header-search input::placeholder {
    color: var(--chrome-muted);
  }

  .header-search button {
    display: inline-flex;
    width: 1.9rem;
    height: 1.9rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    color: #ffffff;
    cursor: pointer;
    transition: background var(--transition), scale var(--transition);
  }

  .header-search button:hover {
    background: var(--accent-deep);
    scale: 1.06;
  }

  /* ---------------------------------------------------- mobile toggle --- */
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 0.32rem;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1.5px solid color-mix(in srgb, var(--chrome-text) 25%, transparent);
    border-radius: 0.6rem;
    background: transparent;
    cursor: pointer;
    transition: background var(--transition), border-color var(--transition);
  }

  .menu-toggle:hover {
    background: color-mix(in srgb, var(--chrome-text) 8%, transparent);
  }

  .menu-toggle__bar {
    width: 1.3rem;
    height: 2px;
    border-radius: 2px;
    background: var(--chrome-text);
    transition: translate var(--transition), rotate var(--transition), opacity var(--transition);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-child(1) {
    translate: 0 0.4rem;
    rotate: 45deg;
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-child(3) {
    translate: 0 -0.4rem;
    rotate: -45deg;
  }

  /* ------------------------------------------------------ mobile menu --- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    top: var(--header-height, 4.4rem);
    z-index: 80;
    background: var(--chrome);
    opacity: 0;
    translate: 0 -10px;
    transition: opacity var(--transition), translate var(--transition);
  }

  .mobile-menu.is-open {
    opacity: 1;
    translate: 0 0;
  }

  .mobile-menu__scroll {
    height: 100%;
    padding: 1.25rem 1.25rem 4rem;
    overflow-y: auto;
  }

  .mobile-menu__search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.3rem 0.3rem 1rem;
    border-radius: 999px;
    background: #ffffff;
    margin-bottom: 1.25rem;
  }

  .mobile-menu__search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-size: 0.95rem;
    outline: none;
  }

  .mobile-menu__search button {
    display: inline-flex;
    width: 2.3rem;
    height: 2.3rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    color: #ffffff;
    cursor: pointer;
  }

  .mobile-menu__tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .mobile-tile {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
    aspect-ratio: 16 / 10;
    text-decoration: none;
  }

  .mobile-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mobile-tile__label {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.6rem 0.85rem 0.7rem;
    background: linear-gradient(to top, rgb(5 12 22 / 0.88), transparent);
    color: #ffffff;
    font-size: 1rem;
    font-variation-settings: "wght" 700;
    letter-spacing: 0.02em;
  }

  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-menu__links a:not(.button) {
    display: block;
    padding: 0.85rem 0.9rem;
    border-radius: var(--radius-sm);
    color: var(--chrome-text);
    font-size: 1.05rem;
    font-variation-settings: "wght" 650;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background var(--transition), color var(--transition);
  }

  .mobile-menu__links a:not(.button):hover {
    background: color-mix(in srgb, var(--chrome-text) 9%, transparent);
    color: var(--highlight);
  }

  .mobile-menu__cta {
    width: 100%;
    margin-top: 0.75rem;
  }

  /* Staggered reveal on open. */
  .mobile-menu.is-open .mobile-menu__search,
  .mobile-menu.is-open .mobile-tile,
  .mobile-menu.is-open .mobile-menu__links li {
    animation: menu-item-in 380ms var(--ease) backwards;
  }

  .mobile-menu.is-open .mobile-tile:nth-child(1) { animation-delay: 40ms; }
  .mobile-menu.is-open .mobile-tile:nth-child(2) { animation-delay: 80ms; }
  .mobile-menu.is-open .mobile-tile:nth-child(3) { animation-delay: 120ms; }
  .mobile-menu.is-open .mobile-tile:nth-child(4) { animation-delay: 160ms; }
  .mobile-menu.is-open .mobile-tile:nth-child(5) { animation-delay: 200ms; }
  .mobile-menu.is-open .mobile-menu__links li:nth-child(1) { animation-delay: 240ms; }
  .mobile-menu.is-open .mobile-menu__links li:nth-child(2) { animation-delay: 280ms; }
  .mobile-menu.is-open .mobile-menu__links li:nth-child(3) { animation-delay: 320ms; }

  @keyframes menu-item-in {
    from {
      opacity: 0;
      translate: 0 12px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* ------------------------------------------------------- breakpoints --- */
  @media (max-width: 88rem) {
    .main-nav__link {
      padding-inline: 0.8rem;
    }

    .main-nav__link::after {
      right: 0.8rem;
      left: 0.8rem;
    }
  }

  /* With no CTA in the bar, search is the only right-side action - keep it
     for the whole desktop range; the burger menu carries its own search. */
  @media (max-width: 64rem) {
    .header-search {
      display: none;
    }
  }

  /* Hand over to the burger while everything still fits comfortably -
     the collision zone between full nav and tight nav is not worth serving. */
  @media (max-width: 64rem) {
    .main-nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }
  }

  @media (min-width: 64.01rem) {
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");

  // Compact the bar once the page is genuinely scrolled.
  if (header) {
    const onScroll = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 40);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // aria-expanded mirrors the CSS hover/focus state for assistive tech,
  // and Escape closes an open panel by dropping focus out of it.
  for (const item of document.querySelectorAll<HTMLElement>(".has-panel")) {
    const link = item.querySelector<HTMLAnchorElement>(".main-nav__link");
    if (!link) continue;
    item.addEventListener("mouseenter", () => link.setAttribute("aria-expanded", "true"));
    item.addEventListener("mouseleave", () => link.setAttribute("aria-expanded", "false"));
    item.addEventListener("focusin", () => link.setAttribute("aria-expanded", "true"));
    item.addEventListener("focusout", () => link.setAttribute("aria-expanded", "false"));
  }

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const active = document.activeElement as HTMLElement | null;
    if (active?.closest(".has-panel")) active.blur();
    if (mobileMenu?.classList.contains("is-open")) closeMenu();
  });

  const openMenu = () => {
    if (!mobileMenu || !toggle) return;
    mobileMenu.hidden = false;
    // Next frame, so the transition actually plays.
    requestAnimationFrame(() => mobileMenu.classList.add("is-open"));
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Close menu");
    document.body.style.overflow = "hidden";
  };

  const closeMenu = () => {
    if (!mobileMenu || !toggle) return;
    mobileMenu.classList.remove("is-open");
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Open menu");
    document.body.style.overflow = "";
    window.setTimeout(() => {
      if (!mobileMenu.classList.contains("is-open")) mobileMenu.hidden = true;
    }, 260);
  };

  toggle?.addEventListener("click", () => {
    if (mobileMenu?.classList.contains("is-open")) closeMenu();
    else openMenu();
  });
</script>
