---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { SiteConfig, NavigationChild } from "../sites";
import SiteLogo from "./SiteLogo.astro";

import eatImage from "../assets/articles/eat-in-london-guide/eat-in-london-guide.jpg";
import areasImage from "../assets/articles/best-areas-to-visit-london/best-areas-to-visit-london.jpg";
import doingImage from "../assets/articles/best-museums-london/natural-history-museum-hintze-hall.jpg";
import planImage from "../assets/articles/three-days-in-london-itinerary/three-days-in-london-itinerary.jpg";
import transportImage from "../assets/articles/london-underground/piccadilly-circus-underground.jpg";
import simImage from "../assets/articles/travel-sim-esim-guide/travel-sim-esim-guide.jpg";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;

// The nav config carries plain string keys; the header owns the assets.
// Things to Do and Areas used to share one image, which made two open panels
// look like a rendering bug.
const imageMap: Record<string, ImageMetadata> = {
  eat: eatImage,
  areas: areasImage,
  doing: doingImage,
  plan: planImage,
  transport: transportImage,
  sim: simImage,
};

// Active section. A nav item is current when the page is its own topic page
// or any of the guides listed beneath it - so a reader always knows which
// part of the site they are standing in.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => path === href.replace(/\/+$/, "");
const sectionCurrent = (item: (typeof site.navigation)[number]) =>
  isCurrent(item.href) ||
  (item.children ?? []).some((c) => isCurrent(c.href)) ||
  (item.secondary?.children ?? []).some((c) => isCurrent(c.href));

// Seasonal links are filtered at BUILD time. Every deploy rebuilds, so the
// season turns over on publish; the fallback covers a long gap between builds
// and any month nothing is tagged for.
const month = new Date().getMonth() + 1;
const inSeason = (item: (typeof site.navigation)[number]): NavigationChild[] => {
  if (!item.secondary) return [];
  const hits = item.secondary.children.filter(
    (c) => !c.months || c.months.includes(month),
  );
  return hits.length ? hits.slice(0, 5) : (item.seasonalFallback ?? []).slice(0, 5);
};
---

<header class="site-header" data-site-header>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <div class="container site-header__inner">
    <SiteLogo site={site} variant="dark" />

    <nav class="main-nav" aria-label="Primary navigation">
      <ul class="main-nav__list">
        {site.navigation.map((item, index) => {
          const hasPanel = !!item.children?.length;
          const image = item.imageKey ? imageMap[item.imageKey] : undefined;
          const current = sectionCurrent(item);
          const seasonal = inSeason(item);
          const panelId = `nav-panel-${index}`;
          return (
            <li class:list={["main-nav__item", { "has-panel": hasPanel }]} data-nav-item>
              <a
                class:list={["main-nav__link", { "is-current": current }]}
                href={item.href}
                aria-current={current ? "page" : undefined}
                data-nav-link
              >
                {item.label}
              </a>
              {hasPanel && (
                <>
                  {/* A real button, so the panel is reachable by touch and by
                      keyboard without hijacking the section link itself. */}
                  <button
                    class="main-nav__toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls={panelId}
                    aria-label={`Show ${item.label} guides`}
                    data-panel-toggle
                  >
                    <svg class="main-nav__caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                      <path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>

                  <div class="mega-panel" id={panelId} data-panel>
                    <div class="container mega-panel__inner">
                      {image && (
                        <a class="mega-panel__feature" href={item.href} tabindex="-1" aria-hidden="true">
                          <Image src={image} alt="" widths={[420, 640]} sizes="26rem" loading="lazy" />
                          <span class="mega-panel__feature-label">
                            <span class="eyebrow eyebrow--on-dark">{item.label}</span>
                            {item.description && <span class="mega-panel__blurb">{item.description}</span>}
                          </span>
                        </a>
                      )}

                      <ul class="mega-panel__links">
                        {item.children!.map((child) => (
                          <li>
                            <a href={child.href} aria-current={isCurrent(child.href) ? "page" : undefined}>
                              <span>{child.label}</span>
                              <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </a>
                          </li>
                        ))}
                      </ul>

                      {seasonal.length > 0 && item.secondary && (
                        <div class="mega-panel__seasonal">
                          <p class="mega-panel__seasonal-title">{item.secondary.title}</p>
                          <ul>
                            {seasonal.map((child) => (
                              <li>
                                <a href={child.href} aria-current={isCurrent(child.href) ? "page" : undefined}>
                                  {child.label}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}
                    </div>
                  </div>
                </>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="site-header__actions">
      <form class="header-search" action="/search" method="get" role="search">
        <input
          type="search"
          name="q"
          placeholder="Search guides"
          aria-label="Search guides"
          data-header-search
        />
        <kbd class="header-search__key" aria-hidden="true">/</kbd>
        <button type="submit" aria-label="Search">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>
      </form>

      <button
        class="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="menu-toggle__bar"></span>
        <span class="menu-toggle__bar"></span>
        <span class="menu-toggle__bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile full-screen menu -->
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <div class="mobile-menu__scroll">
      <form class="mobile-menu__search" action="/search" method="get" role="search">
        <input
          type="search"
          name="q"
          placeholder="Search guides, food and things to do"
          aria-label="Search guides"
        />
        <button type="submit" aria-label="Search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>
      </form>

      <nav aria-label="Mobile navigation">
        {/* Every panel becomes an accordion: the tile still goes straight to
            the topic page, and the chevron opens the same sub-links the
            desktop panel shows. Mobile used to lose all of them. */}
        <ul class="mobile-nav">
          {site.navigation.map((item, index) => {
            const hasPanel = !!item.children?.length;
            const image = item.imageKey ? imageMap[item.imageKey] : undefined;
            const current = sectionCurrent(item);
            const seasonal = inSeason(item);
            const listId = `mobile-panel-${index}`;
            return (
              <li class="mobile-nav__item">
                <div class="mobile-nav__row">
                  <a
                    class:list={["mobile-nav__link", { "is-current": current }]}
                    href={item.href}
                    aria-current={current ? "page" : undefined}
                  >
                    {image && hasPanel && (
                      <Image class="mobile-nav__thumb" src={image} alt="" widths={[96, 192]} sizes="3rem" loading="lazy" />
                    )}
                    <span>{item.label}</span>
                  </a>
                  {hasPanel && (
                    <button
                      class="mobile-nav__expand"
                      type="button"
                      aria-expanded="false"
                      aria-controls={listId}
                      aria-label={`Show ${item.label} guides`}
                      data-accordion-toggle
                    >
                      <svg width="14" height="14" viewBox="0 0 10 10" aria-hidden="true">
                        <path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                  )}
                </div>

                {hasPanel && (
                  <div class="mobile-nav__sub" id={listId} data-accordion-panel hidden>
                    <ul>
                      {item.children!.map((child) => (
                        <li>
                          <a href={child.href} aria-current={isCurrent(child.href) ? "page" : undefined}>
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                    {seasonal.length > 0 && item.secondary && (
                      <>
                        <p class="mobile-nav__sub-title">{item.secondary.title}</p>
                        <ul>
                          {seasonal.map((child) => (
                            <li>
                              <a href={child.href} aria-current={isCurrent(child.href) ? "page" : undefined}>
                                {child.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </>
                    )}
                  </div>
                )}
              </li>
            );
          })}
        </ul>

        {/* Dropped from the desktop bar for room; it belongs here, where
            there is plenty. */}
        <a class="mobile-menu__all" href="/guides/">Browse all guides &rarr;</a>
        <a class="button mobile-menu__cta" href="/topics/london-itineraries/">Plan your trip &rarr;</a>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    background: var(--chrome);
    color: var(--chrome-text);
    transition: box-shadow var(--transition), translate 260ms var(--ease);
  }

  .site-header.is-scrolled {
    box-shadow: 0 6px 24px rgb(5 12 22 / 0.35);
  }

  /* Hide on scroll down, return on scroll up. This replaces a min-height
     animation that reflowed layout every frame to save 0.7rem - all of the
     jitter, none of the benefit. Sliding the whole bar out costs nothing to
     animate and gives back the full header height on a phone. */
  .site-header.is-hidden {
    translate: 0 -100%;
  }

  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: #ffffff;
    font-size: 0.9rem;
    text-decoration: none;
    translate: 0 -200%;
    transition: translate var(--transition);
  }

  .skip-link:focus-visible {
    translate: 0 0;
  }

  .site-header__inner {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.4rem;
  }

  /* The bar does not have to obey the article measure. Inside --page-width
     (1216px) the logo, six sections and the search field add up to exactly
     that - zero slack, so they touched. Reading width is set by the article
     column, not by the chrome above it, so the header gets the wider screen
     when there is one. */
  .site-header__inner.container {
    width: min(calc(100% - 2.5rem), 86rem);
  }

  /* The logo must never be squeezed into the nav - shrink everything else
     first, and hand over to the burger menu before it gets tight. */
  .site-header__inner > :global(.logo) {
    flex: 0 0 auto;
  }

  /* ------------------------------------------------------ primary nav --- */
  .main-nav {
    display: flex;
    flex: 1 1 auto;
    align-self: stretch;
    justify-content: center;
    min-width: 0;
  }

  .main-nav__list {
    display: flex;
    height: 100%;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: 0.15rem;
  }

  .main-nav__item {
    display: flex;
    align-items: stretch;
  }

  .main-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0 0.55rem 0 0.95rem;
    color: var(--chrome-text);
    font-size: 0.87rem;
    font-variation-settings: "wght" 600;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition);
  }

  /* An item with no panel gets its padding back on the right. */
  .main-nav__item:not(.has-panel) .main-nav__link {
    padding-right: 0.95rem;
  }

  .main-nav__toggle {
    display: inline-flex;
    align-items: center;
    padding: 0 0.75rem 0 0.15rem;
    border: 0;
    background: transparent;
    color: var(--chrome-text);
    cursor: pointer;
  }

  /* One underline spanning the link and its caret, so a section reads as a
     single target rather than two. */
  .main-nav__item::after {
    position: absolute;
    right: 0.75rem;
    bottom: 0.9rem;
    left: 0.95rem;
    height: 2px;
    border-radius: 2px;
    background: var(--highlight);
    content: "";
    scale: 0 1;
    transform-origin: left;
    transition: scale var(--transition);
  }

  .main-nav__item {
    position: relative;
  }

  .main-nav__item:hover::after,
  .main-nav__item:focus-within::after,
  .main-nav__item.is-open::after {
    scale: 1 1;
  }

  /* The active section keeps its underline permanently, at lower contrast so
     hover still reads as a change. */
  .main-nav__item:has(.is-current)::after {
    scale: 1 1;
    background: color-mix(in srgb, var(--highlight) 55%, transparent);
  }

  .main-nav__item:hover .main-nav__link,
  .main-nav__item:focus-within .main-nav__link,
  .main-nav__link.is-current {
    color: #ffffff;
  }

  .main-nav__caret {
    opacity: 0.55;
    transition: rotate var(--transition), opacity var(--transition);
  }

  .main-nav__item.is-open .main-nav__caret {
    rotate: 180deg;
    opacity: 1;
  }

  .main-nav__toggle:hover .main-nav__caret {
    opacity: 1;
  }

  /* ------------------------------------------------------- mega panel --- */
  /* Fixed, not absolute. The nav item is position:relative so the underline
     can span the link and its caret, and an absolutely-positioned panel would
     then measure itself against that one narrow item instead of the header.
     Fixing it to the viewport under the measured header height keeps it full
     width regardless of what the item does. */
  .mega-panel {
    position: fixed;
    top: var(--header-height, 4.4rem);
    right: 0;
    left: 0;
    visibility: hidden;
    overflow: hidden;
    background: var(--chrome-soft);
    box-shadow: 0 30px 60px rgb(5 12 22 / 0.45);
    opacity: 0;
    translate: 0 -8px;
    transition:
      opacity var(--transition),
      translate var(--transition),
      visibility 0s linear 220ms;
    pointer-events: none;
  }

  /* Opened by click (JS adds .is-open) or by keyboard focus. Hover intent
     waits ~90ms so skating the cursor across the bar does not strobe every
     panel on the way past. */
  .main-nav__item.is-open .mega-panel,
  .has-panel:hover .mega-panel,
  .has-panel:focus-within .mega-panel {
    visibility: visible;
    opacity: 1;
    translate: 0 0;
    transition:
      opacity var(--transition) 90ms,
      translate var(--transition) 90ms,
      visibility 0s linear 90ms;
    pointer-events: auto;
  }

  .main-nav__item.is-open .mega-panel {
    transition-delay: 0s;
  }

  .mega-panel__inner {
    display: grid;
    grid-template-columns: 22rem minmax(0, 1fr) auto;
    gap: var(--space-5);
    padding-block: var(--space-5);
  }

  /* Panels with no seasonal column collapse to two. */
  .mega-panel__inner:not(:has(.mega-panel__seasonal)) {
    grid-template-columns: 22rem minmax(0, 1fr);
  }

  .mega-panel__feature {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .mega-panel__feature :global(img) {
    width: 100%;
    height: auto; /* beat the width/height attrs so aspect-ratio can apply */
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: scale var(--transition-slow);
  }

  .mega-panel__feature:hover :global(img) {
    scale: 1.05;
  }

  .mega-panel__feature-label {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 2.2rem 1.1rem 1rem;
    background: linear-gradient(to top, rgb(5 12 22 / 0.85), transparent);
  }

  .mega-panel__blurb {
    color: #ffffff;
    font-size: 0.95rem;
    font-variation-settings: "wght" 550;
    line-height: 1.35;
  }

  .mega-panel__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem var(--space-4);
    align-content: start;
  }

  .mega-panel__links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--chrome-text);
    font-size: 0.98rem;
    font-variation-settings: "wght" 550;
    text-decoration: none;
    transition: background var(--transition), color var(--transition);
  }

  .mega-panel__links svg {
    flex-shrink: 0;
    opacity: 0;
    translate: -4px 0;
    transition: opacity var(--transition), translate var(--transition);
  }

  .mega-panel__links a:hover,
  .mega-panel__links a:focus-visible {
    background: color-mix(in srgb, var(--chrome-text) 9%, transparent);
    color: #ffffff;
  }

  .mega-panel__links a[aria-current="page"] {
    background: color-mix(in srgb, var(--highlight) 14%, transparent);
    color: #ffffff;
  }

  .mega-panel__links a:hover svg,
  .mega-panel__links a:focus-visible svg {
    opacity: 1;
    translate: 0 0;
  }

  /* ---------------------------------------------------- seasonal rail --- */
  .mega-panel__seasonal {
    min-width: 13rem;
    padding-left: var(--space-4);
    border-left: 1px solid color-mix(in srgb, var(--chrome-text) 15%, transparent);
  }

  .mega-panel__seasonal-title {
    margin: 0 0 0.6rem;
    color: var(--highlight);
    font-size: 0.72rem;
    font-variation-settings: "wght" 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mega-panel__seasonal ul {
    display: grid;
    gap: 0.1rem;
  }

  .mega-panel__seasonal a {
    display: block;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--chrome-text);
    font-size: 0.95rem;
    font-variation-settings: "wght" 550;
    text-decoration: none;
    transition: background var(--transition), color var(--transition);
  }

  .mega-panel__seasonal a:hover,
  .mega-panel__seasonal a:focus-visible,
  .mega-panel__seasonal a[aria-current="page"] {
    background: color-mix(in srgb, var(--chrome-text) 9%, transparent);
    color: #ffffff;
  }

  /* ---------------------------------------------------------- actions --- */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-search {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.2rem 0.2rem 0.85rem;
    border: 1.5px solid color-mix(in srgb, var(--chrome-text) 22%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--chrome-text) 7%, transparent);
    transition: border-color var(--transition), background var(--transition);
  }

  .header-search:focus-within {
    border-color: var(--highlight);
    background: color-mix(in srgb, var(--chrome-text) 12%, transparent);
  }

  .header-search input {
    width: clamp(6.5rem, 9vw, 9rem);
    padding: 0.25rem 0.35rem;
    border: 0;
    background: transparent;
    color: var(--chrome-text);
    font-size: 0.88rem;
    outline: none;
    transition: width var(--transition);
  }

  /* Give the field real room the moment it is being used. */
  .header-search:focus-within input {
    width: clamp(10rem, 16vw, 15rem);
  }

  .header-search input::placeholder {
    color: var(--chrome-muted);
  }

  .header-search__key {
    padding: 0.05rem 0.35rem;
    border: 1px solid color-mix(in srgb, var(--chrome-text) 25%, transparent);
    border-radius: 0.3rem;
    color: var(--chrome-muted);
    font-family: var(--mono, monospace);
    font-size: 0.7rem;
    line-height: 1.35;
    transition: opacity var(--transition);
  }

  .header-search:focus-within .header-search__key {
    opacity: 0;
  }

  .header-search button {
    display: inline-flex;
    width: 1.9rem;
    height: 1.9rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    color: #ffffff;
    cursor: pointer;
    transition: background var(--transition), scale var(--transition);
  }

  .header-search button:hover {
    background: var(--accent-deep);
    scale: 1.06;
  }

  /* ---------------------------------------------------- mobile toggle --- */
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 0.32rem;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1.5px solid color-mix(in srgb, var(--chrome-text) 25%, transparent);
    border-radius: 0.6rem;
    background: transparent;
    cursor: pointer;
    transition: background var(--transition), border-color var(--transition);
  }

  .menu-toggle:hover {
    background: color-mix(in srgb, var(--chrome-text) 8%, transparent);
  }

  .menu-toggle__bar {
    width: 1.3rem;
    height: 2px;
    border-radius: 2px;
    background: var(--chrome-text);
    transition: translate var(--transition), rotate var(--transition), opacity var(--transition);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-child(1) {
    translate: 0 0.4rem;
    rotate: 45deg;
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-child(3) {
    translate: 0 -0.4rem;
    rotate: -45deg;
  }

  /* ------------------------------------------------------ mobile menu --- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    top: var(--header-height, 4.4rem);
    z-index: 80;
    background: var(--chrome);
    opacity: 0;
    translate: 0 -10px;
    transition: opacity var(--transition), translate var(--transition);
  }

  .mobile-menu.is-open {
    opacity: 1;
    translate: 0 0;
  }

  .mobile-menu__scroll {
    height: 100%;
    padding: 1.25rem 1.25rem 4rem;
    overflow-y: auto;
  }

  .mobile-menu__search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.3rem 0.3rem 1rem;
    border-radius: 999px;
    background: #ffffff;
    margin-bottom: 1.25rem;
  }

  .mobile-menu__search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-size: 0.95rem;
    outline: none;
  }

  .mobile-menu__search button {
    display: inline-flex;
    width: 2.3rem;
    height: 2.3rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    color: #ffffff;
    cursor: pointer;
  }

  /* -------------------------------------------------- mobile accordion --- */
  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .mobile-nav__row {
    display: flex;
    align-items: stretch;
    gap: 0.25rem;
    border-radius: var(--radius-sm);
    transition: background var(--transition);
  }

  .mobile-nav__row:hover {
    background: color-mix(in srgb, var(--chrome-text) 7%, transparent);
  }

  .mobile-nav__link {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.8rem;
    min-height: 3.4rem;
    padding: 0.5rem 0.6rem;
    color: var(--chrome-text);
    font-size: 1.02rem;
    font-variation-settings: "wght" 650;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .mobile-nav__link.is-current {
    color: var(--highlight);
  }

  .mobile-nav__thumb {
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    object-fit: cover;
  }

  /* A 48px target, which is the whole point of splitting it from the link. */
  .mobile-nav__expand {
    display: inline-flex;
    width: 3rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--chrome-text);
    cursor: pointer;
    transition: background var(--transition);
  }

  .mobile-nav__expand:hover {
    background: color-mix(in srgb, var(--chrome-text) 10%, transparent);
  }

  .mobile-nav__expand svg {
    transition: rotate var(--transition);
  }

  .mobile-nav__expand[aria-expanded="true"] svg {
    rotate: 180deg;
  }

  .mobile-nav__sub {
    padding: 0.15rem 0 0.6rem 0.7rem;
    margin-left: 0.7rem;
    border-left: 2px solid color-mix(in srgb, var(--chrome-text) 18%, transparent);
  }

  .mobile-nav__sub ul {
    display: flex;
    flex-direction: column;
  }

  .mobile-nav__sub a {
    display: block;
    padding: 0.65rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--chrome-muted);
    font-size: 0.98rem;
    font-variation-settings: "wght" 550;
    text-decoration: none;
    transition: background var(--transition), color var(--transition);
  }

  .mobile-nav__sub a:hover,
  .mobile-nav__sub a[aria-current="page"] {
    background: color-mix(in srgb, var(--chrome-text) 9%, transparent);
    color: #ffffff;
  }

  .mobile-nav__sub-title {
    margin: 0.7rem 0 0.2rem 0.6rem;
    color: var(--highlight);
    font-size: 0.7rem;
    font-variation-settings: "wght" 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mobile-menu__all {
    display: block;
    padding: 0.9rem 0.6rem;
    margin-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--chrome-text) 15%, transparent);
    color: var(--chrome-text);
    font-size: 1rem;
    font-variation-settings: "wght" 650;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--transition);
  }

  .mobile-menu__all:hover {
    color: var(--highlight);
  }

  .mobile-menu__cta {
    width: 100%;
    margin-top: 0.75rem;
  }

  /* Staggered reveal on open. */
  .mobile-menu.is-open .mobile-menu__search,
  .mobile-menu.is-open .mobile-nav__item {
    animation: menu-item-in 380ms var(--ease) backwards;
  }

  .mobile-menu.is-open .mobile-nav__item:nth-child(1) { animation-delay: 40ms; }
  .mobile-menu.is-open .mobile-nav__item:nth-child(2) { animation-delay: 80ms; }
  .mobile-menu.is-open .mobile-nav__item:nth-child(3) { animation-delay: 120ms; }
  .mobile-menu.is-open .mobile-nav__item:nth-child(4) { animation-delay: 160ms; }
  .mobile-menu.is-open .mobile-nav__item:nth-child(5) { animation-delay: 200ms; }
  .mobile-menu.is-open .mobile-nav__item:nth-child(6) { animation-delay: 240ms; }

  @keyframes menu-item-in {
    from {
      opacity: 0;
      translate: 0 12px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* ------------------------------------------------------- breakpoints --- */
  @media (max-width: 90rem) {
    .main-nav__link {
      padding-left: 0.7rem;
      font-size: 0.84rem;
    }

    .main-nav__toggle {
      padding-right: 0.5rem;
    }

    .main-nav__item::after {
      right: 0.5rem;
      left: 0.7rem;
    }

    .header-search__key {
      display: none;
    }
  }

  /* Hand over to the burger while everything still fits comfortably. The old
     68rem let the full bar run at widths where it had no slack at all and the
     logo touched the first link. With five sections rather than six, and the
     header no longer capped at the article measure, it clears from here up
     with real slack. Measured, not guessed: at 1130px the bar still had zero
     spare, at 1216 it has room. */
  @media (max-width: 76rem) {
    .main-nav,
    .header-search {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }
  }

  @media (min-width: 76.01rem) {
    .mobile-menu {
      display: none;
    }
  }

  /* Motion is decoration here; every state is also carried by colour, the
     caret rotation and aria-expanded. */
  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .mega-panel,
    .mobile-menu,
    .main-nav__item::after,
    .header-search input,
    .mega-panel__feature :global(img) {
      transition-duration: 0.01ms;
    }

    .site-header.is-hidden {
      translate: 0 0;
    }

    .mobile-menu.is-open .mobile-menu__search,
    .mobile-menu.is-open .mobile-nav__item {
      animation: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const navItems = Array.from(document.querySelectorAll<HTMLElement>("[data-nav-item]"));

  // --header-height was never actually set, so the mobile menu fell back to a
  // hard-coded 4.4rem and sat adrift of the real bar. Measure it, and keep it
  // measured.
  const syncHeaderHeight = () => {
    if (!header) return;
    document.documentElement.style.setProperty(
      "--header-height",
      `${header.offsetHeight}px`,
    );
  };

  if (header) {
    syncHeaderHeight();
    window.addEventListener("resize", syncHeaderHeight, { passive: true });

    // Shadow once genuinely scrolled; hide the bar on the way down and bring
    // it back on the way up. Held above the fold, and never while a menu or
    // panel is open.
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      header.classList.toggle("is-scrolled", y > 40);

      const menuOpen = mobileMenu?.classList.contains("is-open");
      const panelOpen = navItems.some((i) => i.classList.contains("is-open"));
      if (menuOpen || panelOpen || y < 240) {
        header.classList.remove("is-hidden");
      } else if (y > lastY + 6) {
        header.classList.add("is-hidden");
      } else if (y < lastY - 6) {
        header.classList.remove("is-hidden");
      }
      lastY = y;
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // ----------------------------------------------------- desktop panels ---
  // Click as well as hover, so the panels are reachable on a touchscreen.
  // Previously a tap on "Eat & Drink" navigated straight past twelve links
  // that no touch device could ever see.
  const closeAllPanels = (except?: HTMLElement) => {
    for (const item of navItems) {
      if (item === except) continue;
      item.classList.remove("is-open");
      item.querySelector("[data-panel-toggle]")?.setAttribute("aria-expanded", "false");
    }
  };

  for (const item of navItems) {
    const button = item.querySelector<HTMLButtonElement>("[data-panel-toggle]");
    if (!button) continue;

    button.addEventListener("click", () => {
      const open = item.classList.toggle("is-open");
      button.setAttribute("aria-expanded", open ? "true" : "false");
      closeAllPanels(item);
    });

    // Hover still works on a mouse, and clears any click-opened panel so the
    // two mechanisms cannot disagree.
    item.addEventListener("mouseenter", () => closeAllPanels());
  }

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    if (!target?.closest("[data-nav-item]")) closeAllPanels();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      const active = document.activeElement as HTMLElement | null;
      if (active?.closest(".has-panel")) active.blur();
      closeAllPanels();
      if (mobileMenu?.classList.contains("is-open")) closeMenu();
      return;
    }

    // "/" focuses search, the way every developer tool and most content sites
    // now behave - but never while the reader is already typing somewhere.
    if (event.key === "/" && !event.metaKey && !event.ctrlKey) {
      const active = document.activeElement;
      const typing =
        active instanceof HTMLInputElement ||
        active instanceof HTMLTextAreaElement ||
        (active as HTMLElement | null)?.isContentEditable;
      if (typing) return;
      const search = document.querySelector<HTMLInputElement>("[data-header-search]");
      if (search && search.offsetParent !== null) {
        event.preventDefault();
        search.focus();
      }
    }
  });

  // ---------------------------------------------------- mobile accordion ---
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-accordion-toggle]")) {
    button.addEventListener("click", () => {
      const panel = document.getElementById(button.getAttribute("aria-controls") ?? "");
      if (!panel) return;
      const open = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", open ? "false" : "true");
      panel.hidden = open;
    });
  }

  const openMenu = () => {
    if (!mobileMenu || !toggle) return;
    syncHeaderHeight();
    mobileMenu.hidden = false;
    // Next frame, so the transition actually plays.
    requestAnimationFrame(() => mobileMenu.classList.add("is-open"));
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Close menu");
    document.body.style.overflow = "hidden";
    header?.classList.remove("is-hidden");
  };

  const closeMenu = () => {
    if (!mobileMenu || !toggle) return;
    mobileMenu.classList.remove("is-open");
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Open menu");
    document.body.style.overflow = "";
    window.setTimeout(() => {
      if (!mobileMenu.classList.contains("is-open")) mobileMenu.hidden = true;
    }, 260);
  };

  toggle?.addEventListener("click", () => {
    if (mobileMenu?.classList.contains("is-open")) closeMenu();
    else openMenu();
  });
</script>
