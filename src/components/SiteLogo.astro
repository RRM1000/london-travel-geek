---
import type { SiteConfig } from "../sites";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
---

<a class="logo" href="/" aria-label={`${site.name} home`}>
  <img 
    src="/logo.png" 
    alt={`${site.name} logo`} 
    class="logo__img" 
    width="48" 
    height="48" 
    loading="eager"
  />
  <span class="logo__text">
    <span class="logo__black">LONDON</span>
    <span class="logo__red">TRAVEL</span>
    <span class="logo__black">GEEK</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    background: transparent;
    transition: opacity var(--transition, 180ms ease);
  }

  .logo:hover {
    opacity: 0.92;
  }

  .logo__img {
    height: clamp(2.4rem, 4.2vw, 3.1rem);
    width: auto;
    flex-shrink: 0;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .logo__text {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--display), "Outfit", "Arial Black", sans-serif;
    font-weight: 900;
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .logo__black {
    color: #132a38;
  }

  .logo__red {
    color: #e63946;
  }
</style>
