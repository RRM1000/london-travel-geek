---
import type { SiteConfig } from "../sites";

interface Props {
  site: SiteConfig;
  variant?: "light" | "dark";
}

const { site, variant = "light" } = Astro.props;
---

<a class={`logo logo--${variant}`} href="/" aria-label={`${site.name} home`}>
  <img 
    src="/logo.png" 
    alt={`${site.name} logo`} 
    class="logo__img" 
    width="48" 
    height="48" 
    loading="eager"
  />
  <span class="logo__text">
    <span class="logo__black">LONDON</span>
    <span class="logo__red">TRAVEL</span>
    <span class="logo__black">GEEK</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    background: transparent;
    transition: opacity var(--transition, 180ms ease);
  }

  .logo:hover {
    opacity: 0.92;
  }

  .logo__img {
    height: clamp(2.4rem, 4.2vw, 3.1rem);
    width: auto;
    flex-shrink: 0;
    object-fit: contain;
  }

  .logo--light .logo__img {
    mix-blend-mode: multiply;
  }

  .logo--dark .logo__img {
    filter: brightness(0) invert(1);
  }

  .logo__text {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--body, "Segoe UI"), sans-serif;
    font-weight: 800;
    font-variation-settings: "wght" 800;
    font-size: clamp(1.2rem, 2.3vw, 1.55rem);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .logo--light .logo__black {
    color: var(--ink, #0e1b2c);
  }

  .logo--dark .logo__black {
    color: #ffffff;
  }

  /* Bus red on paper; lifted a step on the ink ground so it stays vivid. */
  .logo--light .logo__red {
    color: var(--accent, #d6392f);
  }

  .logo--dark .logo__red {
    color: #e8564c;
  }
</style>
