---
// One-off map for public-toilets-london.md, wired in by ArticleLayout the
// same way the tube-lines guide gets its own special case. Data is 400
// Zone 1 facilities pulled from the Great British Public Toilet Map's own
// GraphQL API (see scripts note in the article's git history) and written
// to public/public-toilets.json - fetched client-side rather than inlined,
// same reasoning as plaques.astro: ~93KB would needlessly bloat this
// article's HTML for a section most readers never open.
//
// Unlike the marathon route map this replaced elsewhere on the site, this
// is POINT markers over a roughly square area (Zone 1), not a thin line
// over a wide-but-short bounding box - the exact shape that made fitBounds
// force excessive zoom-out there. Clustering (Leaflet.markercluster, same
// plugin plaques.astro uses) handles the marker count instead.
//
// The "find nearest" widget exists because ArticleLayout only ever injects
// one-off components like this one right after <slot/> - the very end of
// the article, after the FAQ. That's fine for someone planning a trip, but
// wrong for someone who searched "public toilets near me" mid-emergency on
// their phone: they should not have to scroll past the whole guide first.
// Rather than restructure the layout's injection point (which every other
// one-off component also relies on), the article's own top callout links
// straight to #toilets-near-me, and this widget answers the actual
// question - "which one, right now" - without requiring the full map to
// load at all. It reuses the same public-toilets.json fetch as the map,
// just without Leaflet.
---

<section class="toilets-map" aria-labelledby="toilets-near-me-title">
  <h2 id="toilets-near-me-title">Find toilets near you</h2>
  <div class="toilets-nearest">
    <button type="button" id="toilets-locate-btn" class="toilets-locate-btn">
      📍 Use my location
    </button>
    <p id="toilets-nearest-status" class="toilets-nearest-status">
      Shows the closest Zone 1 facilities from the dataset below, with a link to open directions.
    </p>
    <ol id="toilets-nearest-list" class="toilets-nearest-list" hidden></ol>
  </div>

  <h3 id="toilets-map-title">Map: Zone 1 public toilets</h3>
  <details class="toilets-map-shell">
    <summary>
      Open the map
      <small>400 Zone 1 facilities · free, paid and unclear</small>
    </summary>
    <div class="toilets-map-canvas" data-toilets-map>
      <p>The map loads when you open this section.</p>
    </div>
    <p class="toilets-map-legend">
      <span><span class="toilets-map-key toilets-map-key--free"></span>Free</span>
      <span><span class="toilets-map-key toilets-map-key--paid"></span>Paid</span>
      <span><span class="toilets-map-key toilets-map-key--unknown"></span>Payment status not recorded</span>
    </p>
    <p class="toilets-map-source">
      Data: <a href="https://www.toiletmap.org.uk" target="_blank" rel="noopener">Great British Public Toilet Map</a>,
      Zone 1 only. A crowdsourced database — a pin's status can lag reality, so treat this as a starting point.
    </p>
  </details>
</section>

<style>
  .toilets-map :global(h2),
  .toilets-map :global(h3) {
    scroll-margin-top: 2rem;
  }

  .toilets-nearest {
    border: 1px solid var(--line, #e2dbcf);
    border-radius: 0.9rem;
    background: var(--surface, #fff);
    padding: 1rem;
    margin-bottom: 1.2rem;
  }
  .toilets-locate-btn {
    font: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--accent, #d6392f);
    background: var(--accent, #d6392f);
    color: #fff;
    cursor: pointer;
  }
  .toilets-locate-btn:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .toilets-nearest-status {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: var(--muted, #5a6a7d);
  }
  .toilets-nearest-list {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  :global(.toilets-nearest-list li) {
    border: 1px solid var(--line, #e2dbcf);
    border-radius: 0.6rem;
    padding: 0.6rem 0.8rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  :global(.toilets-nearest-name) {
    font-weight: 600;
  }
  :global(.toilets-nearest-meta) {
    display: block;
    font-size: 0.82rem;
    color: var(--muted, #5a6a7d);
    margin-top: 0.15rem;
  }
  :global(.toilets-nearest-dist) {
    font-weight: 600;
    color: var(--ink, #0e1b2c);
    white-space: nowrap;
  }
  :global(.toilets-nearest-list a) {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--secondary, #1d4e89);
    white-space: nowrap;
  }

  .toilets-map-shell {
    border: 1px solid var(--line, #e2dbcf);
    border-radius: 0.9rem;
    background: var(--surface, #fff);
    padding: 0.15rem 1rem 1rem;
  }
  .toilets-map-shell summary {
    padding: 0.7rem 0;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .toilets-map-shell summary::-webkit-details-marker { display: none; }
  .toilets-map-shell summary::before { content: "▸ "; color: var(--muted, #5a6a7d); }
  .toilets-map-shell[open] summary::before { content: "▾ "; }
  .toilets-map-shell summary small {
    display: block;
    font-weight: 400;
    font-size: 0.82rem;
    color: var(--muted, #5a6a7d);
    margin-top: 0.15rem;
  }

  .toilets-map-canvas {
    height: min(65vh, 32rem);
    border-radius: 0.7rem;
    border: 1px solid var(--line, #e2dbcf);
    overflow: hidden;
    background: var(--surface-strong, #f0ebe2);
    /* Same isolation fix as the plaques map - Leaflet's panes/controls run
       z-index up to ~1000, which otherwise beats the sticky header once
       scrolled past it. */
    isolation: isolate;
  }
  .toilets-map-canvas p {
    margin: 0;
    padding: 1rem;
    font-size: 0.9rem;
    color: var(--muted, #5a6a7d);
  }

  .toilets-map-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0.7rem 0 0;
    font-size: 0.85rem;
  }
  .toilets-map-legend span:not(.toilets-map-key) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .toilets-map-key {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    display: inline-block;
    border: 1px solid rgb(0 0 0 / 0.25);
  }
  .toilets-map-key--free { background: #1f7a4d; }
  .toilets-map-key--paid { background: var(--accent, #d6392f); }
  .toilets-map-key--unknown { background: #9aa5ad; }

  .toilets-map-source {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    color: var(--muted, #5a6a7d);
  }

  /* Leaflet builds these at runtime, outside Astro's scoping. */
  :global(.toilets-pop) { font-family: inherit; max-width: 16rem; }
  :global(.toilets-pop strong) { font-size: 0.95rem; }
  :global(.toilets-pop-line) { margin: 0.3em 0; font-size: 0.85em; color: var(--ink-soft, #22344a); }
  :global(.toilets-pop-badges) { margin: 0.3em 0 0; font-size: 0.8em; color: var(--muted, #5a6a7d); }

  :global(.toilets-map-canvas .marker-cluster),
  :global(.toilets-map-canvas .marker-cluster div) {
    background: rgb(29 78 137 / 0.85);
    color: #fff;
  }
  :global(.toilets-map-canvas .marker-cluster) {
    border: 3px solid rgb(255 255 255 / 0.9);
    box-shadow: 0 1px 4px rgb(14 27 44 / 0.22);
  }
  :global(.toilets-map-canvas .marker-cluster div) {
    font: 600 0.78rem/1 var(--body, system-ui, sans-serif);
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

<script>
  type Toilet = {
    name: string | null;
    lat: number;
    lng: number;
    area: string | null;
    category: "free" | "paid" | "unknown";
    price: string | null;
    notes: string | null;
    accessible?: boolean;
    babyChange?: boolean;
    radar?: boolean;
  };

  const CATEGORY_COLOUR: Record<string, string> = {
    free: "#1f7a4d",
    paid: "#d6392f",
    unknown: "#9aa5ad",
  };

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[m]!);

  // -------------------------------------------------------- nearest-to-you
  // No Leaflet here at all - this is the fast path for someone who searched
  // "public toilets near me" on their phone and should not have to wait for
  // a map library to load just to get an answer. Distance is straight-line
  // (haversine), not walking distance - close enough at this scale, and the
  // "Get directions" link hands off to the phone's own map app for the real
  // route anyway.
  let toiletsCache: Toilet[] | null = null;
  async function loadToilets(): Promise<Toilet[]> {
    if (toiletsCache) return toiletsCache;
    const res = await fetch("/public-toilets.json");
    const data = await res.json();
    toiletsCache = (data.toilets || []) as Toilet[];
    return toiletsCache;
  }

  function haversineMetres(lat1: number, lng1: number, lat2: number, lng2: number): number {
    const R = 6371000;
    const toRad = (d: number) => (d * Math.PI) / 180;
    const dLat = toRad(lat2 - lat1);
    const dLng = toRad(lng2 - lng1);
    const a =
      Math.sin(dLat / 2) ** 2 +
      Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  function formatDistance(m: number): string {
    return m < 1000 ? `${Math.round(m / 10) * 10}m` : `${(m / 1000).toFixed(1)}km`;
  }

  function initNearestWidget() {
    const btn = document.getElementById("toilets-locate-btn") as HTMLButtonElement | null;
    const statusEl = document.getElementById("toilets-nearest-status");
    const listEl = document.getElementById("toilets-nearest-list") as HTMLOListElement | null;
    if (!btn || !statusEl || !listEl) return;

    btn.addEventListener("click", () => {
      if (!("geolocation" in navigator)) {
        statusEl.textContent = "Your browser does not support location - try the map below instead.";
        return;
      }
      btn.disabled = true;
      btn.textContent = "Locating…";
      statusEl.textContent = "Waiting for your location…";

      navigator.geolocation.getCurrentPosition(
        async (pos) => {
          try {
            const { latitude, longitude } = pos.coords;
            const toilets = await loadToilets();
            const ranked = toilets
              .map((t) => ({ t, d: haversineMetres(latitude, longitude, t.lat, t.lng) }))
              .sort((a, b) => a.d - b.d)
              .slice(0, 5);

            listEl.innerHTML = ranked
              .map(({ t, d }) => {
                const title = t.name || `Public toilet${t.area ? `, ${t.area}` : ""}`;
                const priceLabel =
                  t.category === "paid"
                    ? `Paid${t.price ? ` (${esc(t.price)})` : ""}`
                    : t.category === "free"
                      ? "Free"
                      : "Payment status not recorded";
                const dirUrl = `https://www.google.com/maps/dir/?api=1&destination=${t.lat},${t.lng}`;
                return `
                  <li>
                    <span>
                      <span class="toilets-nearest-name">${esc(title)}</span>
                      <span class="toilets-nearest-meta">${priceLabel}${t.area ? ` · ${esc(t.area)}` : ""}</span>
                    </span>
                    <span class="toilets-nearest-dist">${formatDistance(d)}</span>
                    <a href="${dirUrl}" target="_blank" rel="noopener">Directions →</a>
                  </li>`;
              })
              .join("");
            listEl.hidden = false;
            statusEl.textContent = "Nearest first. Straight-line distance, not walking distance.";
          } catch {
            statusEl.textContent = "Could not load the toilet data. Try the map below instead.";
          } finally {
            btn.disabled = false;
            btn.textContent = "📍 Use my location";
          }
        },
        (err) => {
          btn.disabled = false;
          btn.textContent = "📍 Use my location";
          statusEl.textContent =
            err.code === err.PERMISSION_DENIED
              ? "Location permission was denied - try the map below instead."
              : "Could not get your location - try the map below instead.";
        },
        { enableHighAccuracy: true, timeout: 10000 },
      );
    });
  }
  initNearestWidget();

  // Same one-loader-wins pattern as the plaques page and the area maps:
  // whichever component gets there first injects the script/styles, and
  // anything after it reuses window.L rather than double-loading.
  function loadCss(href: string, marker: string) {
    if (document.querySelector(`link[${marker}]`)) return;
    const l = document.createElement("link");
    l.rel = "stylesheet";
    l.href = href;
    l.setAttribute(marker, "");
    document.head.appendChild(l);
  }
  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const s = document.createElement("script");
      s.src = src;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error(`failed to load ${src}`));
      document.head.appendChild(s);
    });
  }
  async function loadLeaflet(): Promise<any> {
    const w = window as any;
    if (w.L && w.L.markerClusterGroup) return w.L;
    loadCss("https://unpkg.com/leaflet@1.9.4/dist/leaflet.css", "data-leaflet-styles");
    loadCss("https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css", "data-mc-styles");
    loadCss("https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css", "data-mcd-styles");
    if (!w.L) await loadScript("https://unpkg.com/leaflet@1.9.4/dist/leaflet.js");
    if (!w.L?.markerClusterGroup) {
      await loadScript("https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js");
    }
    if (!w.L?.markerClusterGroup) throw new Error("Leaflet/markercluster did not load.");
    return w.L;
  }

  function popupHtml(t: Toilet): string {
    const title = t.name || `Public toilet${t.area ? `, ${t.area}` : ""}`;
    const priceLine =
      t.category === "paid"
        ? `Paid${t.price ? ` — ${esc(t.price)}` : ""}`
        : t.category === "free"
          ? "Free"
          : "Payment status not recorded";
    const badges = [
      t.accessible && "♿ Accessible",
      t.babyChange && "🚼 Baby change",
      t.radar && "🔑 RADAR key",
    ].filter(Boolean).join(" · ");
    return `
      <div class="toilets-pop">
        <strong>${esc(title)}</strong>
        <p class="toilets-pop-line">${priceLine}${t.area ? ` · ${esc(t.area)}` : ""}</p>
        ${t.notes ? `<p class="toilets-pop-line">${esc(t.notes)}</p>` : ""}
        ${badges ? `<p class="toilets-pop-badges">${badges}</p>` : ""}
      </div>`;
  }

  async function initialiseMap(container: HTMLElement) {
    if (container.dataset.mapReady === "true") return;
    container.dataset.mapReady = "true";

    try {
      const [toiletsRes, L] = await Promise.all([
        fetch("/public-toilets.json"),
        loadLeaflet(),
      ]);
      const data = await toiletsRes.json();
      const toilets: Toilet[] = data.toilets || [];
      if (!toilets.length) throw new Error("no data");

      container.replaceChildren();
      const map = L.map(container, { scrollWheelZoom: false });
      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      }).addTo(map);

      const cluster = L.markerClusterGroup({
        chunkedLoading: true,
        maxClusterRadius: 42,
        spiderfyOnMaxZoom: true,
        disableClusteringAtZoom: 17,
      });

      const positions: [number, number][] = [];
      for (const t of toilets) {
        positions.push([t.lat, t.lng]);
        const colour = CATEGORY_COLOUR[t.category] || CATEGORY_COLOUR.unknown;
        const marker = L.circleMarker([t.lat, t.lng], {
          radius: 6,
          weight: 1.5,
          color: "#fff",
          fillColor: colour,
          fillOpacity: 0.9,
        }).bindPopup(popupHtml(t));
        cluster.addLayer(marker);
      }
      map.addLayer(cluster);

      // Zone 1 is roughly square (~5km wide, ~5km tall), not a thin line, so
      // fitBounds behaves the way it does on the area-guide maps rather than
      // the aspect-ratio problem a wide-but-short route line caused
      // elsewhere on this site.
      map.fitBounds(L.latLngBounds(positions), { padding: [24, 24], maxZoom: 15 });

      const shell = container.closest<HTMLDetailsElement>("details");
      shell?.addEventListener("toggle", () => {
        if (shell.open) window.setTimeout(() => map.invalidateSize(), 0);
      });
    } catch (e) {
      console.error(e);
      container.innerHTML =
        "<p>The map could not load. The data is at <a href=\"/public-toilets.json\">/public-toilets.json</a>.</p>";
      delete container.dataset.mapReady;
    }
  }

  for (const el of document.querySelectorAll<HTMLElement>("[data-toilets-map]")) {
    const shell = el.closest<HTMLDetailsElement>("details");
    if (shell?.open) {
      void initialiseMap(el);
    } else {
      shell?.addEventListener(
        "toggle",
        () => {
          if (shell.open) void initialiseMap(el);
        },
        { once: true },
      );
    }
  }
</script>
