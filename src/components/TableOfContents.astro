---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  variant: "mobile" | "desktop";
}

const { headings, variant } = Astro.props;
const isDesktop = variant === "desktop";
---

<details class:list={["toc", `toc--${variant}`]} open={isDesktop}>
  <summary>
    <span>In this guide</span>
    <span class="toc__toggle" aria-hidden="true"></span>
  </summary>
  <nav aria-label="In this guide">
    <ol>
      {headings.map((heading, index) => (
        <li>
          <a
            href={`#${heading.slug}`}
            data-toc-link
            class:list={{ "is-current": index === 0 }}
            aria-current={index === 0 ? "location" : undefined}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
</details>

<style>
  .toc {
    /* Declared once and consumed by both the summary's height and the
       desktop nav's max-height calc. It is `height`, not `min-height`, on
       purpose: the desktop card's cap is summary + border + list, so a
       summary that renders taller than the number used in that calc pushes
       the bottom of the card off the screen. min-height did exactly that -
       0.85rem of padding either side of a 1rem/800 line box measures
       54.375px, so the old 3.25rem (52px) reserved nothing at all and the
       card overflowed the viewport by 2px. This value IS the rendered
       height, and now cannot drift from it. */
    --toc-summary-height: 3.4rem;
    --toc-border: 2px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  summary {
    display: flex;
    height: var(--toc-summary-height);
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    cursor: pointer;
    list-style: none;
    color: var(--ink);
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 800;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .toc__toggle {
    position: relative;
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  .toc__toggle::before,
  .toc__toggle::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.8rem;
    height: 2px;
    background: var(--accent);
    content: "";
    translate: -50% -50%;
    transition: rotate var(--transition);
  }

  .toc__toggle::after {
    rotate: 90deg;
  }

  details[open] .toc__toggle::after {
    rotate: 0deg;
  }

  nav {
    padding: 0 0.85rem 0.9rem;
  }

  /* The mobile variant keeps its own cap - it sits inline above the article
     and should not push the content down by a full contents list. */
  .toc--mobile nav {
    max-height: 22rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* The desktop card is the only thing in the sidebar that pins. The column
     around it is plain flow, so this is also the only scroll container -
     which is the point: the scrollbar now belongs to the contents list, and
     scrolling it can no longer carry "In this guide" off the screen.

     `top` reads the LIVE offset so the card travels up in step with the site
     header when that slides away. No media query needed: .toc--desktop is
     already display:none below 52rem. */
  .toc--desktop {
    position: sticky;
    top: var(--sticky-top);
    /* Over the activities widget that now scrolls up beneath this card, and
       well under the site header's 90 - never raise this past that or the
       card would paint over the nav bar and its mega panel. */
    z-index: 1;
    /* Custom properties do not interpolate, so without this the card would
       snap while the header glides. Matches the header's own transition. */
    transition: top 260ms var(--ease);
  }

  /* Cap the LIST, not the card. Everything else in the card is a known fixed
     height, so bounding the nav bounds the whole thing to the viewport with
     no flex plumbing. Measured against --sticky-top-max (the header-shown
     worst case) rather than the live offset, so the card keeps a constant
     height while the bar animates and simply gains bottom clearance when it
     is away - otherwise the list would jump taller mid-slide. */
  .toc--desktop nav {
    /* So the script's offsetTop reads measure against the list itself. The
       card above is position:sticky, which would otherwise be the nearest
       positioned ancestor and shift every measurement by the summary. */
    position: relative;
    max-height: calc(
      100dvh - var(--sticky-top-max) - var(--toc-summary-height) -
        var(--toc-border) - var(--rail-gap)
    );
    overflow-y: auto;
    /* Moved down off .article__sidebar with the scrollbar. Without contain,
       hitting the end of the list chains into the document scroll. */
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc--desktop {
      transition: none;
    }
  }

  ol {
    display: grid;
    gap: 0.12rem;
    margin: 0;
    padding: 0;
    /* The rail every entry hangs off; the current marker rides it. */
    border-left: 2px solid var(--line);
    list-style: none;
  }

  a {
    position: relative;
    display: block;
    margin-left: -2px;
    padding: 0.5rem 0.65rem 0.5rem 0.85rem;
    border-left: 2px solid transparent;
    color: var(--muted);
    font-size: 0.84rem;
    font-variation-settings: "wght" 600;
    line-height: 1.35;
    text-decoration: none;
    transition:
      border-color var(--transition),
      color var(--transition);
  }

  a:hover {
    border-left-color: var(--line-strong);
    color: var(--ink);
  }

  a.is-current {
    border-left-color: var(--accent);
    color: var(--accent);
    font-variation-settings: "wght" 700;
  }

  .toc--mobile {
    display: none;
    margin-bottom: 2rem;
  }

  @media (max-width: 52rem) {
    .toc--mobile {
      display: block;
    }

    .toc--desktop {
      display: none;
    }

    .toc--mobile nav {
      max-height: 22rem;
    }

    .toc--mobile a {
      min-height: 2.6rem;
      padding-block: 0.62rem;
      font-size: 0.9rem;
    }
  }
</style>

<script>
  const tocLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
  );
  const sectionIds = [...new Set(tocLinks.map((link) => link.hash.slice(1)))];
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((section): section is HTMLElement => Boolean(section));

  let frame: number | undefined;
  let lastCurrentId: string | undefined;

  // The desktop list is capped to the viewport and scrolls internally, so on
  // a long contents (the tube lines guide runs to eighteen entries, and area
  // guides inject up to five more) the highlighted entry can sit outside the
  // visible rows - the same "where am I" problem the highlight exists to
  // solve. Nudge it back into view, writing scrollTop directly rather than
  // calling scrollIntoView, which would also scroll the page.
  const revealInList = (link: HTMLAnchorElement) => {
    const list = link.closest(".toc--desktop")?.querySelector("nav");
    if (!list || list.scrollHeight <= list.clientHeight) return;

    const top = link.offsetTop;
    const bottom = top + link.offsetHeight;

    if (top < list.scrollTop) {
      list.scrollTop = top;
    } else if (bottom > list.scrollTop + list.clientHeight) {
      list.scrollTop = bottom - list.clientHeight;
    }
  };

  const updateCurrentSection = () => {
    frame = undefined;
    let current = sections[0];

    for (const section of sections) {
      if (section.getBoundingClientRect().top <= 150) {
        current = section;
      } else {
        break;
      }
    }

    if (!current) return;

    // Guarded so the layout reads in revealInList fire on a section change,
    // not on every scroll frame.
    const changed = current.id !== lastCurrentId;
    lastCurrentId = current.id;

    tocLinks.forEach((link) => {
      const isCurrent = link.hash === `#${current.id}`;
      link.classList.toggle("is-current", isCurrent);

      if (isCurrent) {
        link.setAttribute("aria-current", "location");
        if (changed) revealInList(link);
      } else {
        link.removeAttribute("aria-current");
      }
    });
  };

  const scheduleUpdate = () => {
    if (frame !== undefined) return;
    frame = window.requestAnimationFrame(updateCurrentSection);
  };

  updateCurrentSection();
  window.addEventListener("scroll", scheduleUpdate, { passive: true });
  window.addEventListener("hashchange", updateCurrentSection);
</script>
