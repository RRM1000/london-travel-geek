---
interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  items: Breadcrumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href && index < items.length - 1 ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin-bottom: var(--space-4);
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 700;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  li:not(:last-child)::after {
    color: var(--line);
    content: "/";
  }

  a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  a:hover {
    color: var(--accent);
  }
</style>
