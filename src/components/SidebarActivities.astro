---
// The sidebar's booking unit, replacing the GetYourGuide city widget.
//
// WHY THIS EXISTS. The sidebar used to hold GYG's own `city.frame` iframe for
// London (location 57). Three problems with it: it was the same generic "London"
// promo card on all 122 guides, so a reader on the Canary Wharf guide was
// offered nothing to do with Canary Wharf; it rendered 528px tall inside a
// pinned column that could only give it 350, so 178px of it - including the
// bottom, where its own call to action sits - was cropped away; and it is a
// fifth unit on pages that balance-gyg-widgets.mjs has already given two or
// three inline widgets.
//
// This card names the activities we have actually researched for THIS guide,
// in our own words, at a height the column can hold. Every row is a real venue
// from the Activities sheet with a GetYourGuide link, so it is more specific
// than the carousel it replaces as well as shorter.
//
// It also sidesteps a standing problem: GYG's partner script rewrites the rel
// on every getyourguide.com link it finds, stripping "sponsored" - which is why
// BaseLayout runs a MutationObserver to put it back. These are plain anchors
// the script never touches, though they carry data-affiliate anyway so the
// observer covers them if that ever changes.
import data from "../data/activities.json";
// ONE PLACE FOR THE PARTNER ID - see the note at the top of that file.
import { GYG_PARTNER_ID } from "../../scripts/lib/affiliate.mjs";

interface Props {
  /** The article id, e.g. "canary-wharf-area-guide". */
  articleId: string;
  /** Place name for the heading on area guides, e.g. "Canary Wharf". */
  areaName?: string;
}

type Activity = {
  slug: string;
  name: string;
  style?: string;
  duration?: string;
  guide?: string;
  guidePlacement?: string;
  affiliateUrl?: string;
  affiliateNetwork?: string;
};

const { articleId, areaName } = Astro.props as Props;

// Only rows with something to sell. affiliate.mjs sets affiliateUrl on a
// narrow, deliberate list of activity types - a free park or a market browse
// gets no link at all - so this filter inherits that judgement rather than
// re-deciding it here.
const picks = (data.activities as Activity[])
  .filter((a) => a.guide === articleId && !!a.affiliateUrl)
  // Two, not three. This is a teaser in a pinned column with a fixed height
  // budget - a third row pushed the card to 376px against the 288px the column
  // could give it, and it overflowed. "More on GetYourGuide" carries the rest.
  .slice(0, 2);

// London's own city page on GetYourGuide - l57 is the same location id the old
// widget used.
const londonUrl = `https://www.getyourguide.com/london-l57/?partner_id=${GYG_PARTNER_ID}`;
const heading = areaName ? `Book in ${areaName}` : "Book things to do";
---

<aside class="sidebar-book" aria-labelledby="sidebar-book-title">
  <p class="sidebar-book__eyebrow">Tickets &amp; tours</p>
  <p class="sidebar-book__title" id="sidebar-book-title">{heading}</p>

  {picks.length > 0 ? (
    <ul class="sidebar-book__list">
      {picks.map((a) => (
        <li>
          <a
            href={a.affiliateUrl}
            rel="sponsored nofollow noopener"
            target="_blank"
            data-affiliate={a.affiliateNetwork}
          >
            <span class="sidebar-book__name">{a.name}</span>
            {a.style && <span class="sidebar-book__style">{a.style}</span>}
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="sidebar-book__fallback">
      Tours, tickets and experiences across the city, with free cancellation on
      most of them.
    </p>
  )}

  <a
    class="sidebar-book__more"
    href={londonUrl}
    rel="sponsored nofollow noopener"
    target="_blank"
    data-affiliate="getyourguide"
  >
    {picks.length > 0 ? "More on GetYourGuide" : "Browse on GetYourGuide"}
    <span class="sidebar-book__ad">ad</span>
  </a>
</aside>

<style>
  /* The one dark block in a column of warm paper, so it reads as an offer
     rather than more page furniture. This is the house treatment for a
     standout card - see NewsletterBox: --ink ground, --bg text, the amber
     highlight for the eyebrow and the button. Amber only ever sits on dark
     ground in this palette, which is exactly what this card is. */
  .sidebar-book {
    padding: 1rem 1.1rem 1.1rem;
    border-radius: var(--card-radius);
    background:
      radial-gradient(
        120% 100% at 100% 0%,
        var(--chrome-soft) 0%,
        transparent 60%
      ),
      var(--ink);
    color: var(--bg);
    box-shadow: var(--shadow-md);
  }

  .sidebar-book__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.15rem;
    color: var(--highlight);
    font-size: 0.68rem;
    font-variation-settings: "wght" 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .sidebar-book__title {
    margin: 0 0 0.8rem;
    color: var(--bg);
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .sidebar-book__eyebrow::before {
    width: 1.15rem;
    height: 1.15rem;
    flex: 0 0 auto;
    background: currentColor;
    content: "";
    /* Ticket glyph, masked so it takes the amber above rather than shipping
       a second colour to keep in sync. */
    -webkit-mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v14"/></svg>')
      center / contain no-repeat;
    mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v14"/></svg>')
      center / contain no-repeat;
  }

  .sidebar-book__list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sidebar-book__list li {
    padding-bottom: 0.6rem;
    border-bottom: 1px solid color-mix(in srgb, var(--bg) 16%, transparent);
  }

  .sidebar-book__list li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .sidebar-book__list a {
    display: grid;
    gap: 0.12rem;
    text-decoration: none;
  }

  .sidebar-book__name {
    color: var(--bg);
    font-size: 0.87rem;
    font-variation-settings: "wght" 700;
    line-height: 1.3;
  }

  .sidebar-book__list a:hover .sidebar-book__name {
    color: var(--highlight);
  }

  .sidebar-book__style,
  .sidebar-book__fallback {
    color: color-mix(in srgb, var(--bg) 68%, transparent);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .sidebar-book__fallback {
    margin: 0 0 0.85rem;
  }

  /* Amber button on ink, the same pairing the newsletter card uses. */
  .sidebar-book__more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.9rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.55rem;
    background: var(--highlight);
    color: var(--ink);
    font-size: 0.78rem;
    font-variation-settings: "wght" 800;
    text-decoration: none;
    transition:
      background var(--transition),
      translate var(--transition);
  }

  .sidebar-book__more:hover {
    background: color-mix(in srgb, var(--highlight) 82%, #ffffff);
    translate: 0 -1px;
  }

  /* Disclosure marker, same wording as the in-article activity links but
     toned for the dark ground rather than the page. */
  .sidebar-book__ad {
    padding: 0.05rem 0.25rem;
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--ink) 22%, transparent);
    color: color-mix(in srgb, var(--ink) 70%, transparent);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-book__more {
      transition: none;
    }

    .sidebar-book__more:hover {
      translate: none;
    }
  }
</style>
