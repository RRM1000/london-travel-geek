---
// Things to do in an area, injected into every area guide automatically.
//
// Matches on the guide's own id, so a new row in the Activities tab appears on
// the right page with no edit to the markdown. A guide with no activity rows
// renders nothing at all rather than an empty heading.
import data from "../data/activities.json";
import { sheetPhotos } from "../lib/sheetPhotos";
import tourData from "../../data/gyg-tours.json";
import { GYG_PARTNER_ID } from "../../scripts/lib/affiliate.mjs";

interface Props {
  /** The article id, e.g. "shoreditch-area-guide". */
  articleId: string;
  /** Place name for the heading, e.g. "Shoreditch". */
  areaName: string;
}
const { articleId, areaName } = Astro.props as Props;

type Activity = {
  slug: string; name: string; type?: string; style?: string;
  area?: string; station?: string; walkMin?: number;
  agePolicy?: string; seasonal?: string; duration?: string;
  price?: string; booking?: string; opNote?: string; guidePlacement?: string;
  whyGo?: string; website?: string; bookingUrl?: string;
  // Not sheet columns: export-activities.mjs generates these from
  // lib/affiliate.mjs, so only the rows with something to sell carry them.
  affiliateUrl?: string; affiliateNetwork?: string;
};

// guidePlacement "prose" means this guide's own hand-written text already
// covers the venue, so listing it here would print it twice on one page - the
// bug Neal's Yard, Seven Dials Market and the Guinness brewery all had. The row
// still appears in /things-to-do, the filters, the maps and search; it is only
// this one page's auto-list that stands down. See write-activities.mjs.
const onGuide = (data.activities as Activity[]).filter((a: any) => a.guide === articleId);
const all = onGuide.filter((a: any) => a.guidePlacement !== "prose");

// Free things first — they are the ones readers most often do not know about,
// and the ones the local guides lead with.
const isFree = (a: Activity) => /free/i.test(a.price ?? "");
const list = [...all].sort((a, b) => {
  const f = Number(isFree(b)) - Number(isFree(a));
  return f !== 0 ? f : a.name.localeCompare(b.name);
});

// Only the age policies worth warning about. "all-ages" needs no label.
// ONE live booking widget per guide, for the strongest venue we have a
// verified GetYourGuide tour for.
//
// Not one per venue: the widget is ~370px tall, and a list of eight of them
// would bury the writing it is meant to sit alongside. Not in the sidebar
// either - at 320px wide it renders 574px, taller than the column can give.
// So: the single best tour on the page, below the list, where a reader who
// has just read about the place can act on it.
//
// "Best" is review count. It is the honest proxy for whether a reader will
// recognise and trust the thing - the London Eye's 39,200 reviews against
// Cutty Sark's 370 - and it is the same measure that separated the real
// matches from the false ones when these were chosen. See data/gyg-tours.json.
const TOURS = (tourData as any).tours as Record<
  string,
  { tourId: string; title: string; rating?: number; reviews?: number }
>;

const AGE_LABEL: Record<string, string> = {
  "over-18": "18+",
  "over-16": "16+",
  "adults-only": "Adults only",
  "over-18-evenings": "18+ in the evening",
};
const SEASON_LABEL: Record<string, string> = {
  "winter-only": "Winter only",
  "summer-only": "Summer only",
  seasonal: "Seasonal",
};

// Chosen from onGuide, not from list: the "prose" rule above suppresses a
// venue the guide already writes about, so it is not PRINTED twice - but the
// Tower of London and St Paul's are exactly the venues a City of London
// reader most wants to book, and neither would ever get a widget otherwise.
// The rule is about duplicate listings, not about suppressing the booking.
const featured = onGuide
  .filter((a) => TOURS[a.slug] && !a.bookingUrl)
  .sort((x, y) => (TOURS[y.slug].reviews ?? 0) - (TOURS[x.slug].reviews ?? 0))[0];
const featuredTour = featured ? TOURS[featured.slug] : undefined;

// Photos are matched by slug from the assets tree - see lib/sheetPhotos. Most
// rows have none, and a card without one is the normal layout rather than a
// gap: the grid collapses to a single column when there is nothing to show.
const photos = await sheetPhotos(list.map((a) => a.slug));
---

{list.length > 0 && (
  <section class="area-activities">
    <h2 id="things-to-do">Things to do in {areaName}</h2>
    <p class="aa-intro">
      Beyond eating and drinking. Free things are listed first.
      <span class="aa-disclosure">
        Links marked <span class="aa-ad">ad</span> are affiliate links. If you
        book through one we may earn a commission, at no extra cost to you. It
        never affects what goes on this list.
      </span>
    </p>

    <ul class="aa-list">
      {list.map((a) => (
        <li class:list={["aa-item", photos.has(a.slug) && "aa-item--photo"]}>
          {photos.has(a.slug) && (
            <img
              class="aa-photo"
              src={photos.get(a.slug)!.src}
              srcset={photos.get(a.slug)!.srcset}
              sizes={photos.get(a.slug)!.sizes}
              width={photos.get(a.slug)!.width}
              height={photos.get(a.slug)!.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          )}
          <div class="aa-body">
          <div class="aa-head">
            <h3>{a.name}</h3>
            {isFree(a) && <span class="aa-tag aa-free">Free</span>}
            {a.agePolicy && AGE_LABEL[a.agePolicy] && (
              <span class="aa-tag aa-age">{AGE_LABEL[a.agePolicy]}</span>
            )}
            {a.seasonal && SEASON_LABEL[a.seasonal] && (
              <span class="aa-tag aa-season">{SEASON_LABEL[a.seasonal]}</span>
            )}
          </div>

          <p class="aa-meta">
            {a.style && <span>{a.style}</span>}
            {a.duration && <span>{a.duration}</span>}
            {a.price && !isFree(a) && <span>{a.price}</span>}
            {a.booking === "required" && <span>Book ahead</span>}
            {a.station && a.walkMin && <span>{a.walkMin} min from {a.station}</span>}
          </p>

          {a.whyGo && <p class="aa-why">{a.whyGo}</p>}
          {a.opNote && <p class="aa-note">{a.opNote}</p>}

          {(a.bookingUrl || a.affiliateUrl || a.website) && (
            <p class="aa-links">
              {a.bookingUrl && (
                <a href={a.bookingUrl} rel="nofollow noopener" target="_blank">Book direct</a>
              )}
              {!a.bookingUrl && a.affiliateUrl && (
                <a href={a.affiliateUrl} rel="sponsored nofollow noopener" target="_blank" data-affiliate={a.affiliateNetwork}>
                  Check tickets on GetYourGuide<span class="aa-ad">ad</span>
                </a>
              )}
              {a.website && !a.bookingUrl && (
                <a href={a.website} rel="nofollow noopener" target="_blank">Website</a>
              )}
            </p>
          )}
          </div>
        </li>
      ))}
    </ul>

    {featured && featuredTour && (
      <div class="aa-book">
        <p class="aa-book__head">
          Book {featured.name}
          <span class="aa-ad">ad</span>
        </p>
        {featuredTour.rating && featuredTour.reviews ? (
          <p class="aa-book__meta">
            {featuredTour.rating} out of 5 on GetYourGuide, from{" "}
            {featuredTour.reviews.toLocaleString("en-GB")} reviews. Live dates and
            prices below.
          </p>
        ) : (
          <p class="aa-book__meta">Live dates and prices below.</p>
        )}
        {/*
          The partner script rewrites this into an iframe. data-gyg-cmp tags the
          booking to this guide so it lands on its own row in the Campaigns
          report rather than in no_reseller_campaign.
        */}
        <div
          data-gyg-href="https://widget.getyourguide.com/default/availability.frame"
          data-gyg-tour-id={featuredTour.tourId}
          data-gyg-locale-code="en-GB"
          data-gyg-widget="availability"
          data-gyg-partner-id={GYG_PARTNER_ID}
          data-gyg-cmp={`${articleId}-availability`}
        ></div>
      </div>
    )}
  </section>
)}

<style>
  .area-activities { margin-block: 3rem 2rem; }

  /* The booking block reads as an offer, not as another list item, so it gets
     the surface treatment the rest of the list does not. */
  .aa-book {
    margin-top: 2rem;
    padding: 1.1rem 1.2rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--card-radius);
    background: var(--surface-strong);
  }

  .aa-book__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.3rem;
    color: var(--ink);
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 800;
  }

  .aa-book__meta {
    margin: 0 0 0.9rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .aa-book :global(iframe) {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 0;
  }
  .aa-intro { margin: 0 0 1.5rem; opacity: 0.8; }
  .aa-disclosure { display: block; margin-block-start: 0.5rem; font-size: 0.85rem; }
  /* ul.<class>, not just .<class>: ArticleLayout sets
     `.article__body :global(ul) { list-style: disc }`, which ties this on
     specificity and wins on source order. Both the section class AND the
     element are needed - ul.<class> alone still only TIES, because Astro adds
     its scope attribute to both rules. These are cards, not bullets. */
  .area-activities ul.aa-list {
    list-style: none;
    margin: 0;
    padding-left: 0;
    display: grid;
    gap: 1.5rem;
  }
  .aa-item { border-block-end: 1px solid var(--color-border, #e2e2e2); padding-block-end: 1.5rem; }
  /* A card only becomes two columns when it actually has a photo, so rows
     without one keep the exact layout they had before this existed.
     Scoped through .area-activities .aa-list for the SAME reason ul.aa-list is
     above: ArticleLayout's global list styling in .article__body otherwise wins
     and holds these at display:list-item, which silently kills the grid. */
  .area-activities .aa-list > .aa-item--photo {
    display: grid; grid-template-columns: 14rem 1fr; gap: 1.25rem; align-items: start;
  }
  .aa-photo {
    width: 100%; height: 100%; max-height: 11rem;
    object-fit: cover; border-radius: var(--card-radius, 0.5rem);
    background: var(--surface, #f2f2f2);
  }
  @media (max-width: 40rem) {
    .area-activities .aa-list > .aa-item--photo { grid-template-columns: 1fr; }
    .aa-photo { max-height: 13rem; }
  }
  .aa-list > .aa-item:last-child { border-block-end: 0; padding-block-end: 0; }
  .aa-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
  .aa-head h3 { margin: 0; font-size: 1.1rem; }
  .aa-tag {
    font-size: 0.7rem; letter-spacing: 0.04em; text-transform: uppercase;
    padding: 0.1rem 0.45rem; border-radius: 3px; border: 1px solid currentColor;
  }
  .aa-free { color: var(--color-accent, #1f5d4c); }
  .aa-age, .aa-season { opacity: 0.8; }
  .aa-meta { display: flex; flex-wrap: wrap; gap: 0.35rem 0.9rem; margin: 0.35rem 0 0; font-size: 0.85rem; opacity: 0.75; }
  .aa-why { margin: 0.5rem 0 0; }
  .aa-note { margin: 0.4rem 0 0; font-size: 0.9rem; opacity: 0.85; }
  .aa-links { display: flex; flex-wrap: wrap; gap: 0.9rem; margin: 0.5rem 0 0; font-size: 0.9rem; }
  /* The "ad" marker is required, not decorative. UK CAP rules want a
     commercial relationship identifiable BEFORE the click, so it rides on the
     link itself rather than only living in a disclosure line further down. */
  .aa-ad {
    margin-inline-start: 0.35rem;
    padding: 0.05rem 0.3rem;
    border: 1px solid currentColor;
    border-radius: 3px;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: 0.1em;
    opacity: 0.7;
  }
</style>
