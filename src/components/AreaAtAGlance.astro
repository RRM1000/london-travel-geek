---
import { lineBadge } from "../lib/tubeLines";

interface Station {
  name: string;
  lines: string[];
}

interface Props {
  zone: string;
  vibe: string;
  walkability: number;
  timeNeeded: string;
  budget: string;
  bestDay: string;
  bestFor: string[];
  nearestStations: Station[];
}

const {
  zone,
  vibe,
  walkability,
  timeNeeded,
  budget,
  bestDay,
  bestFor,
  nearestStations,
} = Astro.props;

const walkabilityLabel = `${walkability} out of 5`;
---

<section class="at-a-glance" aria-labelledby="at-a-glance-title">
  <header class="at-a-glance__head">
    <h2 id="at-a-glance-title" class="at-a-glance__title">At a glance</h2>
  </header>

  <dl class="at-a-glance__grid">
    <div class="at-a-glance__item at-a-glance__item--wide">
      <dt>Vibe</dt>
      <dd>{vibe}</dd>
    </div>
    <div class="at-a-glance__item">
      <dt>Time needed</dt>
      <dd class="at-a-glance__stat">{timeNeeded}</dd>
    </div>
    <div class="at-a-glance__item">
      <dt>Best day</dt>
      <dd>{bestDay}</dd>
    </div>
    <div class="at-a-glance__item">
      <dt>Travel zone</dt>
      <dd class="at-a-glance__stat at-a-glance__stat--big">{zone}</dd>
    </div>
    <div class="at-a-glance__item">
      <dt>Walkability</dt>
      <dd>
        <span class="at-a-glance__meter" role="img" aria-label={walkabilityLabel}>
          {Array.from({ length: 5 }, (_, index) => (
            <span
              class:list={[
                "at-a-glance__pip",
                index < walkability && "at-a-glance__pip--on",
              ]}
              aria-hidden="true"
            ></span>
          ))}
        </span>
        <span class="at-a-glance__meter-value">{walkability}/5</span>
      </dd>
    </div>
    <div class="at-a-glance__item">
      <dt>Typical spend</dt>
      <dd class="at-a-glance__stat at-a-glance__stat--big">{budget}</dd>
    </div>
  </dl>

  <div class="at-a-glance__lists">
    <div>
      <p class="at-a-glance__label">Best for</p>
      <ul class="at-a-glance__tags">
        {bestFor.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div>
      <p class="at-a-glance__label">Nearest stations</p>
      <ul class="at-a-glance__stations">
        {nearestStations.map((station) => {
          const badges = station.lines.map(lineBadge);
          const notes = badges.map((b) => b.note).filter(Boolean);
          return (
            <li>
              <span class="at-a-glance__roundel" aria-hidden="true"></span>
              <span class="at-a-glance__station-body">
                <strong>{station.name}</strong>
                <span class="at-a-glance__lines">
                  {badges.map((b) =>
                    b.bg ? (
                      <span class="at-a-glance__line" style={`background:${b.bg};color:${b.ink}`}>{b.label}</span>
                    ) : (
                      <span class="at-a-glance__line at-a-glance__line--neutral">{b.label}</span>
                    ),
                  )}
                </span>
                {notes.length > 0 && (
                  <span class="at-a-glance__station-note">{notes.join(" · ")}</span>
                )}
              </span>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Selectors are deliberately compounded with the block class. The article
     prose rules in ArticleLayout are written as `.article__body :global(ul)`,
     which compiles to specificity 0,2,1 and would otherwise beat the single
     scoped class this component would normally need. */
  .at-a-glance {
    overflow: hidden;
    margin: var(--space-5) 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .at-a-glance .at-a-glance__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.1rem var(--space-4) 0;
  }

  /* The rule runs from the title to the card edge - a labelled divider,
     not a floating caption. */
  .at-a-glance .at-a-glance__head::after {
    flex: 1;
    height: 1px;
    background: var(--line);
    content: "";
  }

  .at-a-glance .at-a-glance__title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--ink);
    font-family: var(--body);
    font-size: 0.76rem;
    font-variation-settings: "wght" 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* A little roundel in front of the title - the one decorative note. */
  .at-a-glance .at-a-glance__title::before {
    width: 0.6rem;
    height: 0.6rem;
    border: 2.5px solid var(--accent);
    border-radius: 50%;
    content: "";
  }

  .at-a-glance .at-a-glance__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4) var(--space-4);
    margin: 0;
    padding: var(--space-4);
  }

  .at-a-glance .at-a-glance__item dt {
    color: var(--muted);
    font-size: 0.7rem;
    font-variation-settings: "wght" 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .at-a-glance .at-a-glance__item dd {
    margin: 0.3rem 0 0;
    font-size: 0.97rem;
    font-variation-settings: "wght" 550;
    line-height: 1.45;
  }

  /* Hard stats get the display face - they should read like numbers on a
     departure board, not body copy. */
  .at-a-glance .at-a-glance__stat {
    font-family: var(--display);
    font-variation-settings: "opsz" 30, "wght" 560;
    font-size: 1.25rem;
    line-height: 1.15;
  }

  .at-a-glance .at-a-glance__stat--big {
    font-size: 1.7rem;
    color: var(--ink);
  }

  .at-a-glance__meter {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    vertical-align: middle;
  }

  .at-a-glance__pip {
    width: 1.05rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--surface-strong);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .at-a-glance__pip--on {
    background: var(--accent);
    box-shadow: none;
  }

  .at-a-glance .at-a-glance__meter-value {
    margin-left: 0.5rem;
    color: var(--muted);
    font-size: 0.88rem;
    font-variation-settings: "wght" 650;
  }

  /* Footer band: tinted, so the card reads as stats-above, lists-below. */
  .at-a-glance .at-a-glance__lists {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    padding: var(--space-4);
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface-strong) 42%, var(--surface));
  }

  .at-a-glance .at-a-glance__label {
    margin: 0 0 0.65rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-variation-settings: "wght" 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .at-a-glance .at-a-glance__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .at-a-glance .at-a-glance__tags li {
    display: inline-block;
    padding: 0.28rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.84rem;
    font-variation-settings: "wght" 600;
  }

  .at-a-glance .at-a-glance__stations {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .at-a-glance .at-a-glance__stations li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .at-a-glance .at-a-glance__stations li::marker {
    content: none;
  }

  .at-a-glance .at-a-glance__roundel {
    flex: 0 0 auto;
    width: 0.55rem;
    height: 0.55rem;
    border: 2px solid var(--accent);
    border-radius: 50%;
    translate: 0 -1px;
  }

  .at-a-glance .at-a-glance__station-body {
    display: grid;
    gap: 0.3rem;
  }

  .at-a-glance .at-a-glance__station-body strong {
    font-variation-settings: "wght" 700;
  }

  .at-a-glance .at-a-glance__lines {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  /* Official line colours arrive inline from lib/tubeLines - brand colours,
     so they deliberately do not change with the theme. */
  .at-a-glance .at-a-glance__line {
    padding: 0.14em 0.5em;
    border-radius: 4px;
    font-size: 0.68rem;
    font-variation-settings: "wght" 750;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* Train operators without a colour in the token set - honest neutral
     rather than a guessed brand colour. */
  .at-a-glance .at-a-glance__line--neutral {
    border: 1px solid var(--line);
    background: var(--surface-strong);
    color: var(--ink-soft, var(--ink));
  }

  .at-a-glance .at-a-glance__station-note {
    color: var(--muted);
    font-size: 0.78rem;
  }

  @media (max-width: 48rem) {
    .at-a-glance .at-a-glance__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .at-a-glance .at-a-glance__item--wide {
      grid-column: 1 / -1;
    }

    .at-a-glance .at-a-glance__lists {
      grid-template-columns: 1fr;
    }
  }
</style>
