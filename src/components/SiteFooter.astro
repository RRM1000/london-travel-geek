---
import type { SiteConfig } from "../sites";
import SiteLogo from "./SiteLogo.astro";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
const year = new Date().getFullYear();

// The primary nav doubles as the footer topic list - one source of truth.
const topicLinks = site.navigation.map(({ label, href }) => ({ label, href }));
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <SiteLogo site={site} variant="dark" />
        <p>{site.description}</p>
      </div>
      <nav class="footer__col" aria-label="Footer topics">
        <p class="footer__heading">Explore</p>
        <ul>
          {topicLinks.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <nav class="footer__col" aria-label="Footer">
        <p class="footer__heading">Site</p>
        <ul>
          {site.footerNavigation.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="footer__base">
      <p>&copy; {year} {site.name}. Independent guides.</p>
      <p>
        Details are checked regularly, but always confirm live travel
        information before setting out.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: var(--space-7) var(--space-5);
    background: var(--chrome);
    color: var(--chrome-text);
  }

  /* A thin roundel-red rule where the paper meets the ink. */
  .footer::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 3px;
    background: var(--accent);
    content: "";
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.7fr) minmax(0, 0.7fr);
    align-items: start;
    gap: var(--space-6);
  }

  .footer__brand {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
  }

  .footer__brand p {
    max-width: 26rem;
    color: var(--chrome-muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .footer__heading {
    margin-bottom: 0.9rem;
    color: var(--highlight);
    font-size: 0.74rem;
    font-variation-settings: "wght" 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .footer__col ul {
    display: grid;
    gap: 0.5rem;
  }

  .footer__col a {
    color: var(--chrome-text);
    font-size: 0.95rem;
    font-variation-settings: "wght" 550;
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer__col a:hover {
    color: #ffffff;
    text-decoration: underline;
    text-decoration-color: var(--highlight);
    text-underline-offset: 0.25em;
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, var(--chrome-text) 14%, transparent);
  }

  .footer__base p {
    color: var(--chrome-muted);
    font-size: 0.82rem;
  }

  @media (max-width: 42rem) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
