---
// The walking route for notting-hill-colourful-houses.md, injected by
// ArticleLayout the same way PublicToiletsMap is.
//
// WHY NOT AreaMap: that component plots everything the sheets know about an
// area as unordered category pins. This guide is a route - the order is the
// content, because the whole problem with Notting Hill's pastel streets is
// that they are scattered across a mile and people walk the same 200 metres of
// Portobello Road and go home. So the stops are numbered, joined in sequence,
// and the numbering is the same in the map, the list below it and the headings
// in the article body.
//
// Coordinates are where the photographs in this guide were actually taken,
// read from their EXIF - not looked-up street centroids. For a "stand here"
// map that is the more useful number, and it is the one thing a phone gets
// right even when it cannot name the road.
const STOPS = [
  { n: 1, name: "Hillgate Place", lat: 51.5081, lng: -0.1963,
    note: "The best of the four, and the one to see first" },
  { n: 2, name: "Farmer Street", lat: 51.5086, lng: -0.1971,
    note: "Blue, pink and cream in a row" },
  { n: 3, name: "Hillgate Street", lat: 51.5079, lng: -0.1973,
    note: "Long view down the pastels" },
  { n: 4, name: "Jameson Street", lat: 51.5078, lng: -0.1960,
    note: "Pink corner house" },
  { n: 5, name: "Lansdowne Road", lat: 51.5130, lng: -0.2077,
    note: "Bigger, grander, softer colours" },
  { n: 6, name: "Elgin Crescent", lat: 51.5132, lng: -0.2095,
    note: "Butter yellow and powder blue stucco" },
  { n: 7, name: "Lancaster Road", lat: 51.5177, lng: -0.2054,
    note: "The postcard row - strongest colours of the lot" },
];
// PAINTED HOUSES ONLY. Portobello Road and Rosmead Road were both on this list
// and are both off it: Portobello's colour is shopfronts, and Rosmead earns its
// visitors with a locked film-location garden gate. Neither is a coloured
// house, and a route called one thing should not quietly be a route to
// something else. They live in the Notting Hill area guide and the filming
// locations guide respectively.
---

<section class="streets-map" aria-labelledby="streets-map-title">
  <h2 id="streets-map-title">Map of the route</h2>
  <p class="streets-map-intro">
    Seven streets in walking order, from Notting Hill Gate to Ladbroke Grove.
    About 2km end to end, or an hour with stopping.
  </p>

  <details class="restaurant-map-shell">
    <summary>
      Open the map
      <small>{STOPS.length} streets · Notting Hill Gate to Ladbroke Grove</small>
    </summary>
    <div class="restaurant-map" data-streets-map>
      <p>The map loads when you open this section.</p>
    </div>
  </details>

  <ol class="streets-map-list">
    {STOPS.map((s) => (
      <li>
        <span class="streets-map-num" aria-hidden="true">{s.n}</span>
        <span><strong>{s.name}</strong> — {s.note}</span>
      </li>
    ))}
  </ol>

  {/* is:inline - a JSON data island, not a script to bundle. */}
  <script is:inline type="application/json" data-streets-map-data set:html={JSON.stringify(STOPS)} />
</section>

<style>
  .streets-map :global(h2) { scroll-margin-top: 2rem; }
  .streets-map-intro { margin: 0 0 0.75rem; }

  .streets-map-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .streets-map-list li {
    display: grid;
    grid-template-columns: 1.65rem 1fr;
    gap: 0.6rem;
    align-items: baseline;
  }
  .streets-map-num {
    display: inline-block;
    width: 1.65rem;
    height: 1.65rem;
    line-height: 1.65rem;
    text-align: center;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
  }

  /* Leaflet injects marker markup at runtime, so the numbered pin has to be
     :global. Shape comes from .restaurant-map-marker in ArticleLayout; the
     number and the fill are ours. */
  :global(.streets-map-marker) {
    background: var(--accent);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.55;
    text-align: center;
  }
</style>

<script>
  type Leaflet = {
    map: (element: HTMLElement, options?: Record<string, unknown>) => any;
    tileLayer: (url: string, options?: Record<string, unknown>) => any;
    divIcon: (options: Record<string, unknown>) => any;
    marker: (position: [number, number], options?: Record<string, unknown>) => any;
    polyline: (positions: [number, number][], options?: Record<string, unknown>) => any;
    latLngBounds: (positions: [number, number][]) => any;
  };

  const leafletWindow = window as Window & { L?: Leaflet };
  let leafletPromise: Promise<Leaflet> | undefined;

  // Same lazy-load contract as ArticleLayout and AreaMap: Leaflet is fetched on
  // first open, never on page load, and whichever loader runs first wins.
  const loadLeaflet = () => {
    if (leafletWindow.L) return Promise.resolve(leafletWindow.L);
    if (leafletPromise) return leafletPromise;

    leafletPromise = new Promise<Leaflet>((resolve, reject) => {
      if (!document.querySelector("link[data-leaflet-styles]")) {
        const stylesheet = document.createElement("link");
        stylesheet.rel = "stylesheet";
        stylesheet.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
        stylesheet.dataset.leafletStyles = "";
        document.head.append(stylesheet);
      }

      const existingScript = document.querySelector<HTMLScriptElement>(
        "script[data-leaflet-script]",
      );

      const finish = () => {
        if (leafletWindow.L) resolve(leafletWindow.L);
        else reject(new Error("Leaflet did not load."));
      };

      if (existingScript) {
        existingScript.addEventListener("load", finish, { once: true });
        existingScript.addEventListener("error", reject, { once: true });
        return;
      }

      const script = document.createElement("script");
      script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
      script.dataset.leafletScript = "";
      script.addEventListener("load", finish, { once: true });
      script.addEventListener("error", reject, { once: true });
      document.head.append(script);
    });

    return leafletPromise;
  };

  type Stop = { n: number; name: string; lat: number; lng: number; note: string };

  const createPopup = (stop: Stop) => {
    const content = document.createElement("div");
    content.className = "restaurant-map-popup";

    const name = document.createElement("strong");
    name.textContent = `${stop.n}. ${stop.name}`;
    content.append(name);

    const details = document.createElement("span");
    details.textContent = stop.note;
    content.append(details);

    const links = document.createElement("span");
    const mapLink = document.createElement("a");
    mapLink.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
      `${stop.name}, Notting Hill, London`,
    )}`;
    mapLink.target = "_blank";
    mapLink.rel = "noopener noreferrer";
    mapLink.textContent = "Open in Google Maps";
    links.append(mapLink);
    content.append(links);

    return content;
  };

  const initialise = async (element: HTMLElement, stops: Stop[]) => {
    if (element.dataset.mapReady === "true") return;
    element.dataset.mapReady = "true";

    try {
      const L = await loadLeaflet();
      element.replaceChildren();

      const map = L.map(element, { scrollWheelZoom: false });
      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      }).addTo(map);

      const positions = stops.map((s) => [s.lat, s.lng] as [number, number]);

      // Dashed, because it is the ORDER that is being drawn, not the pavement.
      // A solid line would read as a turn-by-turn route and send people down
      // whichever street the straight segment happens to cross.
      L.polyline(positions, {
        color: "#6941c6",
        weight: 3,
        opacity: 0.75,
        dashArray: "6 8",
      }).addTo(map);

      for (const stop of stops) {
        const icon = L.divIcon({
          className: "restaurant-map-marker-wrap",
          html: `<span class="restaurant-map-marker streets-map-marker">${stop.n}</span>`,
          iconSize: [26, 34],
          iconAnchor: [13, 34],
          popupAnchor: [0, -30],
        });

        L.marker([stop.lat, stop.lng], { icon, title: stop.name, alt: stop.name })
          .addTo(map)
          .bindPopup(createPopup(stop));
      }

      map.fitBounds(L.latLngBounds(positions), { padding: [28, 28], maxZoom: 16 });

      const shell = element.closest<HTMLDetailsElement>("details");
      shell?.addEventListener("toggle", () => {
        if (shell.open) window.setTimeout(() => map.invalidateSize(), 0);
      });
    } catch {
      element.innerHTML =
        "<p>The map could not load. Every stop on it is listed underneath in the same order.</p>";
      delete element.dataset.mapReady;
    }
  };

  for (const element of document.querySelectorAll<HTMLElement>("[data-streets-map]")) {
    const section = element.closest("section");
    const dataTag = section?.querySelector<HTMLScriptElement>("[data-streets-map-data]");
    if (!dataTag?.textContent) continue;

    let stops: Stop[];
    try {
      stops = JSON.parse(dataTag.textContent);
    } catch {
      continue;
    }

    const shell = element.closest<HTMLDetailsElement>("details");
    if (shell?.open) {
      void initialise(element, stops);
    } else {
      shell?.addEventListener(
        "toggle",
        () => { if (shell.open) void initialise(element, stops); },
        { once: true },
      );
    }
  }
</script>
