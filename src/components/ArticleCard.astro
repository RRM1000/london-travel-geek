---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  label?: string;
  title?: string;
  description?: string;
  href?: string;
  empty?: boolean;
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  label = "Article",
  title = "Article title",
  description = "Article summary will appear here.",
  href = "#",
  empty = false,
  image,
  imageAlt = "",
} = Astro.props;
---

<article class:list={["article-card", { slot: empty }]}>
  <div class="article-card__image" aria-hidden={image ? undefined : "true"}>
    {image ? (
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 720, 960]}
        sizes="(max-width: 48rem) 100vw, 33vw"
        loading="lazy"
      />
    ) : (
      <span class="article-card__monogram">{label.slice(0, 2).toUpperCase()}</span>
    )}
  </div>
  <div class="article-card__body">
    <p class="eyebrow">{empty ? "Content slot" : label}</p>
    <h3>{empty ? "Article card" : title}</h3>
    <p>{empty ? "Connect this component to an article collection." : description}</p>
    {!empty && <a href={href} aria-label={`Read ${title}`}>Read article →</a>}
  </div>
</article>

<style>
  .article-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--card-radius);
    background: var(--surface);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 5%, transparent);
  }

  .article-card__image {
    display: grid;
    aspect-ratio: 16 / 9;
    place-items: center;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--accent) 14%, var(--surface)), var(--surface-strong));
  }

  .article-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-card__monogram {
    display: grid;
    width: 4.5rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 50%;
    color: var(--accent);
    font-family: var(--display);
    font-size: 1.65rem;
    font-weight: 800;
    box-shadow:
      -1.2rem 0 0 -0.08rem var(--surface),
      -1.2rem 0 0 0.03rem color-mix(in srgb, var(--accent) 28%, transparent),
      1.2rem 0 0 -0.08rem var(--surface),
      1.2rem 0 0 0.03rem color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .article-card__body {
    display: grid;
    gap: 0.65rem;
    padding: var(--space-4);
  }

  .article-card__body > p:not(.eyebrow) {
    color: var(--muted);
    font-size: 0.94rem;
  }

  a {
    width: fit-content;
    margin-top: 0.25rem;
    color: var(--accent);
    font-weight: 800;
  }
</style>
