---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatTag } from "../lib/taxonomy";

interface Props {
  label?: string;
  title?: string;
  description?: string;
  href?: string;
  empty?: boolean;
  image?: ImageMetadata;
  imageAlt?: string;
  tags?: string[];
}

const {
  label = "Article",
  title = "Article title",
  description = "Article summary will appear here.",
  href = "#",
  empty = false,
  image,
  imageAlt = "",
  tags = [],
} = Astro.props;

const TagElement = empty ? "div" : "a";
---

<TagElement class:list={["article-card", { slot: empty }]} href={empty ? undefined : href}>
  <div class="article-card__image" aria-hidden={image ? undefined : "true"}>
    {image ? (
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 720, 960]}
        sizes="(max-width: 48rem) 100vw, 33vw"
        loading="lazy"
      />
    ) : (
      <span class="article-card__monogram">{label.slice(0, 2).toUpperCase()}</span>
    )}
  </div>
  <div class="article-card__body">
    <p class="eyebrow">{empty ? "Content slot" : label}</p>
    <h3 class="article-card__title">{empty ? "Article card" : title}</h3>
    <p class="article-card__description">{empty ? "Connect this component to an article collection." : description}</p>
    
    <div class="article-card__footer">
      {!empty && tags.length > 0 && (
        <ul class="article-card__tags" aria-label={`Tags for ${title}`}>
          {tags.slice(0, 4).map((tag) => <li class="article-card__tag">{formatTag(tag)}</li>)}
        </ul>
      )}
      {!empty && <span class="article-card__read-more">Read article &rarr;</span>}
    </div>
  </div>
</TagElement>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--card-radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 5%, transparent);
    transition: box-shadow var(--transition), translate var(--transition);
    cursor: pointer;
  }

  .article-card__image {
    display: grid;
    min-height: 0;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    place-items: center;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--accent) 14%, var(--surface)), var(--surface-strong));
  }

  .article-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--transition), filter var(--transition);
  }

  .article-card:hover {
    translate: 0 -0.2rem;
    box-shadow: 0 0.85rem 2rem rgb(15 39 54 / 0.13);
  }

  .article-card:hover .article-card__image :global(img) {
    scale: 1.035;
    filter: saturate(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card,
    .article-card__image :global(img) {
      transition: none;
    }
  }

  .article-card__monogram {
    display: grid;
    width: 4.5rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 50%;
    color: var(--accent);
    font-family: var(--display);
    font-size: 1.65rem;
    font-weight: 800;
    box-shadow:
      -1.2rem 0 0 -0.08rem var(--surface),
      -1.2rem 0 0 0.03rem color-mix(in srgb, var(--accent) 28%, transparent),
      1.2rem 0 0 -0.08rem var(--surface),
      1.2rem 0 0 0.03rem color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .article-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.6rem;
    padding: var(--space-4);
  }

  .article-card__title {
    margin: 0;
    color: var(--ink);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.25;
    transition: color var(--transition);
  }

  .article-card:hover .article-card__title {
    color: var(--accent);
  }

  .article-card__description {
    margin: 0;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .article-card__footer {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .article-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-card__tag {
    display: block;
    width: auto;
    margin: 0;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 750;
    line-height: 1.25;
    background: var(--surface-strong, rgba(0,0,0,0.02));
  }

  .article-card__read-more {
    width: fit-content;
    color: var(--accent);
    font-weight: 800;
    font-size: 0.92rem;
    transition: transform 0.15s ease;
  }

  .article-card:hover .article-card__read-more {
    text-decoration: underline;
  }
</style>
