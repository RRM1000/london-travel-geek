---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatTag, tagHref } from "../lib/taxonomy";

interface Props {
  label?: string;
  title?: string;
  description?: string;
  href?: string;
  empty?: boolean;
  image?: ImageMetadata;
  imageAlt?: string;
  tags?: string[];
}

const {
  label = "Article",
  title = "Article title",
  description = "Article summary will appear here.",
  href = "#",
  empty = false,
  image,
  imageAlt = "",
  tags = [],
} = Astro.props;
---

<article class:list={["article-card", { slot: empty }]}>
  <div class="article-card__image" aria-hidden={image ? undefined : "true"}>
    {image ? (
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 720, 960]}
        sizes="(max-width: 48rem) 100vw, 33vw"
        loading="lazy"
      />
    ) : (
      <span class="article-card__monogram">{label.slice(0, 2).toUpperCase()}</span>
    )}
  </div>
  <div class="article-card__body">
    <p class="eyebrow">{empty ? "Content slot" : label}</p>
    <h3>{empty ? "Article card" : title}</h3>
    <p>{empty ? "Connect this component to an article collection." : description}</p>
    {!empty && tags.length > 0 && (
      <ul class="article-card__tags" aria-label={`Tags for ${title}`}>
        {tags.slice(0, 4).map((tag) => <li><a href={tagHref(tag)}>{formatTag(tag)}</a></li>)}
      </ul>
    )}
    {!empty && <a href={href} aria-label={`Read ${title}`}>Read article →</a>}
  </div>
</article>

<style>
  .article-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--card-radius);
    background: var(--surface);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 5%, transparent);
    transition: box-shadow var(--transition), translate var(--transition);
  }

  .article-card__image {
    display: grid;
    min-height: 0;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    place-items: center;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--accent) 14%, var(--surface)), var(--surface-strong));
  }

  .article-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--transition), filter var(--transition);
  }

  .article-card:hover {
    translate: 0 -0.2rem;
    box-shadow: 0 0.85rem 2rem rgb(15 39 54 / 0.13);
  }

  .article-card:hover .article-card__image :global(img) {
    scale: 1.035;
    filter: saturate(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card,
    .article-card__image :global(img) {
      transition: none;
    }
  }

  .article-card__monogram {
    display: grid;
    width: 4.5rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 50%;
    color: var(--accent);
    font-family: var(--display);
    font-size: 1.65rem;
    font-weight: 800;
    box-shadow:
      -1.2rem 0 0 -0.08rem var(--surface),
      -1.2rem 0 0 0.03rem color-mix(in srgb, var(--accent) 28%, transparent),
      1.2rem 0 0 -0.08rem var(--surface),
      1.2rem 0 0 0.03rem color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .article-card__body {
    display: grid;
    gap: 0.65rem;
    padding: var(--space-4);
  }

  .article-card__body > p:not(.eyebrow) {
    color: var(--muted);
    font-size: 0.94rem;
  }

  .article-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .article-card__tags a {
    display: block;
    width: auto;
    margin: 0;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 750;
    line-height: 1.25;
    text-decoration: none;
  }

  .article-card__tags a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  a {
    width: fit-content;
    margin-top: 0.25rem;
    color: var(--accent);
    font-weight: 800;
  }
</style>
