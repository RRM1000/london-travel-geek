---
interface Props {
  format?: "leaderboard" | "rectangle";
  label?: string;
}

const { format = "leaderboard", label = "Advertisement" } = Astro.props;
---

<aside class:list={["advert", `advert--${format}`]} aria-label={label}>
  <span>{label}</span>
  <p>Advert component slot</p>
</aside>

<style>
  .advert {
    display: grid;
    min-height: 8rem;
    place-content: center;
    gap: 0.25rem;
    padding: var(--space-3);
    border: 1px dashed var(--line);
    border-radius: var(--radius-sm);
    background:
      repeating-linear-gradient(
        -45deg,
        transparent,
        transparent 8px,
        color-mix(in srgb, var(--line) 22%, transparent) 8px,
        color-mix(in srgb, var(--line) 22%, transparent) 9px
      );
    color: var(--muted);
    text-align: center;
  }

  .advert--rectangle {
    min-height: 16rem;
  }

  span {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  p {
    font-weight: 700;
  }
</style>
