---
// The Hotels.com unit under the tours card - Rob, 15 September 2026.
//
// Deliberately not a second dark card. SidebarHotels explains why two dark
// cards don't fit the pinned column; this is a light card two lines tall, and
// ArticleLayout raises --sidebar-widget-reserve when it is present, so on a
// short screen the contents list gives way rather than this cropping.
//
// No date inputs here, unlike the strip in the article: two date fields in a
// 14rem column would double its height. Hotels.com asks for dates on arrival.
import { staySearchLink } from "../../scripts/lib/affiliate.mjs";

const href = staySearchLink();
---

{href && (
  <aside class="sidebar-stay" aria-labelledby="sidebar-stay-title">
    <p class="sidebar-stay__title" id="sidebar-stay-title">Hotels in London</p>
    <a
      class="sidebar-stay__go"
      href={href}
      rel="sponsored nofollow noopener"
      target="_blank"
      data-affiliate="cj"
      data-venue="Hotels.com London search"
    >
      Compare prices on Hotels.com
      <span class="sidebar-stay__ad">ad</span>
    </a>
  </aside>
)}

<style>
  .sidebar-stay {
    display: grid;
    flex: 0 0 auto;
    gap: 0.5rem;
    padding: 0.75rem 0.9rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--card-radius);
    background: var(--surface);
  }

  .sidebar-stay__title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    color: var(--ink);
    font-family: var(--display);
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.2;
  }

  /* The bed glyph SidebarHotels uses, in ink on the light ground. */
  .sidebar-stay__title::before {
    width: 1.15rem;
    height: 1.15rem;
    flex: 0 0 auto;
    background: currentColor;
    content: "";
    -webkit-mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>')
      center / contain no-repeat;
    mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>')
      center / contain no-repeat;
  }

  .sidebar-stay__go {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.55rem;
    background: var(--bg);
    color: var(--ink);
    font-size: 0.78rem;
    font-variation-settings: "wght" 750;
    text-decoration: none;
    transition:
      border-color var(--transition),
      background var(--transition);
  }

  .sidebar-stay__go:hover {
    border-color: var(--ink);
    background: var(--surface-strong);
  }

  .sidebar-stay__ad {
    padding: 0.05rem 0.25rem;
    border-radius: 0.2rem;
    background: var(--surface-strong);
    color: var(--muted);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-stay__go {
      transition: none;
    }
  }
</style>
