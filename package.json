{
  "name": "reusable-travel-blog-skeleton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/optimise-images.mjs --check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "images:check": "node scripts/optimise-images.mjs --check",
    "images:fix": "node scripts/optimise-images.mjs --write --include-uncommitted",
    "audit:citations": "node -e \"const{execSync}=require('child_process'),fs=require('fs');let f=0;for(const s of fs.readdirSync('scripts').filter(x=>/^verify-.*-citations.mjs$/.test(x))){try{execSync('node scripts/'+s,{stdio:'pipe'})}catch(e){f++;console.log('FAIL '+s);process.stdout.write(e.stdout||'')}}console.log(f?f+' verifier(s) failing':'all citation verifiers pass');process.exit(f?1:0)\"",
    "audit:depth": "node scripts/audit-entry-depth.mjs",
    "audit:sources": "node scripts/audit-source-mix.mjs",
    "audit:corpus": "node scripts/audit-corpus.mjs",
    "audit": "npm run audit:citations && npm run audit:hub && npm run audit:overlap && npm run audit:corpus && npm run audit:sources && npm run audit:depth",
    "audit:hub": "node scripts/audit-food-hub.mjs",
    "audit:overlap": "node scripts/audit-guide-overlap.mjs",
    "audit:fresh": "node scripts/audit-freshness.mjs",
    "audit:dates": "node scripts/audit-expired-dates.mjs",
    "analytics:pull": "node scripts/pull-analytics.mjs",
    "analytics:report": "node scripts/pull-analytics.mjs --report"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/node": "^26.2.0",
    "googleapis": "^174.0.1",
    "typescript": "^5.9.3"
  }
}
