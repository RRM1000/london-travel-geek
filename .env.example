# Selects the branding and theme at build time.
# Supported values: london, toolkit
SITE_ID=london

# Public production URL used for canonical links, sitemap entries and sharing.
SITE_URL=https://londontravelgeek.com

# Keep false until the site is ready to appear in search engines.
PUBLIC_ALLOW_INDEXING=false

# Add the verification token supplied by Google Search Console after launch.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Places API key, used ONLY by scripts/enrich.mjs to fill address,
# postcode, website, opening hours and business status.
#
# This is the one billed call in the pipeline. It is deliberately hard to run:
# `places` is excluded from the default stages, naming it only prints a dry-run
# cost estimate, and --confirm is required to spend quota. Intended to run once
# against a finished list, not during development.
#
# Put the real value in .env.local (gitignored), never here.
GOOGLE_PLACES_API_KEY=
