{
  "purpose": "The tiered register of every source the research is allowed to count, and what a mention from it is worth. It exists because the corpus had drifted: Time Out, The Infatuation and DesignMyNight alone account for roughly a third of all source records, so 'cross-referenced across many sources' often meant three publications and their echoes.",
  "howToUse": "scripts/build-evidence.mjs reads this to tier every mention. A domain that is not listed here is counted as tier C with a warning, so an unknown source is visible rather than silently weighted.",
  "tiers": {
    "A": {
      "label": "Judged, dated ranking",
      "weight": 3,
      "what": "A named panel or inspectorate published a ranked or starred list with a YEAR on it. The strongest single signal, because it is falsifiable and re-run annually.",
      "caution": "A star is a claim with a date. Verify the year before writing 'holds a Michelin star' - Hakkasan and Yauatcha were both written as current after losing theirs."
    },
    "B": {
      "label": "Editorial publication",
      "weight": 2,
      "what": "A masthead with editors, paying writers to visit. Broad and useful, but this tier is over-represented and its members copy each other."
    },
    "C": {
      "label": "Independent blog or specialist",
      "weight": 2,
      "what": "One or two people writing from their own visits, or a single-subject specialist. Often earlier and more specific than the publications, and much closer to what a local would actually say."
    },
    "D": {
      "label": "Video",
      "weight": 2,
      "what": "YouTube and TikTok creators. Currently ZERO sources across all 27 topics, which is the single largest gap in the corpus.",
      "method": "Venue names come from the description and chapter timestamps first - creators list them - and from the transcript only as a fallback."
    },
    "E": {
      "label": "Community",
      "weight": 2,
      "what": "Reddit threads and forum posts where named people argue about where to eat.",
      "whyNotAnAggregator": "The aggregator rule below bans TripAdvisor and Yelp because a volume-ranked list lets ONE crowd-sourced ranking pose as several independent opinions. A Reddit thread is the opposite: individual, attributable, argued, and frequently contradicts the published lists. Counted per THREAD, never per comment, so one busy thread cannot outweigh a publication."
    },
    "F": {
      "label": "Venue's own site (fact check only)",
      "weight": 0,
      "what": "The restaurant's own website or its hotel group's page. Used to verify address, postcode, price and which branches are open. NEVER counted toward consensus - a venue recommending itself is not evidence."
    }
  },
  "rules": {
    "distinctDomains": "Support is counted in distinct DOMAINS, never in URLs. Two lists from one publication is one opinion.",
    "tierSpread": "An entry needs 2+ domains across 2+ TIERS, or one tier-A award. Five publications agreeing is weaker evidence than a publication, a blogger and a video agreeing - they read each other.",
    "syndication": "Where one outlet REPORTS another's ranking, that is the original source, not a second one. Time Out publishes 'X has been crowned by the Telegraph' constantly; counting both double-counts a single judgement.",
    "recency": "A mention older than 36 months still counts but is flagged. A venue with no mention inside 24 months is a closure candidate - the check that caught Oklava and Jinjuu.",
    "aggregators": "TripAdvisor, Yelp, OpenTable, Wanderlog, Trip101, restaurantguru, Corner and similar are EXCLUDED. They rank by user volume, repeat each other, and dominate search results."
  },
  "blocked": {
    "note": "Refuse the fetcher. A dead source inflates apparent breadth without adding any. Kept here so the same URLs are not retried every topic.",
    "permanent403": [
      "guide.michelin.com",
      "thatsup.co.uk",
